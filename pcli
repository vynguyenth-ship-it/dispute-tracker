cmd_peer_list() {
  local agent=""
  local warn_l4_only=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --warn-l4-only)
        warn_l4_only=true
        shift
        ;;
      -h|--help)
        echo "Usage: pcli peer list <agent> [--warn-l4-only]"
        echo ""
        echo "  --warn-l4-only   Flag runtime peer entries (set via pcli peer connect/accept)"
        echo "                   that won't survive the Cilium L4 enforcement flip. Move the"
        echo "                   entry into the manifest's peers: block to make it durable."
        exit 0
        ;;
      *)
        if [[ -z "$agent" ]]; then agent="$1"; else
          echo_fail "Unknown argument: $1"
          exit 1
        fi
        shift
        ;;
    esac
  done

  if [[ -z "$agent" ]]; then
    echo_fail "Usage: pcli peer list <agent> [--warn-l4-only]"
    exit 1
  fi

  check_credentials

  local response parsed status body_text
  response=$(api_call GET "/api/v1/peer-policy/${agent}")
  parsed=$(parse_api_response "$response")
  status=$(echo "$parsed" | head -1)
  body_text=$(echo "$parsed" | tail -n +2)

  if [[ "$status" -ge 200 && "$status" -lt 300 ]]; then
    local egress_count ingress_count
    egress_count=$(echo "$body_text" | jq '.peer_egress | length')
    ingress_count=$(echo "$body_text" | jq '.peer_ingress | length')

    echo "Peer connections for ${agent}:"
    echo ""
    echo "Outbound (peer_egress): ${egress_count}"
    if [[ "$egress_count" -gt 0 ]]; then
      echo "$body_text" | jq -r '.peer_egress[] | "  → " + (if .user then .user + "/" else "" end) + .agent + "  [" + (.source // "runtime") + "]"'
    fi
    echo ""
    echo "Inbound (peer_ingress): ${ingress_count}"
    if [[ "$ingress_count" -gt 0 ]]; then
      echo "$body_text" | jq -r '.peer_ingress[] | "  ← " + .user + "/" + .agent + "  [" + (.source // "runtime") + "]"'
    fi

    if [[ "$warn_l4_only" == "true" ]]; then
      local runtime_count
      runtime_count=$(echo "$body_text" | jq '[(.peer_egress[]?, .peer_ingress[]?) | select((.source // "runtime") != "manifest")] | length')
      echo ""
      if [[ "$runtime_count" -gt 0 ]]; then
        echo "⚠️  ${runtime_count} runtime-only peer entries detected:"
        echo "    These were created via 'pcli peer connect/accept' and live only in the"
        echo "    proxy-policies ConfigMap (L7 ext-authz). When Cilium policy enforcement"
        echo "    flips from audit → default, the L4 dial will fail before ext-authz sees"
        echo "    the packet. Move durable grants into the manifest's peers: block."
        echo "    See docs/INTER_AGENT_ROUTING.md for the migration."
      else
        echo "✓ No runtime-only entries — all declared peers will survive the L4 enforcement flip."
      fi
    fi
  else
    echo_fail "Failed to get peer policy (HTTP $status): $body_text"
    exit 1
  fi
}

cmd_peer_discover() {
  local agent="${1:-}"

  if [[ -z "$agent" ]]; then
    echo_fail "Usage: pcli peer discover <agent>"
