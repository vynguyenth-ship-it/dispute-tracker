      echo "  (none)"
    else
      printf "  %-20s %-55s %s\n" "AGENT" "DNS" "PORT"
      echo "$body_text" | jq -r '.discoverable[] | "\(.agent)\t\(.dns)\t\(.port)"' | while IFS=$'\t' read -r name dns port; do
        printf "  %-20s %-55s %s\n" "$name" "$dns" "$port"
      done
    fi
  else
    echo_fail "Failed to discover peers (HTTP $status): $body_text"
    exit 1
  fi
}

