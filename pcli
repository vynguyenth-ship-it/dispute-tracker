# Main

# Test harness hook: tests/pcli/* sets PCLI_SOURCE_ONLY=1 then `source pcli`
# to get function definitions (resolve_manifest, manifest_field, helpers)
# without triggering ANY dispatch. Must come BEFORE the no-args help fallback
# below, because sourcing pcli inside a `bash -c` body presents zero args and
# would otherwise run cmd_help + exit 0, killing the subshell.
if [[ "${PCLI_SOURCE_ONLY:-0}" == "1" ]]; then
  return 0 2>/dev/null || exit 0
fi

if [[ $# -eq 0 ]]; then
  cmd_help
  exit 0
fi

cmd_ssh() {
  local subcmd="${1:-help}"
  shift || true

  case "$subcmd" in
    setup)
      cmd_ssh_setup "$@"
      ;;
    status)
      cmd_ssh_status "$@"
      ;;
    check-cert)
      cmd_ssh_check_cert "$@"
      ;;
    *)
      echo "Usage: pcli ssh <subcommand>"
      echo ""
      echo "Subcommands:"
      echo "  setup [KEY]   Sign SSH key and configure ~/.ssh/config for Palana dev SSH"
      echo "                KEY: key name under ~/.ssh/ or full path (created if missing)"
      echo "                     defaults to id_ed25519 or id_rsa (auto-generates if absent)"
      echo "                Logs in automatically if not authenticated"
      echo "  status        Show SSH access status for your agents"
      echo "  check-cert    Check if SSH certificate is still valid (exit 0 if valid)"
      exit 0
      ;;
  esac
}

cmd_ssh_setup() {
  local quiet=0
  local key_name=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --quiet) quiet=1; shift ;;
      -*) echo_fail "Unknown option: $1"; exit 1 ;;
      *) key_name="$1"; shift ;;
    esac
  done

  # Resolve SSH key path
  local ssh_key
  if [[ -n "$key_name" ]]; then
    # Treat as key name (under ~/.ssh/) or full path
    if [[ "$key_name" == /* || "$key_name" == ~* ]]; then
      ssh_key="${key_name%.pub}.pub"
    else
      ssh_key="${HOME}/.ssh/${key_name%.pub}.pub"
    fi
    if [[ ! -f "$ssh_key" ]]; then
      local priv_key="${ssh_key%.pub}"
      echo_step "SSH key not found. Generating ${priv_key}..."
      ssh-keygen -t ed25519 -f "$priv_key" -N "" -q || {
        echo_fail "Failed to generate SSH key"
        exit 1
      }
      echo_pass "Generated SSH key: ${priv_key}"
    fi
  else
    ssh_key="${HOME}/.ssh/id_ed25519.pub"
    if [[ ! -f "$ssh_key" ]]; then
      ssh_key="${HOME}/.ssh/id_rsa.pub"
    fi
    if [[ ! -f "$ssh_key" ]]; then
      echo_step "No SSH key found. Generating ~/.ssh/id_ed25519..."
      ssh-keygen -t ed25519 -f "${HOME}/.ssh/id_ed25519" -N "" -q || {
        echo_fail "Failed to generate SSH key"
        exit 1
      }
      echo_pass "Generated SSH key: ~/.ssh/id_ed25519"
      ssh_key="${HOME}/.ssh/id_ed25519.pub"
    fi
  fi

  local pub_key
  pub_key=$(cat "$ssh_key")

  [[ $quiet -eq 0 ]] && echo_step "Signing SSH key with Palana CA..."

  # Ensure authenticated — auto-login if not
  local token
  token=$(get_oauth_token)
  if [[ -z "$token" ]]; then
    echo_step "Not logged in. Starting login flow..."
    cmd_login
    token=$(get_oauth_token)
  else
    # Check expiry; if expired attempt refresh or re-login
    local exp now
    exp=$(jwt_get_field "$token" "exp")
    now=$(date +%s)
    if [[ -n "$exp" && "$exp" -le "$now" ]]; then
      echo_step "Token expired. Attempting refresh..."
      # Try silent refresh via check_oauth_token logic
      if [[ -f "${PALANA_CONFIG_DIR}/oauth-refresh-token" ]]; then
        local refresh_token secret_param="" response new_token
        refresh_token=$(cat "${PALANA_CONFIG_DIR}/oauth-refresh-token")
        [[ -n "$CONCEDO_CLIENT_SECRET" ]] && secret_param="-d client_secret=${CONCEDO_CLIENT_SECRET}"
        response=$(curl -s -X POST "${CONCEDO_TOKEN_ENDPOINT}" \
          -d "grant_type=refresh_token" \
          -d "client_id=${CONCEDO_CLIENT_ID}" \
          $secret_param \
          -d "refresh_token=${refresh_token}" 2>/dev/null)
        new_token=$(echo "$response" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('id_token','') or d.get('access_token',''))" 2>/dev/null)
        if [[ -n "$new_token" && "$new_token" != "" ]]; then
          local current_user
          current_user=$(kubectl config view -o jsonpath="{.contexts[?(@.name==\"$(kubectl config current-context 2>/dev/null)\")].context.user}" 2>/dev/null)
          kubectl config set-credentials "$current_user" --token="$new_token" 1>/dev/null
          token="$new_token"
          echo_pass "Token refreshed"
        else
          echo_step "Refresh failed. Starting login flow..."
          cmd_login
          token=$(get_oauth_token)
        fi
      else
        echo_step "No refresh token. Starting login flow..."
        cmd_login
        token=$(get_oauth_token)
      fi
    fi
  fi

  if [[ -z "$token" ]]; then
    echo_fail "Authentication failed. Run: pcli login"
    exit 1
  fi

  local agent_api_url
  agent_api_url=$(get_agent_api_url)

  local response http_code
  response=$(curl -s -w "\n%{http_code}" -X POST "${agent_api_url}/api/v1/ssh/sign-key" \
    -H "Authorization: Bearer ${token}" \
    -H "Content-Type: application/json" \
    -d "{\"public_key\": \"${pub_key}\"}" 2>/dev/null)
  http_code=$(echo "$response" | tail -1)
  response=$(echo "$response" | sed '$d')
  if [[ "$http_code" -lt 200 || "$http_code" -ge 300 ]]; then
    local err_msg
    err_msg=$(echo "$response" | jq -r '.error // empty' 2>/dev/null)
    if [[ -n "$err_msg" ]]; then
      echo_fail "Failed to sign SSH key: $err_msg (HTTP $http_code)"
    elif [[ "$http_code" == "000" ]]; then
      echo_fail "Failed to sign SSH key. Is the agent-api reachable?"
    else
      echo_fail "Failed to sign SSH key (HTTP $http_code)"
    fi
    exit 1
  fi

  local signed_key
  signed_key=$(echo "$response" | jq -r '.signed_key // empty')
  if [[ -z "$signed_key" ]]; then
    echo_fail "No signed key returned from agent-api"
    exit 1
  fi

  local cert_file="${HOME}/.ssh/palana-cert.pub"
  echo "$signed_key" > "$cert_file"
  chmod 600 "$cert_file"

  local ssh_hostname="ssh.palana.engtools.net"
  local sanitized_user
  sanitized_user=$(sanitize_user_id "$(get_effective_user_id)")

  # Build config: wildcard block + per-agent Host entries
  local config_block="# Palana Dev SSH (managed by pcli ssh setup)
Host *.agent.palana.engtools.net
  HostName ${ssh_hostname}
  Port 22
  IdentityFile ${ssh_key%.pub}
  CertificateFile ${cert_file}
  StrictHostKeyChecking accept-new
  UserKnownHostsFile ~/.ssh/known_hosts_palana"

  # Query SSH-enabled agents and add Host aliases
  local user_ns
  user_ns=$(get_user_namespace)
  local agent_entries=""
  local agent_list
  agent_list=$(kubectl get useragent -n "$user_ns" -o json 2>/dev/null \
    | jq -r '.items[] | select(.spec.ssh_mode != null and .spec.ssh_mode != "" and .spec.ssh_mode != "off") | .spec.agent_name' 2>/dev/null)

  if [[ -n "$agent_list" ]]; then
    while IFS= read -r agent_name; do
      agent_entries="${agent_entries}
Host ${agent_name}
  HostName ${ssh_hostname}
  Port 22
  User ${agent_name}
  IdentityFile ${ssh_key%.pub}
  CertificateFile ${cert_file}
  StrictHostKeyChecking accept-new
  UserKnownHostsFile ~/.ssh/known_hosts_palana"
    done <<< "$agent_list"
    config_block="${config_block}${agent_entries}"
  fi

  # End block with blank line for awk delimiter
  config_block="${config_block}
"

  local ssh_config="${HOME}/.ssh/config"
  if [[ -f "$ssh_config" ]] && grep -q "# Palana Dev SSH" "$ssh_config"; then
    local tmpfile
    tmpfile=$(mktemp)
    awk '/# Palana Dev SSH/,/^$/{next}1' "$ssh_config" > "$tmpfile"
    echo "" >> "$tmpfile"
    echo "$config_block" >> "$tmpfile"
    mv "$tmpfile" "$ssh_config"
  else
    echo "" >> "$ssh_config"
    echo "$config_block" >> "$ssh_config"
  fi
  chmod 600 "$ssh_config"

  if [[ $quiet -eq 0 ]]; then
    echo_pass "SSH certificate written to ${cert_file} (valid 8h)"
    echo_pass "SSH config updated"
    if [[ -n "$agent_list" ]]; then
      echo ""
      echo "  SSH-enabled agents:"
      while IFS= read -r agent_name; do
        echo "    ssh ${agent_name}"
      done <<< "$agent_list"
      echo ""
      echo "  If a name clashes with another host, edit ~/.ssh/config to rename it."
    else
      echo ""
      echo "  No SSH-enabled agents found. Create one with:"
      echo "    pcli create myagent --template backend-ai --ssh-mode sidecar"
    fi
  fi
}

cmd_ssh_status() {
  local user
  user=$(get_effective_user_id)
  local sanitized_user
  sanitized_user=$(sanitize_user_id "$user")
  local user_ns
  user_ns=$(get_user_namespace)

  echo_step "SSH access status for ${sanitized_user}:"
  echo ""

  local agents
  agents=$(kubectl get useragent -n "$user_ns" -o json 2>/dev/null | jq -r '.items[] | "\(.spec.agent_name)|\(.spec.ssh_mode // "off")"' 2>/dev/null)

  if [[ -z "$agents" ]]; then
    echo "  No agents found."
    return
  fi

  while IFS='|' read -r agent_name ssh_mode; do
    local icon="  "
    case "$ssh_mode" in
      sidecar) icon="[sidecar]" ;;
      direct)  icon="[direct] " ;;
      *)       icon="[off]    " ;;
    esac
    echo "  ${icon} ${agent_name}"
  done <<< "$agents"

  echo ""

  local cert_file="${HOME}/.ssh/palana-cert.pub"
  if [[ -f "$cert_file" ]]; then
    local expiry
    expiry=$(ssh-keygen -L -f "$cert_file" 2>/dev/null | grep "Valid:" | sed 's/.*to //')
    if [[ -n "$expiry" ]]; then
      echo "  Certificate: ${cert_file}"
      echo "  Valid until: ${expiry}"
    else
      echo "  Certificate: ${cert_file} (cannot read expiry)"
    fi
  else
    echo "  No SSH certificate. Run: pcli ssh setup"
  fi
}

cmd_ssh_check_cert() {
  local cert_file="${HOME}/.ssh/palana-cert.pub"
  if [[ ! -f "$cert_file" ]]; then
    exit 1
  fi
  ssh-keygen -L -f "$cert_file" &>/dev/null || exit 1

  local expiry_line
  expiry_line=$(ssh-keygen -L -f "$cert_file" 2>/dev/null | grep "Valid:")
  if [[ -z "$expiry_line" ]]; then
    exit 1
  fi

  local expiry_str
  expiry_str=$(echo "$expiry_line" | sed 's/.*to //')
  local expiry_epoch
  expiry_epoch=$(date -j -f "%Y-%m-%dT%H:%M:%S" "$expiry_str" "+%s" 2>/dev/null || date -d "$expiry_str" "+%s" 2>/dev/null || echo 0)

  local now_epoch
  now_epoch=$(date "+%s")

  local buffer=1800

  if [[ $((expiry_epoch - now_epoch)) -gt $buffer ]]; then
    exit 0
  else
    exit 1
  fi
}

# --- Backup commands ---
# All backup CronJobs run in palana-system with a single IRSA-annotated SA.
# The SA can only assume the agent-backup role (scoped to palana-system:agent-backup).
# Each CronJob mounts the EFS filesystem directly with a subPath to the agent's data.
# Agent namespaces have zero S3 access — no cross-agent tampering possible.

BACKUP_S3_BUCKET="${BACKUP_S3_BUCKET:-palana-logs}"
BACKUP_S3_PREFIX="backups"
BACKUP_IMAGE="${BACKUP_IMAGE:-amazon/aws-cli:2.15.0}"
BACKUP_NAMESPACE="palana-backup"

cmd_backup() {
  local subcommand=${1:-}
  shift || true

  if [[ "$subcommand" == "--help" || "$subcommand" == "-h" || -z "$subcommand" ]]; then
    echo "Usage:"
    echo "  pcli backup enable <agent> [--schedule 'CRON']  Enable periodic backup (default: daily 2am UTC)"
    echo "  pcli backup disable <agent>                     Disable backup (removes CronJob)"
    echo "  pcli backup now <agent>                         Trigger immediate backup"
    echo "  pcli backup list <agent>                        List backups in S3"
    echo "  pcli backup restore <agent> [timestamp]         Restore backup to running agent"
    echo "  pcli backup delete <agent> <timestamp>          Permanently delete a backup from S3"
    echo "  pcli backup download <agent> <timestamp> [-o path]  Download backup tarball to local disk"
    echo "  pcli backup status <agent>                      Show backup CronJob status"
    echo ""
    echo "  Backups are stored in s3://${BACKUP_S3_BUCKET}/${BACKUP_S3_PREFIX}/{user}/{agent}/"
    echo "  Backups survive agent deletion."
    echo "  CronJobs run in palana-backup (not agent namespace) for S3 credential isolation."
    exit 0
  fi

  case "$subcommand" in
    enable)
      cmd_backup_enable "$@"
      ;;
    disable)
      cmd_backup_disable "$@"
      ;;
    now)
      cmd_backup_now "$@"
      ;;
    list)
      cmd_backup_list "$@"
      ;;
    restore)
      cmd_backup_restore "$@"
      ;;
    status)
      cmd_backup_status "$@"
      ;;
    delete)
      cmd_backup_delete "$@"
      ;;
    download)
      cmd_backup_download "$@"
      ;;
    *)
      echo_fail "Unknown backup command: $subcommand"
      exit 1
      ;;
  esac
}

backup_cronjob_name() {
  local user=$1
  local agent=$2
  echo "backup-${user}-${agent}"
}

cmd_backup_enable() {
  local agent=""
  local schedule="0 2 * * *"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --schedule)
        schedule="$2"
        shift 2
        ;;
      *)
        if [[ -z "$agent" ]]; then
          agent="$1"
        fi
        shift
        ;;
    esac
  done

  if [[ -z "$agent" ]]; then
    echo_fail "Usage: pcli backup enable <agent> [--schedule 'CRON']"
    exit 1
  fi

  check_credentials
  local namespace
  namespace=$(get_agent_namespace "$agent")

  if ! check_namespace_exists "$namespace"; then
    echo_fail "Namespace not found: $namespace"
    echo "Did you create the agent? Try: pcli create $agent"
    exit 1
  fi

  local user
  user=$(sanitize_user_id "$(get_effective_user_id)")
  local s3_path="s3://${BACKUP_S3_BUCKET}/${BACKUP_S3_PREFIX}/${user}/${agent}"
  local cj_name
  cj_name=$(backup_cronjob_name "$user" "$agent")
  local efs_subdir="${namespace}"

  echo_step "Enabling backup for $agent (schedule: $schedule)"
  echo "  Agent NS:  $namespace"
  echo "  CronJob:   $BACKUP_NAMESPACE/$cj_name"
  echo "  S3 path:   $s3_path"

  if ! kubectl get serviceaccount agent-backup -n "$BACKUP_NAMESPACE" &>/dev/null; then
    echo_fail "ServiceAccount agent-backup not found in $BACKUP_NAMESPACE. Run terraform apply first."
    exit 1
  fi

  kubectl apply -n "$BACKUP_NAMESPACE" -f - <<YAML
apiVersion: batch/v1
kind: CronJob
metadata:
  name: ${cj_name}
  namespace: ${BACKUP_NAMESPACE}
  labels:
    managed-by: pcli-backup
    backup-agent: ${agent}
    backup-user: ${user}
spec:
  schedule: "${schedule}"
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 1
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      backoffLimit: 2
      activeDeadlineSeconds: 3600
      template:
        metadata:
          labels:
            managed-by: pcli-backup
            backup-agent: ${agent}
            backup-user: ${user}
        spec:
          serviceAccountName: agent-backup
          restartPolicy: OnFailure
          securityContext:
            runAsUser: 0
          initContainers:
          - name: tar
            image: alpine:3.20
            command: ["/bin/sh", "-c"]
            args:
            - |
              set -e
              AGENT_DIR="/efs/${efs_subdir}"
              if [ ! -d "\$AGENT_DIR" ]; then
                echo "ERROR: agent directory not found: \$AGENT_DIR"
                ls -la /efs/ 2>/dev/null | head -10
                exit 1
              fi
              echo "Backing up: \$AGENT_DIR"
              ls -la "\$AGENT_DIR/"
              cd "\$AGENT_DIR"
              tar czf /staging/backup.tar.gz --exclude='.cache/pip' --exclude='.cache/ms-playwright' --exclude='node_modules' .
              echo "Tarball created: \$(ls -lh /staging/backup.tar.gz | awk '{print \$5}')"
            resources:
              requests:
                cpu: 100m
                memory: 256Mi
              limits:
                cpu: 500m
                memory: 512Mi
            volumeMounts:
            - name: efs-agent-data
              mountPath: /efs
              readOnly: true
            - name: staging
              mountPath: /staging
          containers:
          - name: upload
            image: amazon/aws-cli:2.15.0
            env:
            - name: HOME
              value: /tmp
            command: ["/bin/sh", "-c"]
            args:
            - |
              set -e
              TIMESTAMP=\$(date +%Y%m%d-%H%M%S)
              BACKUP_KEY="${BACKUP_S3_PREFIX}/${user}/${agent}/\${TIMESTAMP}.tar.gz"
              echo "Uploading: \${BACKUP_KEY}"
              aws s3 cp /staging/backup.tar.gz "s3://${BACKUP_S3_BUCKET}/\${BACKUP_KEY}"
              echo "Backup complete: s3://${BACKUP_S3_BUCKET}/\${BACKUP_KEY}"
            securityContext:
              allowPrivilegeEscalation: false
              capabilities:
                drop: ["ALL"]
            resources:
              requests:
                cpu: 100m
                memory: 256Mi
              limits:
                cpu: 500m
                memory: 512Mi
            volumeMounts:
            - name: staging
              mountPath: /staging
              readOnly: true
          volumes:
          - name: efs-agent-data
            persistentVolumeClaim:
              claimName: agent-backup-efs
              readOnly: true
          - name: staging
            emptyDir:
              sizeLimit: 5Gi
YAML

  echo_pass "Backup enabled for $agent"
  echo "  Schedule:  $schedule"
  echo "  S3 path:   $s3_path"
  echo "  Run now:   pcli backup now $agent"
}

cmd_backup_disable() {
  local agent=$1

  if [[ -z "$agent" ]]; then
    echo_fail "Usage: pcli backup disable <agent>"
    exit 1
  fi

  check_credentials
  local user
  user=$(sanitize_user_id "$(get_effective_user_id)")
  local cj_name
  cj_name=$(backup_cronjob_name "$user" "$agent")

  echo_step "Disabling backup for $agent"

  kubectl delete cronjob "$cj_name" -n "$BACKUP_NAMESPACE" 2>/dev/null && \
    echo_pass "CronJob $cj_name deleted" || echo_warn "No CronJob found"

  echo_pass "Backup disabled for $agent"
}

cmd_backup_now() {
  local agent=$1

  if [[ -z "$agent" ]]; then
    echo_fail "Usage: pcli backup now <agent>"
    exit 1
  fi

  check_credentials
  local user
  user=$(sanitize_user_id "$(get_effective_user_id)")
  local cj_name
  cj_name=$(backup_cronjob_name "$user" "$agent")

  if ! kubectl get cronjob "$cj_name" -n "$BACKUP_NAMESPACE" &>/dev/null; then
    echo_fail "Backup not enabled for $agent. Run: pcli backup enable $agent"
    exit 1
  fi

  local job_name="${cj_name}-manual-$(date +%s)"
  echo_step "Triggering immediate backup for $agent"

  kubectl create job "$job_name" --from="cronjob/$cj_name" -n "$BACKUP_NAMESPACE"
  echo_pass "Backup job created: $job_name"
  echo "  Watch progress: kubectl logs -n $BACKUP_NAMESPACE -l job-name=$job_name -f"

  echo_step "Waiting for backup to complete..."
  if kubectl wait --for=condition=complete "job/$job_name" -n "$BACKUP_NAMESPACE" --timeout=600s 2>/dev/null; then
    echo_pass "Backup complete"
  else
    local failed
    failed=$(kubectl get job "$job_name" -n "$BACKUP_NAMESPACE" -o jsonpath='{.status.failed}' 2>/dev/null || echo "0")
    if [[ "$failed" != "0" && -n "$failed" ]]; then
      echo_fail "Backup job failed. Check logs: kubectl logs -n $BACKUP_NAMESPACE -l job-name=$job_name"
      exit 1
    fi
    echo_warn "Backup still running or timed out waiting. Check: kubectl get job $job_name -n $BACKUP_NAMESPACE"
  fi
}

cmd_backup_list() {
  local agent=$1

  if [[ -z "$agent" ]]; then
    echo_fail "Usage: pcli backup list <agent>"
    exit 1
  fi
  check_credentials

  local response status body
  response=$(api_call GET "/api/v1/agents/${agent}/backup")
  status=$(echo "$response" | tail -1)
  body=$(echo "$response" | sed '$d')

  if [[ "$status" != "200" ]]; then
    echo_fail "List failed (HTTP $status): $body"
    exit 1
  fi

  echo_step "Backups for $agent"
  local s3_path
  s3_path=$(echo "$body" | jq -r '.status.s3_path // ""')
  if [[ -n "$s3_path" ]]; then
    echo "  $s3_path"
  fi
  echo ""

  local count
  count=$(echo "$body" | jq '.backups | length')
  if [[ "$count" -eq 0 ]]; then
    echo "  No backups found."
    echo ""
    echo "  Enable backup: pcli backup enable $agent"
    echo "  Run now:       pcli backup now $agent"
    return 0
  fi

  echo "$body" | jq -r '.backups[] | [.last_modified, .size, .timestamp] | @tsv' | \
    while IFS=$'\t' read -r last_modified size_bytes filename; do
      local size_mb=$((size_bytes / 1024 / 1024))
      printf "  %s  %4dMB  %s\n" "$last_modified" "$size_mb" "$filename"
    done
}

cmd_backup_delete() {
  local agent=$1
  local timestamp=$2

  if [[ -z "$agent" || -z "$timestamp" ]]; then
    echo_fail "Usage: pcli backup delete <agent> <timestamp.tar.gz>"
    echo "  Run 'pcli backup list <agent>' to see available timestamps"
    exit 1
  fi
  case "$timestamp" in
    */*|*\\*) echo_fail "invalid timestamp (no path separators allowed)"; exit 1 ;;
    *.tar.gz) ;;
    *) echo_fail "invalid timestamp (must end in .tar.gz)"; exit 1 ;;
  esac

  check_credentials

  echo_step "Deleting $timestamp"
  read -r -p "  This permanently removes the backup. Continue? [y/N] " confirm
  if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
    echo "Cancelled."
    exit 0
  fi

  local payload response status body
  payload=$(jq -cn --arg ts "$timestamp" '{timestamp: $ts}')
  response=$(api_call POST "/api/v1/agents/${agent}/backup/delete" "$payload")
  status=$(echo "$response" | tail -1)
  body=$(echo "$response" | sed '$d')

  if [[ "$status" != "200" ]]; then
    echo_fail "Delete failed (HTTP $status): $body"
    exit 1
  fi
  echo_pass "Deleted: $timestamp"
}

cmd_backup_download() {
  local agent=""
  local timestamp=""
  local output=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -o|--output)
        output="$2"
        shift 2
        ;;
      *)
        if [[ -z "$agent" ]]; then
          agent="$1"
        elif [[ -z "$timestamp" ]]; then
          timestamp="$1"
        fi
        shift
        ;;
    esac
  done

  if [[ -z "$agent" || -z "$timestamp" ]]; then
    echo_fail "Usage: pcli backup download <agent> <timestamp.tar.gz> [-o output_path]"
    echo "  Run 'pcli backup list <agent>' to see available timestamps"
    exit 1
  fi
  case "$timestamp" in
    */*|*\\*) echo_fail "invalid timestamp (no path separators allowed)"; exit 1 ;;
    *.tar.gz) ;;
    *) echo_fail "invalid timestamp (must end in .tar.gz)"; exit 1 ;;
  esac

  check_credentials

  if [[ -z "$output" ]]; then
    output="${agent}-${timestamp}"
  fi
  if [[ -e "$output" ]]; then
    echo_fail "Output file already exists: $output"
    echo "  Remove it or pass -o <other_path>"
    exit 1
  fi

  local api_url token
  api_url=$(get_agent_api_url)
  token=$(get_oauth_token)
  if [[ -z "$token" ]]; then
    echo_fail "No OAuth token found. Run: pcli login"
    exit 1
  fi

  echo_step "Downloading backup via agent-api"
  echo "  → $output"

  local status
  status=$(curl -sS --fail-with-body \
    -H "Authorization: Bearer $token" \
    -o "$output" \
    -w "%{http_code}" \
    "${api_url}/api/v1/agents/${agent}/backup/download/${timestamp}" \
    2>/dev/null) || {
    local err_body=""
    [[ -f "$output" ]] && err_body=$(head -c 1024 "$output" 2>/dev/null)
    rm -f "$output"
    echo_fail "Download failed (HTTP ${status:-000})${err_body:+: $err_body}"
    exit 1
  }

  if [[ "$status" != "200" ]]; then
    local err_body=""
    [[ -f "$output" ]] && err_body=$(head -c 1024 "$output" 2>/dev/null)
    rm -f "$output"
    echo_fail "Download failed (HTTP $status)${err_body:+: $err_body}"
    exit 1
  fi

  local size_bytes
  if [[ "$(uname)" == "Darwin" ]]; then
    size_bytes=$(stat -f %z "$output")
  else
    size_bytes=$(stat -c %s "$output")
  fi
  local size_mb=$((size_bytes / 1024 / 1024))
  echo_pass "Downloaded ${size_mb}MB to $output"
  echo ""
  echo "  Restore later via:"
  echo "    pcli cp $output <agent>:/data/backup.tar.gz"
  echo "    pcli shell <agent>"
  echo "    cd /data && tar xzf backup.tar.gz"
}

cmd_backup_restore() {
  local agent=""
  local timestamp=""
  local wait_for_completion=1

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-wait)
        wait_for_completion=0
        shift
        ;;
      *)
        if [[ -z "$agent" ]]; then
          agent="$1"
        elif [[ -z "$timestamp" ]]; then
          timestamp="$1"
        fi
        shift
        ;;
    esac
  done

  if [[ -z "$agent" ]]; then
    echo_fail "Usage: pcli backup restore <agent> [timestamp] [--no-wait]"
    echo "  timestamp: filename from 'pcli backup list' (e.g. 20260409-020000.tar.gz)"
    echo "  If omitted, restores the latest backup."
    echo "  --no-wait: return immediately after starting the restore Job."
    exit 1
  fi
  check_credentials

  if [[ -z "$timestamp" ]]; then
    echo_step "Finding latest backup..."
    local response status body
    response=$(api_call GET "/api/v1/agents/${agent}/backup")
    status=$(echo "$response" | tail -1)
    body=$(echo "$response" | sed '$d')
    if [[ "$status" != "200" ]]; then
      echo_fail "List failed (HTTP $status): $body"
      exit 1
    fi
    timestamp=$(echo "$body" | jq -r '.backups[0].timestamp // empty')
    if [[ -z "$timestamp" ]]; then
      echo_fail "No backups found for $agent"
      exit 1
    fi
    echo "  Latest: $timestamp"
  else
    case "$timestamp" in
      */*|*\\*) echo_fail "invalid timestamp (no path separators allowed)"; exit 1 ;;
      *.tar.gz) ;;
      *) echo_fail "invalid timestamp (must end in .tar.gz)"; exit 1 ;;
    esac
  fi

  echo_step "Restoring $timestamp → $agent"
  echo ""
  echo "  WARNING: This will overwrite files in the agent's persistent storage."
  read -r -p "  Continue? [y/N] " confirm
  if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
    echo "Cancelled."
    exit 0
  fi

  local payload response status body
  payload=$(jq -cn --arg ts "$timestamp" '{timestamp: $ts}')
  response=$(api_call POST "/api/v1/agents/${agent}/backup/restore" "$payload")
  status=$(echo "$response" | tail -1)
  body=$(echo "$response" | sed '$d')

  if [[ "$status" != "200" ]]; then
    echo_fail "Restore failed (HTTP $status): $body"
    exit 1
  fi

  local job_name
  job_name=$(echo "$body" | jq -r '.job // ""')
  if [[ -z "$job_name" ]]; then
    echo_fail "Restore API did not return a job name: $body"
    exit 1
  fi
  echo "  Job started: $job_name"

  if [[ "$wait_for_completion" -eq 0 ]]; then
    echo_pass "Restore started (not waiting): $timestamp → $agent"
    return 0
  fi

  echo_step "Waiting for restore to complete (timeout: 600s)..."
  local elapsed=0
  local poll_interval=5
  local timeout=600
  while [[ $elapsed -lt $timeout ]]; do
    sleep "$poll_interval"
    elapsed=$((elapsed + poll_interval))
    local status_response status_code status_body state reason
    status_response=$(api_call GET "/api/v1/agents/${agent}/backup/jobs/${job_name}")
    status_code=$(echo "$status_response" | tail -1)
    status_body=$(echo "$status_response" | sed '$d')
    if [[ "$status_code" != "200" ]]; then
      echo_warn "Status check failed (HTTP $status_code): $status_body — retrying"
      continue
    fi
    state=$(echo "$status_body" | jq -r '.state // "running"')
    case "$state" in
      succeeded)
        echo_pass "Restore complete: $timestamp → $agent"
        return 0
        ;;
      failed)
        reason=$(echo "$status_body" | jq -r '.reason // ""')
        echo_fail "Restore failed${reason:+: $reason}"
        exit 1
        ;;
    esac
    printf "  ... still running (%ds)\n" "$elapsed"
  done
  echo_fail "Timed out waiting for restore (${timeout}s). Check status: pcli backup restore --no-wait ... (or inspect job $job_name)"
  exit 1
}

cmd_backup_status() {
  local agent=$1

  if [[ -z "$agent" ]]; then
    echo_fail "Usage: pcli backup status <agent>"
    exit 1
  fi

  check_credentials
  local user
  user=$(sanitize_user_id "$(get_effective_user_id)")
  local cj_name
  cj_name=$(backup_cronjob_name "$user" "$agent")

  local cj_json
  cj_json=$(kubectl get cronjob "$cj_name" -n "$BACKUP_NAMESPACE" -o json 2>/dev/null)

  if [[ -z "$cj_json" ]]; then
    echo "  Backup: not enabled"
    echo ""
    echo "  Enable: pcli backup enable $agent"
    return 0
  fi

  local schedule last_schedule last_success active
  schedule=$(echo "$cj_json" | jq -r '.spec.schedule')
  last_schedule=$(echo "$cj_json" | jq -r '.status.lastScheduleTime // "never"')
  last_success=$(echo "$cj_json" | jq -r '.status.lastSuccessfulTime // "never"')
  active=$(echo "$cj_json" | jq -r '.status.active | length')

  echo "  Backup: enabled"
  echo "  CronJob:       $BACKUP_NAMESPACE/$cj_name"
  echo "  Schedule:      $schedule"
  echo "  Last scheduled: $last_schedule"
  echo "  Last success:  $last_success"
  echo "  Active jobs:   $active"

  local recent_jobs
  recent_jobs=$(kubectl get jobs -n "$BACKUP_NAMESPACE" -l backup-agent="$agent",backup-user="$user" --no-headers 2>/dev/null | head -5)
  if [[ -n "$recent_jobs" ]]; then
    echo ""
    echo "  Recent jobs:"
    echo "$recent_jobs" | while read -r line; do
      echo "    $line"
    done
  fi
}

# Strip global IR flags from args before the command parser sees them.
# --on-behalf-of=<user> / --owner=<user> / PCLI_ON_BEHALF_OF env var
# Caller must be in ti-plf-palana-ir or ti-plf-palana-admin group. Agent-api
# rejects with 403 if not, so no client-side group check needed.
__pcli_filtered_args=()
for __arg in "$@"; do
  case "$__arg" in
    --on-behalf-of=*|--owner=*)
      PCLI_ON_BEHALF_OF="${__arg#*=}"
      ;;
    --on-behalf-of|--owner)
      __pcli_expect_obo=1
      ;;
    *)
      if [[ "${__pcli_expect_obo:-0}" == "1" ]]; then
        PCLI_ON_BEHALF_OF="$__arg"
        __pcli_expect_obo=0
      else
        __pcli_filtered_args+=("$__arg")
      fi
      ;;
  esac
done
if [[ ${#__pcli_filtered_args[@]} -gt 0 ]]; then
  set -- "${__pcli_filtered_args[@]}"
else
  set --
fi
unset __pcli_filtered_args __pcli_expect_obo __arg
export PCLI_ON_BEHALF_OF

cmd=$1
shift || true

# Treat --help/-h as help command
if [[ "$cmd" == "--help" || "$cmd" == "-h" ]]; then
  cmd_help
  exit 0
fi

# Print current OAuth bearer token (after refresh)
cmd_token() {
  check_credentials
  get_oauth_token
}

# Print current authenticated user identity
