cmd_images() {
  if contains_help "$@"; then
    echo "Usage: pcli images [--json]"
    echo ""
    echo "List your personal ECR repositories."
    echo ""
    echo "OPTIONS:"
    echo "  --json  Output raw JSON array from the API"
    exit 0
  fi

  local json_output=0
  for arg in "$@"; do
    [[ "$arg" == "--json" ]] && json_output=1
  done

  echo_step "Fetching your ECR repositories..."
  local response
  response=$(api_call GET "/api/v1/ecr/repositories")
  local status body
  status=$(echo "$response" | tail -1)
  body=$(echo "$response" | sed '$d')

  if [[ "$status" != "200" ]]; then
    local err
    err=$(echo "$body" | jq -r '.error // "unknown error"' 2>/dev/null || echo "$body")
    echo_fail "Failed to list repositories: $err (HTTP $status)"
    exit 1
  fi

  if [[ "$json_output" == "1" ]]; then
    echo "$body"
    return
  fi

  local count
  count=$(echo "$body" | jq 'length' 2>/dev/null || echo 0)
  if [[ "$count" == "0" ]]; then
    echo "No images found. Push one with: pcli push <image>"
    return
  fi

  printf "%-30s %-70s %s\n" "IMAGE" "URI" "CREATED"
  printf "%-30s %-70s %s\n" "-----" "---" "-------"
  echo "$body" | jq -r '.[] | [(.name | sub("user/[^/]+/"; "user/")), .uri, .created_at] | @tsv' 2>/dev/null | \
    while IFS=$'\t' read -r name uri created; do
      printf "%-30s %-70s %s\n" "$name" "$uri" "$created"
    done
  echo ""
  echo "$count repository(ies) found"
}

cmd_register() {
  if contains_help "$@"; then
    echo "Usage: pcli register <ecr-image-path> [options]"
    echo ""
    echo "Register an already-pushed ECR image as a launchable template."
    echo "The image must be in your personal ECR namespace (user/<you>/*)."
    echo ""
    echo "ARGUMENTS:"
    echo "  <ecr-image-path>  Full or short image path (e.g. user/kevin-littlejohn/myagent:v1)"
    echo ""
    echo "OPTIONS:"
    echo "  --name NAME         Template name (default: derived from image)"
    echo "  --display-name NAME Display name in portal"
    echo "  --description DESC  Short description"
    echo "  --web-port PORT     Web port (0 for none, default: 0)"
    echo "  --cpu CPU           CPU limit (default: 1000m, range: 100m-8000m)"
    echo "  --memory MEM        Memory limit (default: 2048Mi, range: 128Mi-8192Mi)"
    echo ""
    echo "NETWORK POLICY (repeatable, evaluated in order, default: allow all):"
    echo "  --allow HOST        Allow outbound to host (e.g. api.openai.com, *.github.com)"
    echo "  --block HOST        Block outbound to host (e.g. telemetry.example.com)"
    echo "  --deny-all          Start with deny-all baseline (only --allow rules pass)"
    echo ""
    echo "STORAGE:"
    echo "  --storage SIZE      Enable persistent storage (e.g. 10Gi)"
    echo "  --storage-path PATH Mount path (default: /data)"
    echo ""
    echo "SECRETS (repeatable):"
    echo "  --secret PRESET     Add a well-known secret. Presets:"
    echo "                        gitlab-pat   GitLab Personal Access Token"
    echo "                        gitlab-ssh   GitLab SSH Private Key"
    echo "                        llm-key      LLM API Key (GrabGPT/Aergia)"
    echo "  --secret KEY:DISPLAY:DESC:INPUT_TYPE:SECRET_TYPE"
    echo "                      Add a custom secret (input_type: password|textarea)"
    echo ""
    echo "GITLAB POLICY (repeatable, default: allow all repos):"
    echo "  --repo PATTERN      Allow git access to repo pattern (e.g. mygroup/*, mygroup/myrepo)"
    echo ""
    echo "EXAMPLES:"
    echo "  pcli register user/me/myagent:v1 --web-port 8080"
    echo "  pcli register user/me/myagent:v1 --block telemetry.corp.com --block ads.tracker.io"
    echo "  pcli register user/me/myagent:v1 --deny-all --allow api.openai.com --allow *.github.com"
    echo "  pcli register user/me/myagent:v1 --repo 'mygroup/*'"
    echo "  pcli register user/me/myagent:v1 --secret gitlab-pat --secret gitlab-ssh --secret llm-key"
    echo "  pcli register user/me/myagent:v1 --storage 10Gi --secret gitlab-pat"
    exit 0
  fi

  local image_path="" template_name="" display_name="" description="" web_port="0" cpu="1000m" memory="2048Mi"
  local storage_size="" storage_path="/data"
  local -a network_rules=()
  local -a repo_rules=()
  local -a secret_specs=()
  local deny_all=false

  while [[ $# -gt 0 ]]; do
    case $1 in
      --name) template_name="$2"; shift 2 ;;
      --display-name) display_name="$2"; shift 2 ;;
      --description) description="$2"; shift 2 ;;
      --web-port) web_port="$2"; shift 2 ;;
      --cpu) cpu="$2"; shift 2 ;;
      --memory) memory="$2"; shift 2 ;;
      --storage) storage_size="$2"; shift 2 ;;
      --storage-path) storage_path="$2"; shift 2 ;;
      --allow) network_rules+=("{\"action\":\"allow\",\"host\":\"$2\"}"); shift 2 ;;
      --block) network_rules+=("{\"action\":\"deny\",\"host\":\"$2\"}"); shift 2 ;;
      --deny-all) deny_all=true; shift ;;
      --repo) repo_rules+=("{\"pattern\":\"$2\"}"); shift 2 ;;
      --secret) secret_specs+=("$2"); shift 2 ;;
      -*) echo_fail "Unknown option: $1"; exit 1 ;;
      *) image_path="$1"; shift ;;
    esac
  done

  if [[ -z "$image_path" ]]; then
    echo_fail "Image path required. Usage: pcli register <image-path>"
    echo ""
    echo "Available images:"
    cmd_images
    exit 1
  fi

  local registry
  registry=$(api_call GET "/api/v1/ecr/repositories" | sed '$d' | jq -r '.[0].uri // ""' 2>/dev/null | cut -d'/' -f1)
  if [[ -z "$registry" ]]; then
    registry="448623754506.dkr.ecr.ap-southeast-1.amazonaws.com"
  fi

  if [[ "$image_path" == user/* ]]; then
    local after_user="${image_path#user/}"
    local name_part="${after_user%%:*}"
    if [[ "$name_part" != */* ]]; then
      local sanitized_user
      sanitized_user=$(sanitize_user_id "$(get_effective_user_id)")
      image_path="user/${sanitized_user}/${after_user}"
    fi
  fi

  local full_image="$image_path"
  if [[ "$image_path" != *".amazonaws.com/"* ]]; then
    full_image="${registry}/${image_path}"
  fi

  local image_name
  image_name=$(echo "$image_path" | rev | cut -d'/' -f1 | rev | cut -d':' -f1)
  template_name="${template_name:-$image_name}"
  display_name="${display_name:-$template_name}"

  if [[ -z "$description" ]]; then
    if [[ "$PCLI_INTERACTIVE" -eq 1 ]]; then
      read -r -p "Description: " description
    else
      description="$template_name"
    fi
  fi

  local web_enabled="false"
  [[ "$web_port" != "0" ]] && web_enabled="true"

  local storage_enabled="false"
  [[ -n "$storage_size" ]] && storage_enabled="true"

  local secrets_array
  secrets_array=$(jq -n '[
    {"key":"gitlab-pat","display_name":"GitLab Personal Access Token","description":"For repository access (glpat-...)","input_type":"password","secret_type":"gitlab-pat","required":false},
    {"key":"gitlab-ssh","display_name":"GitLab SSH Private Key","description":"SSH key for git operations (auto-generates internal keypair)","input_type":"textarea","secret_type":"gitlab-ssh","required":false},
    {"key":"grabgpt_api_key","display_name":"LLM API Key","description":"GrabGPT or Aergia service API key","input_type":"password","secret_type":"proxy","required":false}
  ]')
  for spec in "${secret_specs[@]}"; do
    case "$spec" in
      gitlab-pat)
        secrets_array=$(echo "$secrets_array" | jq '. + [{"key":"gitlab-pat","display_name":"GitLab Personal Access Token","description":"For repository access (glpat-...)","input_type":"password","secret_type":"gitlab-pat","required":false}]') ;;
      gitlab-ssh)
        secrets_array=$(echo "$secrets_array" | jq '. + [{"key":"gitlab-ssh","display_name":"GitLab SSH Private Key","description":"SSH key for git operations (auto-generates internal keypair)","input_type":"textarea","secret_type":"gitlab-ssh","required":false}]') ;;
      llm-key)
        secrets_array=$(echo "$secrets_array" | jq '. + [{"key":"grabgpt_api_key","display_name":"LLM API Key","description":"GrabGPT or Aergia service API key","input_type":"password","secret_type":"proxy","required":false}]') ;;
      *:*:*:*:*)
        local skey sdisp sdesc sinput stype
        IFS=: read -r skey sdisp sdesc sinput stype <<< "$spec"
        secrets_array=$(echo "$secrets_array" | jq --arg k "$skey" --arg d "$sdisp" --arg desc "$sdesc" --arg it "$sinput" --arg st "$stype" \
          '. + [{"key":$k,"display_name":$d,"description":$desc,"input_type":$it,"secret_type":$st,"required":false}]') ;;
      *)
        echo_fail "Unknown secret preset: $spec (use gitlab-pat, gitlab-ssh, llm-key, or KEY:DISPLAY:DESC:INPUT_TYPE:SECRET_TYPE)"
        exit 1 ;;
    esac
  done
  secrets_array=$(echo "$secrets_array" | jq 'unique_by(.key)')

  local manifest_json
  manifest_json=$(jq -n \
    --arg name "$template_name" \
    --arg display "$display_name" \
    --arg desc "$description" \
    --arg image "$full_image" \
    --arg cpu "$cpu" \
    --arg mem "$memory" \
    --argjson web_on "$web_enabled" \
    --argjson web_port "$web_port" \
    --argjson storage_on "$storage_enabled" \
    --arg storage_size "${storage_size:-0}" \
    --arg storage_path "$storage_path" \
    --argjson secrets "$secrets_array" \
    '{
      metadata: {name: $name, display_name: $display, description: $desc},
      container: {image: $image},
      resources: {cpu: $cpu, memory: $mem},
      web: {enabled: $web_on, port: $web_port},
      storage: {enabled: $storage_on, size: $storage_size, mount_path: $storage_path},
      secrets: $secrets
    }')

  if [[ "$deny_all" == "true" ]] || [[ ${#network_rules[@]} -gt 0 ]]; then
    local rules_array="[]"
    for rule in "${network_rules[@]}"; do
      rules_array=$(echo "$rules_array" | jq ". + [$rule]")
    done
    if [[ "$deny_all" == "true" ]]; then
      rules_array=$(echo "$rules_array" | jq '. + [{"action":"deny","host":"*"}]')
    else
      rules_array=$(echo "$rules_array" | jq '. + [{"action":"allow","host":"*"}]')
    fi
    manifest_json=$(echo "$manifest_json" | jq --argjson rules "$rules_array" '.proxy_policy = {network: $rules}')
  fi

  if [[ ${#repo_rules[@]} -gt 0 ]]; then
    local repos_array="[]"
    for rule in "${repo_rules[@]}"; do
      repos_array=$(echo "$repos_array" | jq ". + [$rule]")
    done
    manifest_json=$(echo "$manifest_json" | jq --argjson repos "$repos_array" '.gitlab_policy = {repositories: $repos}')
  fi

  echo_step "Registering template: $template_name"
  local response status body
  response=$(api_call POST "/api/v1/user-templates" "$manifest_json")
  status=$(echo "$response" | tail -1)
  body=$(echo "$response" | sed '$d')

  if [[ "$status" == "201" ]]; then
    echo_pass "Template registered! Deploy with: pcli deploy <agent> --template $template_name"
    echo "  Or launch from the portal under 'My Images'"
  else
    local err
    err=$(echo "$body" | jq -r '.error // "unknown error"' 2>/dev/null || echo "$body")
    echo_fail "Failed to register template: $err (HTTP $status)"
    exit 1
  fi
}

# poll_share_publish_status polls /api/v1/shared-templates/<name>/status until
# the publish/republish job reaches a terminal state. Prints progress.
poll_share_publish_status() {
  local template_name="$1"
  local timeout_secs="${2:-300}"
  local start_ts=$(date +%s)
  local last_status=""
  while :; do
    local elapsed=$(( $(date +%s) - start_ts ))
    if [[ $elapsed -gt $timeout_secs ]]; then
      echo_fail "Timed out waiting for publish job (${timeout_secs}s)"
      return 1
    fi
    local response status body
    response=$(api_call GET "/api/v1/shared-templates/${template_name}/status")
    status=$(echo "$response" | tail -1)
    body=$(echo "$response" | sed '$d')
    if [[ "$status" != "200" ]]; then
      echo_fail "Status request failed: HTTP $status"
      return 1
    fi
    local job_status job_name digest msg
    job_status=$(echo "$body" | jq -r '.status // "unknown"')
    job_name=$(echo "$body" | jq -r '.job_name // ""')
    digest=$(echo "$body" | jq -r '.source_image_digest // ""')
    msg=$(echo "$body" | jq -r '.message // ""')

    if [[ "$job_status" != "$last_status" ]]; then
      echo "  [${elapsed}s] status=${job_status}${job_name:+ job=${job_name}}"
      last_status="$job_status"
    fi
    case "$job_status" in
      succeeded)
        echo_pass "Publish complete${digest:+ — digest=${digest}}"
        return 0
        ;;
      failed)
        echo_fail "Publish failed${msg:+: ${msg}}${job_name:+ (kubectl logs -n palana-system -l job-name=${job_name})}"
        return 1
        ;;
    esac
    sleep 3
  done
}

cmd_publish() {
  if contains_help "$@"; then
    echo "Usage: pcli publish <template-name>"
    echo ""
    echo "Publish a personal user template to the Community tab so other users can"
    echo "launch it. Copies your image from user/<you>/<name>:latest to a new"
    echo "shared/<you>/<name>:latest ECR repo (snapshot semantics — see republish)."
    echo ""
    echo "Only the owner can publish, republish, or unpublish a shared template."
    exit 0
  fi
  local name="$1"
  if [[ -z "$name" ]]; then
    echo_fail "Usage: pcli publish <template-name>"
    exit 1
  fi
  echo_step "Requesting publish for template: $name"
  local response status body
  response=$(api_call POST "/api/v1/shared-templates" "{\"template_name\": \"$name\"}")
  status=$(echo "$response" | tail -1)
  body=$(echo "$response" | sed '$d')
  if [[ "$status" != "202" ]]; then
    local err
    err=$(echo "$body" | jq -r '.error // "unknown error"' 2>/dev/null || echo "$body")
    echo_fail "Publish request rejected: $err (HTTP $status)"
    exit 1
  fi
  local job_name
  job_name=$(echo "$body" | jq -r '.job_name')
  echo_pass "Publish dispatched (job=$job_name); polling for completion..."
  poll_share_publish_status "$name" 300 || exit 1
}

cmd_unpublish() {
  if contains_help "$@"; then
    echo "Usage: pcli unpublish <template-name>"
    echo ""
    echo "Remove a shared template from the Community tab. Only the owner may"
    echo "unpublish. The shared/ ECR repo is preserved (lifecycle policy expires"
    echo "old images naturally)."
    exit 0
  fi
  local name="$1"
  if [[ -z "$name" ]]; then
    echo_fail "Usage: pcli unpublish <template-name>"
    exit 1
  fi
  echo_step "Unpublishing template: $name"
  local response status body
  response=$(api_call DELETE "/api/v1/shared-templates/${name}")
  status=$(echo "$response" | tail -1)
  body=$(echo "$response" | sed '$d')
  if [[ "$status" == "200" ]]; then
    echo_pass "Unpublished: $name"
  else
    local err
    err=$(echo "$body" | jq -r '.error // "unknown error"' 2>/dev/null || echo "$body")
    echo_fail "Unpublish failed: $err (HTTP $status)"
    exit 1
  fi
}

cmd_republish() {
  if contains_help "$@"; then
    echo "Usage: pcli republish <template-name>"
    echo ""
    echo "Re-snapshot the image for an already-published template. Use after"
    echo "pcli push to propagate a new image build to consumers. Only the owner"
    echo "may republish."
    exit 0
  fi
  local name="$1"
  if [[ -z "$name" ]]; then
    echo_fail "Usage: pcli republish <template-name>"
    exit 1
  fi
  echo_step "Requesting republish for template: $name"
  local response status body
  response=$(api_call POST "/api/v1/shared-templates/${name}/republish" "{}")
  status=$(echo "$response" | tail -1)
  body=$(echo "$response" | sed '$d')
  if [[ "$status" != "202" ]]; then
    local err
    err=$(echo "$body" | jq -r '.error // "unknown error"' 2>/dev/null || echo "$body")
    echo_fail "Republish request rejected: $err (HTTP $status)"
    exit 1
  fi
  local job_name
  job_name=$(echo "$body" | jq -r '.job_name')
  echo_pass "Republish dispatched (job=$job_name); polling for completion..."
  poll_share_publish_status "$name" 300 || exit 1
}

# cmd_community lists templates published to the Community tab. Hits
# /api/v1/shared-templates and prints a table similar to cmd_images.
cmd_community() {
  if contains_help "$@"; then
    echo "Usage: pcli templates --community [--json]"
    echo ""
    echo "List templates published to the Community tab (cross-user shared images)."
    exit 0
  fi
  local json_output=0
  for arg in "$@"; do
    [[ "$arg" == "--json" ]] && json_output=1
  done
  echo_step "Fetching community templates..."
  local response status body
  response=$(api_call GET "/api/v1/shared-templates")
  status=$(echo "$response" | tail -1)
  body=$(echo "$response" | sed '$d')
  if [[ "$status" != "200" ]]; then
    local err
    err=$(echo "$body" | jq -r '.error // "unknown error"' 2>/dev/null || echo "$body")
    echo_fail "Failed to list community templates: $err (HTTP $status)"
    exit 1
  fi
  if [[ "$json_output" == "1" ]]; then
    echo "$body"
    return
  fi
  local count
  count=$(echo "$body" | jq 'length' 2>/dev/null || echo 0)
  if [[ "$count" == "0" ]]; then
    echo "No community templates yet. Publish one with: pcli publish <template-name>"
    return
  fi
  printf "%-22s %-30s %-30s %s\n" "NAME" "DISPLAY" "PUBLISHED BY" "PUBLISHED AT"
  printf "%-22s %-30s %-30s %s\n" "----" "-------" "------------" "------------"
  echo "$body" | jq -r '.[] | [.name, .display_name, .shared_by, .shared_at] | @tsv' 2>/dev/null | \
    while IFS=$'\t' read -r n d sby sat; do
      printf "%-22s %-30s %-30s %s\n" "$n" "$d" "$sby" "$sat"
    done
  echo ""
  echo "$count community template(s)"
}

cmd_templates() {
  local count=0
  printf "%-20s %-8s %-10s %-10s %-10s %-10s %s\n" "NAME" "TYPE" "WEB PORT" "CPU" "MEMORY" "SOURCE" "SECRETS"
  printf "%-20s %-8s %-10s %-10s %-10s %-10s %s\n" "----" "----" "--------" "---" "------" "------" "-------"

  local seen_names=()
  check_manifest_staleness
  for dir_pair in "system:$MANIFESTS_DIR" "user:$USER_MANIFESTS_DIR" "home-user:$HOME_USER_MANIFESTS_DIR" "home:$HOME_MANIFESTS_DIR"; do
    local source_label="${dir_pair%%:*}"
    local dir="${dir_pair#*:}"
    [[ -d "$dir" ]] || continue
    for manifest_file in "$dir"/*.yaml; do
      [[ -f "$manifest_file" ]] || continue
      local name=$(basename "$manifest_file" .yaml)
      # Skip user-manifests that shadow system manifests
      local already_seen=0
      for seen in "${seen_names[@]:-}"; do
        [[ "$seen" == "$name" ]] && already_seen=1 && break
      done
      [[ "$already_seen" -eq 1 ]] && continue
      seen_names+=("$name")
    local display_name=$(manifest_field "$name" "metadata.display_name")
    local ctype=$(manifest_field "$name" "container.type")
    local web_enabled=$(manifest_field "$name" "web.enabled")
    local web_port="-"
    if [[ "$web_enabled" == "true" ]]; then
      web_port=$(manifest_field "$name" "web.port")
    fi
    local cpu=$(manifest_field "$name" "resources.cpu")
    local memory=$(manifest_field "$name" "resources.memory")

    local secret_count=0
    if command -v yq &>/dev/null; then
      secret_count=$(yq '.secrets | length' "$manifest_file" 2>/dev/null || echo 0)
    else
      secret_count=$(grep -c '^ *- key:' "$manifest_file" 2>/dev/null || echo 0)
    fi

    printf "%-20s %-8s %-10s %-10s %-10s %-10s %s\n" "$name" "$ctype" "$web_port" "$cpu" "$memory" "$source_label" "$secret_count"
    count=$((count + 1))
    done
  done

  echo ""
  echo "$count manifest(s) found"
}

cmd_templates_describe() {
  if contains_help "$@"; then
    echo "Usage: pcli templates describe <template-name>"
    echo ""
    echo "Show full details for a template including documentation, secrets, and policies."
    exit 0
  fi

  local name="$1"
  if [[ -z "$name" ]]; then
    echo_fail "Usage: pcli templates describe <template-name>"
    exit 1
  fi

  local manifest
  manifest=$(resolve_manifest "$name")
  if [[ -z "$manifest" ]]; then
    echo_fail "Template not found: $name"
    echo "Run 'pcli templates' to see available templates."
    exit 1
  fi

  local source_label="unknown"
  case "$manifest" in
    "$MANIFESTS_DIR"/*) source_label="system" ;;
    "$USER_MANIFESTS_DIR"/*) source_label="user" ;;
    "$HOME_USER_MANIFESTS_DIR"/*) source_label="home-user" ;;
    "$HOME_MANIFESTS_DIR"/*) source_label="home" ;;
  esac

  local display_name=$(manifest_field "$name" "metadata.display_name")
  local description=$(manifest_field "$name" "metadata.description")
  local image=$(manifest_field "$name" "container.image")
  local ctype=$(manifest_field "$name" "container.type")
  local cpu=$(manifest_field "$name" "resources.cpu")
  local memory=$(manifest_field "$name" "resources.memory")
  local web_enabled=$(manifest_field "$name" "web.enabled")
  local web_port=$(manifest_field "$name" "web.port")
  local web_oauth=$(manifest_field "$name" "web.oauth")
  local web_auth=$(manifest_field "$name" "web.auth")
  local storage_enabled=$(manifest_field "$name" "storage.enabled")
  local storage_size=$(manifest_field "$name" "storage.size")
  local storage_mount=$(manifest_field "$name" "storage.mount_path")
  local shm_size=$(manifest_field "$name" "shm_size")

  echo ""
  echo "Template:     $name"
  echo "Display Name: ${display_name:-$name}"
  [[ -n "$description" ]] && echo "Description:  $description"
  echo "Source:       $source_label"
  echo ""

  echo "Container:"
  echo "  Image: ${image:-unknown}"
  echo "  Type:  ${ctype:-agent}"
  echo ""

  echo "Resources:"
  echo "  CPU:    ${cpu:-not set}"
  echo "  Memory: ${memory:-not set}"
  [[ -n "$shm_size" ]] && echo "  SHM:    $shm_size"
  echo ""

  echo "Web:"
  if [[ "$web_enabled" == "true" ]]; then
    echo "  Enabled: true"
    echo "  Port:    ${web_port:-not set}"
    [[ -n "$web_oauth" && "$web_oauth" != "false" ]] && echo "  OAuth:   $web_oauth"
    [[ -n "$web_auth" ]] && echo "  Auth:    $web_auth"
  else
    echo "  Enabled: false"
  fi
  echo ""

  echo "Storage:"
  if [[ "$storage_enabled" == "true" ]]; then
    echo "  Enabled:    true"
    echo "  Size:       ${storage_size:-not set}"
    echo "  Mount Path: ${storage_mount:-/data}"
  else
    echo "  Enabled: false"
  fi
  echo ""

  echo "Secrets:"
  if command -v yq &>/dev/null; then
    local secret_count
    secret_count=$(yq '.secrets | length' "$manifest" 2>/dev/null || echo 0)
    if [[ "$secret_count" -gt 0 ]]; then
      local i=0
      while [[ $i -lt $secret_count ]]; do
        local skey=$(yq -r ".secrets[$i].key // \"\"" "$manifest" 2>/dev/null)
        local sdisplay=$(yq -r ".secrets[$i].display_name // \"\"" "$manifest" 2>/dev/null)
        local sdesc=$(yq -r ".secrets[$i].description // \"\"" "$manifest" 2>/dev/null)
        local srequired=$(yq -r ".secrets[$i].required // false" "$manifest" 2>/dev/null)
        local req_label=""
        [[ "$srequired" == "true" ]] && req_label=" (required)"
        echo "  - ${skey}${req_label}"
        [[ -n "$sdisplay" ]] && echo "    ${sdisplay}"
        [[ -n "$sdesc" ]] && echo "    ${sdesc}"
        echo ""
        i=$((i + 1))
      done
    else
      echo "  (none)"
      echo ""
    fi
  else
    local has_secrets=0
    while IFS= read -r line; do
      has_secrets=1
      local skey=$(echo "$line" | sed 's/^ *- key: *//')
      echo "  - $skey"
    done < <(grep '^ *- key:' "$manifest" 2>/dev/null)
    [[ "$has_secrets" -eq 0 ]] && echo "  (none)"
    echo ""
  fi

  if command -v yq &>/dev/null; then
    local proxy_rules
    proxy_rules=$(yq -r '(.proxy_policy.proxy_egress // .proxy_policy.network // []) | length' "$manifest" 2>/dev/null || echo 0)
    if [[ "$proxy_rules" -gt 0 ]]; then
      echo "Proxy Policy:"
      local j=0
      while [[ $j -lt $proxy_rules ]]; do
        local action=$(yq -r "(.proxy_policy.proxy_egress // .proxy_policy.network)[$j].action // \"\"" "$manifest" 2>/dev/null)
        local host=$(yq -r "(.proxy_policy.proxy_egress // .proxy_policy.network)[$j].host // \"\"" "$manifest" 2>/dev/null)
        echo "  - $action $host"
        j=$((j + 1))
      done
      echo ""
    fi

    local repo_rules
    repo_rules=$(yq -r '.gitlab_policy.repositories | length' "$manifest" 2>/dev/null || echo 0)
    if [[ "$repo_rules" -gt 0 ]]; then
      echo "GitLab Policy:"
      local k=0
      while [[ $k -lt $repo_rules ]]; do
        local pattern=$(yq -r ".gitlab_policy.repositories[$k].pattern // \"\"" "$manifest" 2>/dev/null)
        echo "  Repositories: $pattern"
        k=$((k + 1))
      done
      echo ""
    fi
  fi

  local documentation=$(manifest_field "$name" "metadata.documentation")
  if [[ -n "$documentation" ]]; then
    echo "Documentation:"
    echo "$documentation" | sed 's/^/  /'
  fi
}

# fetch_remote_user_template <name>
# Fetches a user-registered manifest from the server's user-manifests ConfigMap.
# Prints raw YAML to stdout on success; returns 1 on any error (404, network).
# Silent on failure — caller decides what to do.
fetch_remote_user_template() {
  local name="$1"
  local response status body
  response=$(api_call GET "/api/v1/user-templates/$name" 2>/dev/null) || return 1
  status=$(echo "$response" | tail -1)
  body=$(echo "$response" | sed '$d')
  [[ "$status" == "200" ]] || return 1
  echo "$body"
}

# cache_remote_user_template <name>
# Convenience: fetches and writes the manifest to
# ~/.palana/build/user-manifests/<name>.yaml so resolve_manifest can find it
# on the next call. Returns 0 on success, 1 if no remote template found.
cache_remote_user_template() {
  local name="$1"
  local yaml
  yaml=$(fetch_remote_user_template "$name") || return 1
  mkdir -p "$HOME_USER_MANIFESTS_DIR"
  echo "$yaml" > "$HOME_USER_MANIFESTS_DIR/${name}.yaml"
}

cmd_templates_register() {
  if contains_help "$@"; then
    echo "Usage: pcli templates register <file.yaml>"
    echo ""
    echo "Register a manifest YAML file as a launchable user template."
    echo "The manifest's container.image must already exist in your personal"
    echo "ECR namespace (user/<you>/...). Push the image first with pcli push,"
    echo "or use pcli register <ecr-image-path> for the flag-driven flow."
    echo ""
    echo "After registration, the template is visible to portal + agent-api,"
    echo "and can be pulled to a fresh dev machine via:"
    echo "  pcli templates pull <name>"
    exit 0
  fi

  local file="$1"
  if [[ -z "$file" ]]; then
    echo_fail "Usage: pcli templates register <file.yaml>"
    exit 1
  fi
  if [[ ! -f "$file" ]]; then
    echo_fail "Manifest file not found: $file"
    exit 1
  fi
  if ! command -v yq &>/dev/null; then
    echo_fail "yq is required to convert YAML to JSON for registration"
    echo "  Install: brew install yq (macOS) or apt install yq"
    exit 1
  fi

  local json_body
  if ! json_body=$(yq -o=json '.' "$file" 2>&1); then
    echo_fail "Failed to parse $file as YAML:"
    echo "$json_body" | sed 's/^/  /'
    exit 1
  fi

  echo_step "Registering template from $file"
  local response status body
  response=$(api_call POST "/api/v1/user-templates" "$json_body")
  status=$(echo "$response" | tail -1)
  body=$(echo "$response" | sed '$d')

  if [[ "$status" == "201" ]]; then
    local name
    name=$(echo "$body" | jq -r '.name // empty' 2>/dev/null)
    echo_pass "Template registered: ${name:-(see manifest metadata.name)}"
    echo ""
    echo "  Cache locally:    pcli templates pull ${name:-<name>}"
    echo "  Launch:           pcli run <agent> --manifest ${name:-<name>}"
  else
    local err
    err=$(echo "$body" | jq -r '.error // "unknown error"' 2>/dev/null || echo "$body")
    echo_fail "Registration failed: $err (HTTP $status)"
    exit 1
  fi
}

cmd_templates_pull() {
  if contains_help "$@"; then
    echo "Usage: pcli templates pull [name] [--no-overwrite]"
    echo ""
    echo "Pull user-registered templates from the cluster down to"
    echo "$HOME_USER_MANIFESTS_DIR so pcli run can auto-resolve them."
    echo ""
    echo "Without a name, pulls every template you've registered."
    echo "With a name, pulls just that one."
    echo ""
    echo "Existing local files are overwritten by default; pass --no-overwrite"
    echo "to skip templates that already exist locally."
    exit 0
  fi

  local target_name="" no_overwrite=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-overwrite) no_overwrite=1; shift ;;
      -*) echo_fail "Unknown option: $1"; exit 1 ;;
      *)
        if [[ -z "$target_name" ]]; then
          target_name="$1"
        else
          echo_fail "Unexpected arg: $1"; exit 1
        fi
        shift
        ;;
    esac
  done

  mkdir -p "$HOME_USER_MANIFESTS_DIR"

  if [[ -n "$target_name" ]]; then
    local dest="$HOME_USER_MANIFESTS_DIR/${target_name}.yaml"
    if [[ -f "$dest" && "$no_overwrite" -eq 1 ]]; then
      echo_warn "Skipped (already exists): $dest"
      return
    fi
    local yaml
    if ! yaml=$(fetch_remote_user_template "$target_name"); then
      echo_fail "Template '$target_name' not registered on the server."
      echo "  Register one with: pcli templates register <file.yaml>"
      exit 1
    fi
    echo "$yaml" > "$dest"
    echo_pass "Pulled $target_name → $dest"
    return
  fi

  local list_response list_status list_body
  list_response=$(api_call GET "/api/v1/user-templates")
  list_status=$(echo "$list_response" | tail -1)
  list_body=$(echo "$list_response" | sed '$d')
  if [[ "$list_status" != "200" ]]; then
    echo_fail "Failed to list user templates (HTTP $list_status)"
    exit 1
  fi
  local names
  names=$(echo "$list_body" | jq -r '.[]?.name' 2>/dev/null)
  if [[ -z "$names" ]]; then
    echo_warn "You have no registered user templates yet."
    echo "  Register one with: pcli templates register <file.yaml>"
    echo "                  or pcli push <local-image>"
    return
  fi
  local count=0 skipped=0
  while IFS= read -r name; do
    [[ -z "$name" ]] && continue
    local dest="$HOME_USER_MANIFESTS_DIR/${name}.yaml"
    if [[ -f "$dest" && "$no_overwrite" -eq 1 ]]; then
      skipped=$((skipped + 1))
      continue
    fi
    local yaml
    if ! yaml=$(fetch_remote_user_template "$name"); then
      echo_warn "Failed to fetch '$name', skipping"
      continue
    fi
    echo "$yaml" > "$dest"
    count=$((count + 1))
  done <<< "$names"
  echo_pass "Pulled $count template(s) to $HOME_USER_MANIFESTS_DIR"
  if [[ "$skipped" -gt 0 ]]; then
    echo "  Skipped $skipped existing file(s) (omit --no-overwrite to replace)"
  fi
}

cmd_sync() {
  if contains_help "$@"; then
    echo "Usage: pcli sync"
    echo ""
    echo "Fetch latest system templates from agent-api into ~/.palana/build/manifests/"
    echo "Templates are used by 'pcli create', 'pcli run', and 'pcli templates'."
    echo ""
    echo "This is run automatically by 'pcli preflight' and 'pcli login'."
    echo "User templates in ~/.palana/build/user-manifests/ are never modified."
    exit 0
  fi

  local response status body
  response=$(api_call GET "/api/v1/manifests")
  status=$(echo "$response" | tail -1)
  body=$(echo "$response" | sed '$d')

  if [[ "$status" != "200" ]]; then
    echo_fail "Failed to list manifests from agent-api (HTTP $status)"
    return 1
  fi

  local names
  names=$(echo "$body" | jq -r '.[]' 2>/dev/null)
  if [[ -z "$names" ]]; then
    echo_warn "No manifests returned from agent-api"
    return 0
  fi

  mkdir -p "$HOME_MANIFESTS_DIR"

  local count=0
  while IFS= read -r name; do
    local resp st bd
    resp=$(api_call GET "/api/v1/manifests/$name")
    st=$(echo "$resp" | tail -1)
    bd=$(echo "$resp" | sed '$d')
    if [[ "$st" == "200" ]]; then
      echo "$bd" > "$HOME_MANIFESTS_DIR/${name}.yaml"
      count=$((count + 1))
    else
      echo_warn "  Failed to fetch manifest '$name' (HTTP $st)"
    fi
  done <<< "$names"

  date +%s > "$HOME_MANIFESTS_DIR/.last-sync"
  echo_pass "Synced $count template(s) to $HOME_MANIFESTS_DIR"
}

check_manifest_staleness() {
  local sync_file="$HOME_MANIFESTS_DIR/.last-sync"
  if [[ ! -f "$sync_file" ]]; then
    if [[ ! -d "$MANIFESTS_DIR" ]] || ! ls "$MANIFESTS_DIR"/*.yaml >/dev/null 2>&1; then
      echo_warn "No local templates found. Run 'pcli sync' to fetch templates from agent-api."
    fi
    return
  fi
  local last_sync now age
  last_sync=$(cat "$sync_file")
  now=$(date +%s)
  age=$(( now - last_sync ))
  if [[ $age -gt 86400 ]]; then
    local hours=$(( age / 3600 ))
    echo_warn "Template cache is ${hours}h old. Run 'pcli sync' to refresh."
  fi
}

