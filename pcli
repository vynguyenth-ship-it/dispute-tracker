}

# Toggle the per-agent Cilium NetworkPolicy enforcement.
# Patches the UserAgent CR's spec.cilium_network_policy_enforced field;
# the operator picks up the change on its next reconcile (~30s) and either
# creates or deletes the agent-isolation NetworkPolicy accordingly.
# Default-deny is the platform invariant: agents with the field UNSET still
# get an agent-isolation policy (default ON). Explicit `off` opts the agent
# out of Cilium enforcement entirely. See docs/CILIUM_OPERATIONS.md.
cmd_policy_cilium_enforce() {
  local agent="${1:-}"
  local action="${2:-status}"

  if [[ -z "$agent" ]]; then
    echo_fail "Usage: pcli policy cilium-enforce <agent> [on|off]"
    exit 1
  fi

  local user_ns
  user_ns=$(get_user_namespace)
  local cr_name
  cr_name=$(get_agent_cr_name "$agent")
  if [[ -z "$cr_name" ]]; then
    echo_fail "No UserAgent CR found for agent '${agent}' in namespace ${user_ns}"
    exit 1
  fi

  case "$action" in
    on|enable|true)
      echo_step "Enabling Cilium NetworkPolicy enforcement for ${agent}"
      kubectl patch useragent "$cr_name" -n "$user_ns" --type=merge \
        -p '{"spec":{"cilium_network_policy_enforced":true}}' 2>&1 \
        || { echo_fail "Failed to patch UserAgent CR"; exit 1; }
      echo_pass "Cilium enforcement enabled (operator reconciles within ~30s)"
      echo "  Note: cluster is currently in audit mode — drops will be logged but not enforced."
      echo "  Watch live: kubectl -n kube-system port-forward svc/hubble-relay 4245:80 && hubble observe --verdict DROPPED --namespace agent-${cr_name%-agent}"
      ;;
    off|disable|false)
      echo_step "Disabling Cilium NetworkPolicy enforcement for ${agent}"
      kubectl patch useragent "$cr_name" -n "$user_ns" --type=merge \
        -p '{"spec":{"cilium_network_policy_enforced":false}}' 2>&1 \
        || { echo_fail "Failed to patch UserAgent CR"; exit 1; }
      echo_pass "Cilium enforcement disabled (any existing agent-isolation NetworkPolicy will be deleted on next reconcile)"
      ;;
    status|"")
      local current
      current=$(kubectl get useragent "$cr_name" -n "$user_ns" -o jsonpath='{.spec.cilium_network_policy_enforced}' 2>/dev/null)
      case "$current" in
        true)
          echo_pass "${agent}: Cilium enforcement = ENABLED (agent-isolation NetworkPolicy applied, explicit)"
          ;;
        false)
          echo "  ${agent}: Cilium enforcement = DISABLED (explicit opt-out — no policy)"
          ;;
        "")
          echo_pass "${agent}: Cilium enforcement = ENABLED (default — agent-isolation NetworkPolicy applied)"
          ;;
        *)
          echo_warn "${agent}: Cilium enforcement = unexpected value '${current}'"
          ;;
      esac
      ;;
    *)
      echo_fail "Unknown action '${action}'. Use: on | off | status"
      exit 1
      ;;
  esac
}

cmd_policy_set() {
  local agent=$1
  shift || true

  if [[ -z "$agent" ]]; then
    echo_fail "Usage: pcli policy set <agent> --allow HOST [--allow HOST ...]"
    exit 1
  fi

  local user=$(get_effective_user_id)

  local -a allow_hosts=()
  while [[ $# -gt 0 ]]; do
    if [[ "$1" == "--allow" ]]; then
      shift
      [[ -n "${1:-}" ]] && allow_hosts+=("$1")
      shift || true
    else
      shift
    fi
  done

  if [[ ${#allow_hosts[@]} -eq 0 ]]; then
    echo_fail "At least one --allow HOST required"
    exit 1
  fi

  # Build network rules: allow each host, then deny *
  local -a rule_args=()
  for h in "${allow_hosts[@]}"; do
    rule_args+=("$(jq -nc --arg h "$h" '{action:"allow",host:$h}')")
  done
  rule_args+=('{"action":"deny","host":"*"}')
  local net_json="[$(IFS=,; echo "${rule_args[*]}")]"
  local body
  body=$(jq -nc --argjson net "$net_json" '{network: $net}')

  local response
  response=$(api_call PUT "/api/v1/policy/${agent}" "$body")
  local parsed status body_text
  parsed=$(parse_api_response "$response")
  status=$(echo "$parsed" | head -1)
  body_text=$(echo "$parsed" | tail -n +2)

  if [[ "$status" -ge 200 && "$status" -lt 300 ]]; then
    echo_pass "Policy set for ${agent}: allow ${allow_hosts[*]}, deny *"
  else
    echo_fail "Failed to set policy (HTTP $status): $body_text"
    exit 1
  fi
}

