  echo "                        Omit to auto-detect from image"
  echo "                        Use \"\" to disable port exposure"
  echo "  --cpu MILLICORES      CPU limit (default: 100m, range: 100m-8000m)"
  echo "  --memory MB           Memory limit (default: 512M, range: 128Mi-8192Mi)"
  echo "  --name NAME           Pod name (default: image name + random suffix)"
  echo "  --restart POLICY      Restart policy: Always|Never|OnFailure (default: Always)"
