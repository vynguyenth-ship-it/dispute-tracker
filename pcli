# Test network
cmd_test_network() {
  if contains_help "$@"; then
    echo "Usage: pcli test-network <agent-name>"
    exit 0
  fi

  local name=$1

  if [[ -z "$name" ]]; then
    echo_fail "Usage: pcli test-network <agent-name>"
    exit 1
  fi

  local user=$(get_effective_user_id)
  local namespace
  namespace=$(get_agent_namespace "$name")

  echo_step "Testing network connectivity for $user/$name"

