cmd_peer_connect() {
  local agent="${1:-}"
  local peer="${2:-}"

  if [[ -z "$agent" || -z "$peer" ]]; then
    echo_fail "Usage: pcli peer connect <agent> <peer>"
    exit 1
  fi

  check_credentials

  local response parsed status body_text
  response=$(api_call POST "/api/v1/peer-policy/${agent}/connect/${peer}")
  parsed=$(parse_api_response "$response")
  status=$(echo "$parsed" | head -1)
  body_text=$(echo "$parsed" | tail -n +2)

  if [[ "$status" -ge 200 && "$status" -lt 300 ]]; then
    local conn_status dns port
    conn_status=$(echo "$body_text" | jq -r '.status // "ok"')
    dns=$(echo "$body_text" | jq -r '.dns // "unknown"')
    port=$(echo "$body_text" | jq -r '.port // 0')
    if [[ "$conn_status" == "already_connected" ]]; then
      echo_pass "Already connected ${agent} → ${peer}"
    else
      echo_pass "Connected ${agent} → ${peer}"
    fi
    echo "  DNS:  ${dns}"
    echo "  Port: ${port}"
    echo "  Use:  curl http://${dns}:${port}/"
  else
    echo_fail "Failed to connect (HTTP $status): $body_text"
    exit 1
  fi
}

