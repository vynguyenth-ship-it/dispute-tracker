}

# mcp_egress_covers_host returns 0 if the proxy_egress list covers the host
# via either an exact-match allow rule (no method) or a literal "*" allow rule.
mcp_egress_covers_host() {
  local egress_json="$1"
  local host="$2"
  local match
  match=$(echo "$egress_json" | jq --arg h "$host" '
    [.[] | select(.action == "allow" and ((.method // "") == "")
                  and (.host == "*" or .host == $h))] | length')
  [[ "$match" != "0" ]]
}

# mcp_warn_egress_drift prints a warning for each enabled MCP whose host is not
# covered by the agent's proxy_egress allow-list. This is an anomalous state —
# enabling an MCP normally auto-adds the host. Drift means the ConfigMap was
# hand-edited, or was written before the auto-allow change shipped.
mcp_warn_egress_drift() {
  local agent="$1"
  local mcp_rules="$2"
  local enabled_hosts
  enabled_hosts=$(echo "$mcp_rules" | jq -r '.[] | select(.enabled) | .host')
  if [[ -z "$enabled_hosts" ]]; then
    return 0
  fi

  local pol_response pol_parsed pol_status pol_body egress
  pol_response=$(api_call GET "/api/v1/policy/${agent}")
  pol_parsed=$(parse_api_response "$pol_response")
  pol_status=$(echo "$pol_parsed" | head -1)
  pol_body=$(echo "$pol_parsed" | tail -n +2)
  if [[ "$pol_status" -lt 200 || "$pol_status" -ge 300 ]]; then
    return 0
  fi
  egress=$(echo "$pol_body" | jq -r '(.proxy_egress // .network // [])')

  local drift=()
  while IFS= read -r host; do
    [[ -z "$host" ]] && continue
    if ! mcp_egress_covers_host "$egress" "$host"; then
      drift+=("$host")
    fi
  done <<<"$enabled_hosts"

  if [[ ${#drift[@]} -gt 0 ]]; then
    echo ""
    echo "WARNING: ${#drift[@]} enabled MCP host(s) are not in proxy_egress."
    echo "         This is an anomalous configuration — MCP traffic to these"
    echo "         hosts will be denied by the network egress policy."
    for host in "${drift[@]}"; do
      echo "  ${host}  (fix: pcli policy set ${agent} --allow ${host})"
    done
  fi
}

cmd_mcp_enable() {
  local agent=$1
  shift || true
  if [[ -z "$agent" ]]; then
    echo_fail "Usage: pcli mcp enable <agent> --host HOST"
    exit 1
  fi

  local host=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --host) host="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  if [[ -z "$host" ]]; then
    echo_fail "--host is required"
    exit 1
  fi

  local response
  response=$(api_call GET "/api/v1/mcp-policy/${agent}")
  local parsed status body_text
  parsed=$(parse_api_response "$response")
  status=$(echo "$parsed" | head -1)
  body_text=$(echo "$parsed" | tail -n +2)
  if [[ "$status" -lt 200 || "$status" -ge 300 ]]; then
    echo_fail "Failed to read MCP config (HTTP $status)"
    exit 1
  fi

  local rules
  rules=$(echo "$body_text" | jq -r '.mcp_oauth // []')
  local exists
  exists=$(echo "$rules" | jq --arg h "$host" '[.[] | select(.host == $h)] | length')
  if [[ "$exists" == "0" ]]; then
    rules=$(echo "$rules" | jq --arg h "$host" '. + [{"host": $h, "enabled": true}]')
  else
    rules=$(echo "$rules" | jq --arg h "$host" '[.[] | if .host == $h then .enabled = true else . end]')
  fi

  local body
  body=$(jq -nc --argjson rules "$rules" '{"mcp_oauth": $rules}')
  response=$(api_call PUT "/api/v1/mcp-policy/${agent}" "$body")
  parsed=$(parse_api_response "$response")
  status=$(echo "$parsed" | head -1)
  if [[ "$status" -ge 200 && "$status" -lt 300 ]]; then
    echo_pass "MCP server ${host} enabled for ${agent}"
  else
    echo_fail "Failed to enable MCP server (HTTP $status)"
    exit 1
  fi
}

cmd_mcp_disable() {
  local agent=$1
  shift || true
  if [[ -z "$agent" ]]; then
    echo_fail "Usage: pcli mcp disable <agent> --host HOST [--prune-egress|--keep-egress]"
    exit 1
  fi

  local host=""
  local prune_choice=""  # "prune" | "keep" | "" (ask)
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --host) host="$2"; shift 2 ;;
      --prune-egress) prune_choice="prune"; shift ;;
      --keep-egress)  prune_choice="keep"; shift ;;
      *) shift ;;
    esac
  done
  if [[ -z "$host" ]]; then
    echo_fail "--host is required"
    exit 1
  fi

  local response parsed status body_text
  response=$(api_call GET "/api/v1/mcp-policy/${agent}")
  parsed=$(parse_api_response "$response")
  status=$(echo "$parsed" | head -1)
  body_text=$(echo "$parsed" | tail -n +2)
  if [[ "$status" -lt 200 || "$status" -ge 300 ]]; then
    echo_fail "Failed to read MCP config (HTTP $status)"
    exit 1
  fi

  local rules
  rules=$(echo "$body_text" | jq -r '.mcp_oauth // []')
  local was_enabled
  was_enabled=$(echo "$rules" | jq --arg h "$host" '[.[] | select(.host == $h and .enabled)] | length')
  local new_rules
  new_rules=$(echo "$rules" | jq --arg h "$host" '[.[] | if .host == $h then .enabled = false else . end]')

  local prune_hosts="[]"
  if [[ "$was_enabled" != "0" ]]; then
    local still_enabled_elsewhere
    still_enabled_elsewhere=$(echo "$new_rules" | jq --arg h "$host" '[.[] | select(.host == $h and .enabled)] | length')

    if [[ "$still_enabled_elsewhere" == "0" ]]; then
      local pol_response pol_parsed pol_status pol_body egress prunable
      pol_response=$(api_call GET "/api/v1/policy/${agent}")
      pol_parsed=$(parse_api_response "$pol_response")
      pol_status=$(echo "$pol_parsed" | head -1)
      pol_body=$(echo "$pol_parsed" | tail -n +2)
      if [[ "$pol_status" -ge 200 && "$pol_status" -lt 300 ]]; then
        egress=$(echo "$pol_body" | jq -r '(.proxy_egress // .network // [])')
        prunable=$(echo "$egress" | jq --arg h "$host" '[.[] | select(.action == "allow" and ((.method // "") == "") and .host == $h)] | length')
        if [[ "$prunable" != "0" ]]; then
          local decision="$prune_choice"
          if [[ -z "$decision" ]]; then
            if [[ -t 0 && -t 1 ]]; then
              echo "${host} is currently in the agent's proxy_egress allow-list."
              echo "Removing it is highly recommended unless the agent needs to reach"
              echo "${host} for something other than this MCP server."
              local answer=""
              read -r -p "Also remove ${host} from proxy_egress? [Y/n] " answer </dev/tty || answer=""
              answer=$(echo "$answer" | tr '[:upper:]' '[:lower:]')
              case "$answer" in
                ""|y|yes) decision="prune" ;;
                *)         decision="keep" ;;
              esac
            else
              decision="prune"
            fi
          fi
          if [[ "$decision" == "prune" ]]; then
            prune_hosts=$(jq -nc --arg h "$host" '[$h]')
          fi
        fi
      fi
    fi
  fi

  local body
  body=$(jq -nc --argjson rules "$new_rules" --argjson prune "$prune_hosts" \
    '{mcp_oauth: $rules} + (if ($prune | length) > 0 then {prune_egress_hosts: $prune} else {} end)')
  response=$(api_call PUT "/api/v1/mcp-policy/${agent}" "$body")
  parsed=$(parse_api_response "$response")
  status=$(echo "$parsed" | head -1)
  body_text=$(echo "$parsed" | tail -n +2)
  if [[ "$status" -ge 200 && "$status" -lt 300 ]]; then
    if [[ "$(echo "$prune_hosts" | jq length)" != "0" ]]; then
      echo_pass "MCP server ${host} disabled for ${agent} (egress allow-rule removed)"
    else
      echo_pass "MCP server ${host} disabled for ${agent} (egress allow-rule kept)"
    fi
  else
    echo_fail "Failed to disable MCP server (HTTP $status): $body_text"
    exit 1
  fi
}

cmd_mcp_set() {
  local agent=$1
  shift || true
  if [[ -z "$agent" ]]; then
    echo_fail "Usage: pcli mcp set <agent> --host HOST [--tool TOOL ...]"
    exit 1
  fi

  local host=""
  local -a tools=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --host) host="$2"; shift 2 ;;
      --tool) tools+=("$2"); shift 2 ;;
      *) shift ;;
    esac
  done
  if [[ -z "$host" ]]; then
    echo_fail "--host is required"
    exit 1
  fi

  local response
  response=$(api_call GET "/api/v1/mcp-policy/${agent}")
  local parsed status body_text
  parsed=$(parse_api_response "$response")
  status=$(echo "$parsed" | head -1)
  body_text=$(echo "$parsed" | tail -n +2)
  if [[ "$status" -lt 200 || "$status" -ge 300 ]]; then
    echo_fail "Failed to read MCP config (HTTP $status)"
    exit 1
  fi

  local tools_json="[]"
  if [[ ${#tools[@]} -gt 0 ]]; then
    tools_json=$(printf '%s\n' "${tools[@]}" | jq -R . | jq -s .)
  fi

  local rules
  rules=$(echo "$body_text" | jq -r '.mcp_oauth // []')
  local exists
  exists=$(echo "$rules" | jq --arg h "$host" '[.[] | select(.host == $h)] | length')
  if [[ "$exists" == "0" ]]; then
    rules=$(echo "$rules" | jq --arg h "$host" --argjson t "$tools_json" '. + [{"host": $h, "enabled": true, "allowed_tools": $t}]')
  else
    rules=$(echo "$rules" | jq --arg h "$host" --argjson t "$tools_json" '[.[] | if .host == $h then .enabled = true | .allowed_tools = $t else . end]')
  fi

  local body
  body=$(jq -nc --argjson rules "$rules" '{"mcp_oauth": $rules}')
  response=$(api_call PUT "/api/v1/mcp-policy/${agent}" "$body")
  parsed=$(parse_api_response "$response")
  status=$(echo "$parsed" | head -1)
  if [[ "$status" -ge 200 && "$status" -lt 300 ]]; then
    if [[ ${#tools[@]} -eq 0 ]]; then
      echo_pass "MCP server ${host}: all tools allowed for ${agent}"
    else
      echo_pass "MCP server ${host}: allowed tools for ${agent}: ${tools[*]}"
    fi
  else
    echo_fail "Failed to set MCP tools (HTTP $status)"
    exit 1
  fi
}

# Connect an MCP server via loopback OAuth (RFC 8252 §7.3).
# Use this for vendors that don't allowlist the portal's HTTPS redirect_uri
# (Atlassian, Datadog, ...). pcli starts a local listener on 127.0.0.1:RAND
# and registers that as the redirect_uri — almost every vendor allowlists
# loopback by default. The resulting token is stored in the same Vault path
# the portal Profile-page flow uses, so the per-agent enable/disable UI works.
cmd_mcp_connect() {
  local url=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --url) url="$2"; shift 2 ;;
      --help|-h)
        cat <<'HELP_EOF'
Usage: pcli mcp connect --url <https://server/mcp>

Connects an MCP server to your Palana profile via OAuth using a localhost
loopback redirect. Use this when the vendor's authorize endpoint doesn't
allowlist the portal's HTTPS redirect_uri.

Examples:
  pcli mcp connect --url https://mcp.atlassian.com/v1/mcp
  pcli mcp connect --url https://mcp.datadoghq.com/api/unstable/mcp-server/mcp
HELP_EOF
        exit 0 ;;
      *) echo_fail "Unknown flag: $1"; exit 1 ;;
    esac
  done

  if [[ -z "$url" ]]; then
    echo_fail "--url is required (e.g. --url https://mcp.example.com)"
    exit 1
  fi

  check_credentials

  local helper
  helper=$(mktemp -t pcli-mcp-connect.XXXXXX)
  PCLI_MCP_CONNECT_HELPER="$helper"
  trap 'rm -f "$PCLI_MCP_CONNECT_HELPER"' EXIT

  cat > "$helper" <<'PYEOF'
import sys, json, urllib.parse, urllib.request, urllib.error
import http.server, threading, secrets, hashlib, base64, webbrowser, socket
from datetime import datetime, timedelta, timezone

def log(msg): print(msg, file=sys.stderr, flush=True)

# Browser-like User-Agent: Cloudflare-fronted vendors (e.g. Atlassian) block
# Python's default UA at the well-known and registration endpoints with HTTP 403.
UA = "Mozilla/5.0 (compatible; pcli/1.0)"

def fetch_json(url, timeout=10):
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            if r.status != 200: return None
            return json.loads(r.read())
    except (urllib.error.HTTPError, urllib.error.URLError, json.JSONDecodeError, OSError):
        return None

def well_known_urls(server_url, suffix):
    u = urllib.parse.urlparse(server_url)
    origin = f"{u.scheme}://{u.netloc}"
    path = u.path.rstrip('/')
    urls = [f"{origin}/.well-known/{suffix}{path}"]
    if path:
        urls.append(f"{origin}/.well-known/{suffix}")
    return urls

def discover(server_url):
    for url in well_known_urls(server_url, "oauth-protected-resource"):
        pr = fetch_json(url)
        if not pr: continue
        as_url = pr.get("authorization_server") or (pr.get("authorization_servers") or [None])[0]
        if as_url:
            md = fetch_json(as_url)
            if md and md.get("authorization_endpoint") and md.get("token_endpoint"):
                return md
    for suffix in ("oauth-authorization-server", "openid-configuration"):
        for url in well_known_urls(server_url, suffix):
            md = fetch_json(url)
            if md and md.get("authorization_endpoint") and md.get("token_endpoint"):
                return md
    return None

def register(register_endpoint, redirect_uri):
    body = json.dumps({
        "client_name": "pcli (Palana CLI)",
        "redirect_uris": [redirect_uri],
        "grant_types": ["authorization_code", "refresh_token"],
        "response_types": ["code"],
        "token_endpoint_auth_method": "none",
    }).encode()
    req = urllib.request.Request(register_endpoint, data=body, method="POST",
                                  headers={"Content-Type": "application/json", "User-Agent": UA})
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            data = json.loads(r.read())
            return data.get("client_id")
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", "replace")[:300]
        log(f"  WARN: dynamic client registration HTTP {e.code} at {register_endpoint}: {body}")
        return None
    except Exception as e:
        log(f"  WARN: dynamic client registration failed at {register_endpoint}: {e}")
        return None

def pick_free_port():
    s = socket.socket()
    s.bind(("127.0.0.1", 0))
    p = s.getsockname()[1]
    s.close()
    return p

def pkce_pair():
    verifier = secrets.token_urlsafe(48)[:64]
    digest = hashlib.sha256(verifier.encode()).digest()
    challenge = base64.urlsafe_b64encode(digest).rstrip(b"=").decode()
    return verifier, challenge

def wait_for_callback(port, timeout=180):
    result = {}
    class H(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            p = urllib.parse.urlparse(self.path)
            if p.path != "/callback":
                self.send_error(404); return
            qs = urllib.parse.parse_qs(p.query)
            self.send_response(200)
            self.send_header("Content-Type", "text/html"); self.end_headers()
            self.wfile.write(b"<h1>Authorization received</h1><p>You can close this tab and return to the terminal.</p>")
            result["code"] = qs.get("code", [None])[0]
            result["state"] = qs.get("state", [None])[0]
            result["error"] = qs.get("error", [None])[0]
            result["error_description"] = qs.get("error_description", [None])[0]
        def log_message(self, *a): pass
    srv = http.server.HTTPServer(("127.0.0.1", port), H)
    timer = threading.Timer(timeout, srv.shutdown)
    timer.daemon = True; timer.start()
    srv.handle_request()
    timer.cancel()
    return result

def exchange_code(token_endpoint, code, verifier, client_id, redirect_uri, server_url):
    form = urllib.parse.urlencode({
        "grant_type": "authorization_code",
        "code": code,
        "redirect_uri": redirect_uri,
        "code_verifier": verifier,
        "client_id": client_id,
        "resource": server_url,
    }).encode()
    req = urllib.request.Request(token_endpoint, data=form, method="POST",
                                  headers={"Content-Type": "application/x-www-form-urlencoded"})
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            return json.loads(r.read())
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", "replace")
        log(f"ERROR: token exchange HTTP {e.code}: {body[:500]}")
        sys.exit(1)
    except Exception as e:
        log(f"ERROR: token exchange failed: {e}")
        sys.exit(1)

def parse_mcp_response(raw_bytes, content_type):
    """MCP Streamable HTTP transport returns either application/json (single
    JSON object) or text/event-stream (one or more 'data: <json>\\n\\n' SSE
    events). Return the first JSON-RPC response object."""
    text = raw_bytes.decode("utf-8", "replace")
    if "event-stream" in (content_type or ""):
        for line in text.splitlines():
            if line.startswith("data: "):
                try:
                    return json.loads(line[6:])
                except json.JSONDecodeError:
                    continue
        return None
    try:
        return json.loads(text)
    except json.JSONDecodeError:
        return None

def mcp_call(server_url, access_token, body, session_id=None, expect_response=True):
    """POST a JSON-RPC body to the MCP server. Returns (parsed_response_or_None, session_id_from_headers)."""
    req = urllib.request.Request(server_url, data=json.dumps(body).encode(), method="POST", headers={
        "Authorization": f"Bearer {access_token}",
        "Content-Type": "application/json",
        "Accept": "application/json, text/event-stream",
        "User-Agent": UA,
        **({"Mcp-Session-Id": session_id} if session_id else {}),
    })
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            sid = r.headers.get("Mcp-Session-Id") or session_id
            if not expect_response or r.status == 202:
                r.read()
                return None, sid
            ct = r.headers.get("Content-Type", "")
            return parse_mcp_response(r.read(), ct), sid
    except urllib.error.HTTPError as e:
        body_text = e.read().decode("utf-8", "replace")[:300]
        log(f"  WARN: MCP {body.get('method')} HTTP {e.code}: {body_text}")
        return None, session_id
    except Exception as e:
        log(f"  WARN: MCP {body.get('method')} failed: {e}")
        return None, session_id

def discover_tools(server_url, access_token):
    """Per MCP Streamable HTTP transport: initialize → notifications/initialized
    → tools/list. Some servers (Glean) skip the session and accept tools/list
    directly; some (Datadog) reject anything without a session."""
    init_resp, sid = mcp_call(server_url, access_token, {
        "jsonrpc": "2.0", "id": 1, "method": "initialize",
        "params": {
            "protocolVersion": "2025-03-26",
            "capabilities": {},
            "clientInfo": {"name": "pcli", "version": "1.0"},
        },
    })
    if init_resp is None or "error" in init_resp:
        log(f"  WARN: initialize failed; trying tools/list without session")
    else:
        # Notify; servers that issued a session expect this. 202 expected.
        mcp_call(server_url, access_token, {
            "jsonrpc": "2.0", "method": "notifications/initialized",
        }, session_id=sid, expect_response=False)

    tools_resp, _ = mcp_call(server_url, access_token, {
        "jsonrpc": "2.0", "id": 2, "method": "tools/list",
    }, session_id=sid)
    if tools_resp is None:
        return []
    if "error" in tools_resp:
        log(f"  WARN: tools/list returned error: {tools_resp['error']}")
        return []
    return [t["name"] for t in tools_resp.get("result", {}).get("tools", []) if t.get("name")]

def main():
    if len(sys.argv) != 2:
        log("ERROR: usage: pcli-mcp-connect.py <server_url>")
        sys.exit(2)
    server_url = sys.argv[1].rstrip("/")
    if not server_url.startswith("https://"):
        log("ERROR: server URL must start with https://")
        sys.exit(2)

    log(f"  Discovering OAuth endpoints for {server_url}...")
    md = discover(server_url)
    if not md:
        log("ERROR: discovery failed (no OAuth metadata found at any well-known URL)")
        sys.exit(1)
    auth_ep = md["authorization_endpoint"]
    token_ep = md["token_endpoint"]
    reg_ep = md.get("registration_endpoint")
    log(f"  authorize: {auth_ep}")
    log(f"  token:     {token_ep}")

    port = pick_free_port()
    redirect_uri = f"http://127.0.0.1:{port}/callback"

    client_id = None
    if reg_ep:
        log(f"  Registering OAuth client at {reg_ep} (redirect_uri={redirect_uri})...")
        client_id = register(reg_ep, redirect_uri)
        if client_id:
            log(f"  client_id: {client_id}")
    if not client_id:
        log("ERROR: dynamic client registration failed and there is no fallback client_id.")
        log("       Some vendors require a pre-registered OAuth client; ask the platform team.")
        sys.exit(1)

    verifier, challenge = pkce_pair()
    state = secrets.token_urlsafe(16)
    # Pick scope from what the AS advertises. Datadog declares `scopes_supported: []`
    # and rejects any scope param; Glean enumerates many; Atlassian doesn't list any.
    # Strategy: ask for our preferred scopes that the AS supports; if it doesn't
    # advertise any, omit the scope param entirely.
    preferred = ["openid", "offline_access", "mcp"]
    supported = md.get("scopes_supported") or []
    chosen = [s for s in preferred if s in supported] if supported else []
    params = {
        "client_id": client_id,
        "redirect_uri": redirect_uri,
        "response_type": "code",
        "state": state,
        "code_challenge": challenge,
        "code_challenge_method": "S256",
        "resource": server_url,
    }
    if chosen:
        params["scope"] = " ".join(chosen)
    log(f"  scope: {' '.join(chosen) if chosen else '(none — server advertises no scopes)'}")
    auth_url = auth_ep + "?" + urllib.parse.urlencode(params)

    log(f"  Opening browser to {auth_ep}...")
    log(f"  Listening on {redirect_uri} (3 min timeout)")
    webbrowser.open(auth_url)

    cb = wait_for_callback(port, timeout=180)
    if cb.get("error"):
        msg = cb["error"]
        if cb.get("error_description"):
            msg += ": " + cb["error_description"]
        log(f"ERROR: authorization denied: {msg}")
        sys.exit(1)
    if not cb.get("code"):
        log("ERROR: no authorization code received (timeout?)")
        sys.exit(1)
    if cb.get("state") != state:
        log(f"ERROR: state mismatch (expected {state}, got {cb.get('state')})")
        sys.exit(1)

    log("  Exchanging code for token...")
    tr = exchange_code(token_ep, cb["code"], verifier, client_id, redirect_uri, server_url)
    if not tr.get("access_token"):
        log(f"ERROR: token endpoint returned no access_token: {tr}")
        sys.exit(1)

    log("  Discovering tools via tools/list...")
    tools = discover_tools(server_url, tr["access_token"])
    log(f"  found {len(tools)} tools")

    host = urllib.parse.urlparse(server_url).hostname
    payload = {
        "host": host,
        "server_url": server_url,
        "authorization_endpoint": auth_ep,
        "token_endpoint": token_ep,
        "client_id": client_id,
        "access_token": tr["access_token"],
        "tools": tools,
    }
    if tr.get("refresh_token"):
        payload["refresh_token"] = tr["refresh_token"]
    if tr.get("expires_in"):
        try:
            secs = int(tr["expires_in"])
            payload["expires_at"] = (datetime.now(timezone.utc) + timedelta(seconds=secs)).strftime("%Y-%m-%dT%H:%M:%SZ")
        except Exception:
            pass
    print(json.dumps(payload))

if __name__ == "__main__":
    main()
PYEOF

  echo_step "Connecting MCP server: $url"
  local payload
  payload=$(python3 "$helper" "$url")
  local rc=$?
  if [[ $rc -ne 0 || -z "$payload" ]]; then
    echo_fail "OAuth flow failed (see messages above)"
    exit 1
  fi

  echo_step "Saving connection to your Palana profile..."
  local response
  response=$(api_call POST "/api/v1/secrets/profile-mcp/servers" "$payload")
  local parsed status body_text
  parsed=$(parse_api_response "$response")
  status=$(echo "$parsed" | head -1)
  body_text=$(echo "$parsed" | tail -n +2)
  if [[ "$status" -ge 200 && "$status" -lt 300 ]]; then
    local host tool_count
    host=$(echo "$payload" | python3 -c "import sys,json; print(json.load(sys.stdin)['host'])")
    tool_count=$(echo "$payload" | python3 -c "import sys,json; print(len(json.load(sys.stdin).get('tools',[])))")
    if [[ "$tool_count" == "1" ]]; then
      echo_pass "MCP server connected: ${host} (1 tool)"
    else
      echo_pass "MCP server connected: ${host} (${tool_count} tools)"
    fi
    echo "  Use 'pcli mcp enable <agent> --host ${host}' to enable it for an agent."
  else
    echo_fail "Failed to save connection (HTTP $status)"
    [[ -n "$body_text" ]] && echo "  Response: $body_text"
    exit 1
  fi
}

cmd_config() {
  if contains_help "$@"; then
    cat << 'EOF'
Usage: pcli config <agent> [--cpu <value>] [--memory <value>] [--idle-shutdown on|off] [--grab-internal-access on|off]

Show or set per-agent resource overrides, idle-shutdown policy, and Grab
internal network access.

  pcli config <agent>
    Show effective CPU, memory, idle-shutdown, and Grab internal access.

  pcli config <agent> --cpu 2000m --memory 4Gi
    Set CPU and/or memory. Either flag may be passed alone.

  pcli config <agent> --cpu 0
    Clear the CPU override (fall back to manifest default). Setting --memory 0
    does the same for memory.

  pcli config <agent> --idle-shutdown off
    Exempt this agent from the 7-day idle-shutdown policy. Use for headless
    monitors and batch agents that run quietly by design.

  pcli config <agent> --idle-shutdown on
    Re-enable idle shutdown (the default for all agents).

  pcli config <agent> --grab-internal-access off
    Block this agent from reaching 10.0.0.0/8 on :22/:80/:443. Use for
    untrusted/sandboxed agents that should be limited to public-internet
    egress only.

  pcli config <agent> --grab-internal-access on
    Re-enable Grab internal network access (the default for all agents).
    This is the rule that lets agents reach internal Grab services (wikis,
    JIRA, internal git) reachable from the cluster VPC via TGW.

Bounds: CPU 100m–8000m, memory 128Mi–8192Mi.
CPU/memory changes update the UserAgent CR; the operator reconciles the live
Deployment, which triggers a rolling restart of the running pod.
Idle-shutdown changes take effect at the next reaper run (daily at 02:00 UTC).
Grab-internal-access changes take effect within seconds (NetworkPolicy reload).
EOF
    exit 0
  fi

  check_credentials

  local name=$1
  shift || true

  if [[ -z "$name" ]]; then
    echo_fail "Usage: pcli config <agent> [--cpu <value>] [--memory <value>] [--idle-shutdown on|off] [--grab-internal-access on|off]"
    exit 1
  fi

  local cpu_arg="" memory_arg="" idle_arg="" grab_arg="" any_set=0
  local cpu_provided=0 memory_provided=0 idle_provided=0 grab_provided=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --cpu)
        shift
        cpu_arg="${1:-}"
        cpu_provided=1
        any_set=1
        shift || true
        ;;
      --memory|--mem)
        shift
        memory_arg="${1:-}"
        memory_provided=1
        any_set=1
        shift || true
        ;;
      --idle-shutdown)
        shift
        idle_arg="${1:-}"
        if [[ "$idle_arg" != "on" && "$idle_arg" != "off" ]]; then
          echo_fail "--idle-shutdown must be 'on' or 'off', got '${idle_arg}'"
          exit 1
        fi
        idle_provided=1
        any_set=1
        shift || true
        ;;
      --grab-internal-access|--grab-internal)
        shift
        grab_arg="${1:-}"
        if [[ "$grab_arg" != "on" && "$grab_arg" != "off" ]]; then
          echo_fail "--grab-internal-access must be 'on' or 'off', got '${grab_arg}'"
          exit 1
        fi
        grab_provided=1
        any_set=1
        shift || true
        ;;
      *)
        echo_fail "Unknown flag: $1"
        echo_fail "Usage: pcli config <agent> [--cpu <value>] [--memory <value>] [--idle-shutdown on|off] [--grab-internal-access on|off]"
        exit 1
        ;;
    esac
  done

  if [[ $any_set -eq 0 ]]; then
    local response parsed status body_text
    response=$(api_call GET "/api/v1/agents/${name}/resources")
    parsed=$(parse_api_response "$response")
    status=$(echo "$parsed" | head -1)
    body_text=$(echo "$parsed" | tail -n +2)
    if [[ "$status" != "200" ]]; then
      local err
      err=$(echo "$body_text" | jq -r '.error // "unknown error"' 2>/dev/null || echo "$body_text")
      echo_fail "Failed to read resources: $err (HTTP $status)"
      exit 1
    fi
    local eff_cpu eff_mem cpu_src mem_src tmpl mfst_cpu mfst_mem idle_disabled grab_internal
    eff_cpu=$(echo "$body_text" | jq -r '.effective_cpu')
    eff_mem=$(echo "$body_text" | jq -r '.effective_memory')
    cpu_src=$(echo "$body_text" | jq -r '.cpu_source')
    mem_src=$(echo "$body_text" | jq -r '.memory_source')
    tmpl=$(echo "$body_text" | jq -r '.template // ""')
    mfst_cpu=$(echo "$body_text" | jq -r '.manifest_cpu // ""')
    mfst_mem=$(echo "$body_text" | jq -r '.manifest_memory // ""')
    idle_disabled=$(echo "$body_text" | jq -r '.idle_timeout_disabled')
    grab_internal=$(echo "$body_text" | jq -r '.grab_internal_access')

    echo ""
    echo "Agent: ${name}"
    if [[ -n "$tmpl" ]]; then
      echo "Template: ${tmpl}"
    fi
    if [[ "$cpu_src" == "override" ]]; then
      echo "CPU:    ${eff_cpu} (override; manifest default: ${mfst_cpu:-none})"
    else
      echo "CPU:    ${eff_cpu} (manifest default)"
    fi
    if [[ "$mem_src" == "override" ]]; then
      echo "Memory: ${eff_mem} (override; manifest default: ${mfst_mem:-none})"
    else
      echo "Memory: ${eff_mem} (manifest default)"
    fi
    if [[ "$idle_disabled" == "true" ]]; then
      echo "Idle shutdown: disabled (exempt)"
    else
      echo "Idle shutdown: enabled"
    fi
    if [[ "$grab_internal" == "false" ]]; then
      echo "Grab internal access: disabled (10.0.0.0/8 :22/:80/:443 blocked)"
    else
      echo "Grab internal access: enabled (10.0.0.0/8 :22/:80/:443 allowed)"
    fi
    echo ""
    echo "To override:        pcli config ${name} --cpu 2000m --memory 4Gi"
    echo "To clear override:  pcli config ${name} --cpu 0   (or --memory 0)"
    echo "To exempt:          pcli config ${name} --idle-shutdown off"
    echo "To restrict 10/8:   pcli config ${name} --grab-internal-access off"
    return
  fi

  local body comma
  body="{"
  comma=0
  if [[ $cpu_provided -eq 1 ]]; then
    if [[ "$cpu_arg" == "0" || -z "$cpu_arg" ]]; then
      body+='"cpu":null'
    else
      body+="\"cpu\":\"${cpu_arg}\""
    fi
    comma=1
  fi
  if [[ $memory_provided -eq 1 ]]; then
    [[ $comma -eq 1 ]] && body+=","
    if [[ "$memory_arg" == "0" || -z "$memory_arg" ]]; then
      body+='"memory":null'
    else
      body+="\"memory\":\"${memory_arg}\""
    fi
    comma=1
  fi
  if [[ $idle_provided -eq 1 ]]; then
    [[ $comma -eq 1 ]] && body+=","
    if [[ "$idle_arg" == "off" ]]; then
      body+='"idle_timeout_disabled":true'
    else
      body+='"idle_timeout_disabled":false'
    fi
    comma=1
  fi
  if [[ $grab_provided -eq 1 ]]; then
    [[ $comma -eq 1 ]] && body+=","
    if [[ "$grab_arg" == "off" ]]; then
      body+='"grab_internal_access":false'
    else
      body+='"grab_internal_access":true'
    fi
  fi
  body+="}"

  local response parsed status body_text
  response=$(api_call PATCH "/api/v1/agents/${name}/resources" "$body")
  parsed=$(parse_api_response "$response")
  status=$(echo "$parsed" | head -1)
  body_text=$(echo "$parsed" | tail -n +2)

  if [[ "$status" != "200" ]]; then
    local err
    err=$(echo "$body_text" | jq -r '.error // "unknown error"' 2>/dev/null || echo "$body_text")
    echo_fail "Failed to update resources: $err (HTTP $status)"
    exit 1
  fi

  local eff_cpu eff_mem cpu_src mem_src idle_disabled grab_internal
  eff_cpu=$(echo "$body_text" | jq -r '.effective_cpu')
  eff_mem=$(echo "$body_text" | jq -r '.effective_memory')
  cpu_src=$(echo "$body_text" | jq -r '.cpu_source')
  mem_src=$(echo "$body_text" | jq -r '.memory_source')
  idle_disabled=$(echo "$body_text" | jq -r '.idle_timeout_disabled')
  grab_internal=$(echo "$body_text" | jq -r '.grab_internal_access')
  echo_pass "Config updated for ${name}"
  echo "  CPU:    ${eff_cpu} (${cpu_src})"
  echo "  Memory: ${eff_mem} (${mem_src})"
  if [[ "$idle_disabled" == "true" ]]; then
    echo "  Idle shutdown: disabled (exempt)"
  else
    echo "  Idle shutdown: enabled"
  fi
  if [[ "$grab_internal" == "false" ]]; then
    echo "  Grab internal access: disabled (10.0.0.0/8 :22/:80/:443 blocked)"
  else
    echo "  Grab internal access: enabled (10.0.0.0/8 :22/:80/:443 allowed)"
  fi
  if [[ $cpu_provided -eq 1 || $memory_provided -eq 1 ]]; then
    echo ""
    echo "The operator will roll the live Deployment to pick up the new values."
  fi
}

normalize_deployer_arn() {
  local arn="$1"
  if [[ "$arn" =~ ^arn:aws:sts::([0-9]{12}):assumed-role/([^/]+)/.+$ ]]; then
    echo "arn:aws:iam::${BASH_REMATCH[1]}:role/${BASH_REMATCH[2]}"
  else
    echo "$arn"
  fi
}

validate_deployer_arn() {
  local arn="$1"
  if [[ ! "$arn" =~ ^arn:aws:iam::[0-9]{12}:role/.+ ]]; then
    echo_fail "invalid IAM role ARN: $arn"
    echo "Expected: arn:aws:iam::<12-digit-account-id>:role/<role-name>"
    return 1
  fi
}

deployers_api_get() {
  local agent="$1"
  local response status body
  response=$(api_call GET "/api/v1/agents/${agent}/deployers")
  status=$(echo "$response" | tail -1)
  body=$(echo "$response" | sed '$d')

  if [[ "$status" != "200" ]]; then
    echo_fail "Failed to read deployers for $agent (HTTP $status): $body" >&2
    return 1
  fi
  echo "$body"
}

deployers_api_put() {
  local agent="$1" deployers_json="$2"
  local payload response status body
  payload=$(jq -cn --argjson deployers "$deployers_json" '{allowed_deployers: $deployers}')
  response=$(api_call PUT "/api/v1/agents/${agent}/deployers" "$payload")
  status=$(echo "$response" | tail -1)
  body=$(echo "$response" | sed '$d')

  if [[ "$status" -lt 200 || "$status" -ge 300 ]] 2>/dev/null; then
    echo_fail "Failed to update deployers for $agent (HTTP $status): $body" >&2
    return 1
  fi
  echo "$body"
}

cmd_deployers() {
  local subcommand="${1:-}"
  shift || true

  if [[ -z "$subcommand" || "$subcommand" == "--help" || "$subcommand" == "-h" ]]; then
    echo "Usage:"
    echo "  pcli deployers list <agent>"
    echo "  pcli deployers add <agent> <iam-role-arn>"
    echo "  pcli deployers remove <agent> <iam-role-arn>"
    echo ""
    echo "Manage IAM roles allowed to deploy an agent from CI."
    echo "Use scripts/palana-ci-deploy.sh whoami in CI to get the normalized ARN."
    exit 0
  fi

  local agent="${1:-}"
  local raw_arn="${2:-}"

  case "$subcommand" in
    list)
      if [[ -z "$agent" ]]; then
        echo_fail "Usage: pcli deployers list <agent>"
        exit 1
      fi
      check_credentials
      local body
      body=$(deployers_api_get "$agent") || exit 1
      echo "Allowed deployers for $agent:"
      if [[ "$(echo "$body" | jq '.allowed_deployers | length')" -eq 0 ]]; then
        echo "  (none)"
      else
        echo "$body" | jq -r '.allowed_deployers[] | "  " + .'
      fi
      ;;
    add)
      if [[ -z "$agent" || -z "$raw_arn" ]]; then
        echo_fail "Usage: pcli deployers add <agent> <iam-role-arn>"
        exit 1
      fi
      check_credentials
      local arn body current updated put_body
      arn=$(normalize_deployer_arn "$raw_arn")
      validate_deployer_arn "$arn" || exit 1
      body=$(deployers_api_get "$agent") || exit 1
      current=$(echo "$body" | jq -c '.allowed_deployers // []')
      if echo "$current" | jq -e --arg arn "$arn" 'index($arn)' >/dev/null; then
        echo_pass "Deploy access already allowed for $arn"
        return 0
      fi
      updated=$(echo "$current" | jq -c --arg arn "$arn" '. + [$arn]')
      put_body=$(deployers_api_put "$agent" "$updated") || exit 1
      echo_pass "Added deploy access for $arn"
      echo "$put_body" | jq -r '.allowed_deployers[] | "  " + .' 2>/dev/null || true
      ;;
    remove|rm)
      if [[ -z "$agent" || -z "$raw_arn" ]]; then
        echo_fail "Usage: pcli deployers remove <agent> <iam-role-arn>"
        exit 1
      fi
      check_credentials
      local arn body current updated put_body
      arn=$(normalize_deployer_arn "$raw_arn")
      validate_deployer_arn "$arn" || exit 1
      body=$(deployers_api_get "$agent") || exit 1
      current=$(echo "$body" | jq -c '.allowed_deployers // []')
      if ! echo "$current" | jq -e --arg arn "$arn" 'index($arn)' >/dev/null; then
        echo_warn "Deploy access was not present for $arn"
        return 0
      fi
      updated=$(echo "$current" | jq -c --arg arn "$arn" 'map(select(. != $arn))')
      put_body=$(deployers_api_put "$agent" "$updated") || exit 1
      echo_pass "Removed deploy access for $arn"
      if [[ "$(echo "$put_body" | jq '.allowed_deployers | length' 2>/dev/null)" -gt 0 ]]; then
        echo "$put_body" | jq -r '.allowed_deployers[] | "  " + .' 2>/dev/null || true
      fi
      ;;
    *)
      echo_fail "Unknown deployers command: $subcommand"
      echo "Usage: pcli deployers list|add|remove ..."
      exit 1
      ;;
  esac
}

