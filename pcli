cmd_policy_allow() {
  local agent="${1:-}"
  local host="${2:-}"

  if [[ -z "$agent" || -z "$host" ]]; then
    echo_fail "Usage: pcli policy allow <agent> <host>"
    echo "  Adds an allow rule for the given host to the agent's proxy egress policy."
    echo "  Unlike 'policy set', this does a surgical append — existing rules are preserved."
    echo ""
    echo "Example: pcli policy allow demo api.newservice.com"
    exit 1
  fi

  check_credentials

  local response parsed status body_text
  response=$(api_call GET "/api/v1/policy/${agent}")
  parsed=$(parse_api_response "$response")
  status=$(echo "$parsed" | head -1)
  body_text=$(echo "$parsed" | tail -n +2)

  if [[ "$status" -lt 200 || "$status" -ge 300 ]]; then
    echo_fail "Failed to fetch current policy (HTTP $status): $body_text"
    exit 1
  fi

  local rules
  rules=$(echo "$body_text" | jq -c '.proxy_egress // .network // []')

  local new_rule
  new_rule=$(jq -nc --arg h "$host" '{action:"allow",host:$h}')

  local deny_all_idx
  deny_all_idx=$(echo "$rules" | jq 'map(select(.action=="deny" and .host=="*")) | length')

  if [[ "$deny_all_idx" -gt 0 ]]; then
    rules=$(echo "$rules" | jq --argjson nr "$new_rule" '
      (map(select(.action=="deny" and .host=="*")) | length) as $cnt |
      if $cnt > 0 then
        [.[] | select(.action!="deny" or .host!="*")] + [$nr] + [.[] | select(.action=="deny" and .host=="*")]
      else
        . + [$nr]
      end
    ')
  else
    rules=$(echo "$rules" | jq --argjson nr "$new_rule" '. + [$nr]')
  fi

  local body
  body=$(jq -nc --argjson net "$rules" '{network: $net}')

  response=$(api_call PUT "/api/v1/policy/${agent}" "$body")
  parsed=$(parse_api_response "$response")
  status=$(echo "$parsed" | head -1)
  body_text=$(echo "$parsed" | tail -n +2)

  if [[ "$status" -ge 200 && "$status" -lt 300 ]]; then
    echo_pass "Added allow rule for '${host}' to ${agent}'s proxy egress policy"
  else
    echo_fail "Failed to update policy (HTTP $status): $body_text"
    exit 1
  fi
}

cmd_policy_allow_network() {
  local agent="${1:-}"
  local dest="${2:-}"
  local port="${3:-}"
  local protocol="${4:-tcp}"

  if [[ -z "$agent" || -z "$dest" || -z "$port" ]]; then
    echo_fail "Usage: pcli policy allow-network <agent> <destination> <port> [protocol]"
    echo "  Adds an L3/4 allow rule to the agent's network egress policy."
    echo "  Protocol defaults to tcp."
    echo ""
    echo "Example: pcli policy allow-network demo 10.50.2.100 5432"
    exit 1
  fi

  check_credentials

  local user
  user=$(get_effective_user_id)
  local sanitized
  sanitized=$(sanitize_user_id "$user")

  local response parsed status body_text
  response=$(obs_api_call GET "/api/v1/agents/${sanitized}/${agent}/policy/network-egress")
  parsed=$(parse_api_response "$response")
  status=$(echo "$parsed" | head -1)
  body_text=$(echo "$parsed" | tail -n +2)

  if [[ "$status" -lt 200 || "$status" -ge 300 ]]; then
    echo_fail "Failed to fetch current network egress (HTTP $status): $body_text"
    exit 1
  fi

  local rules cilium_enforced
  rules=$(echo "$body_text" | jq -c '.network_egress // []')
  cilium_enforced=$(echo "$body_text" | jq '.cilium_enforced // true')

  local new_rule
  new_rule=$(jq -nc --arg d "$dest" --argjson p "$port" --arg pr "$protocol" '{action:"allow",protocol:$pr,port:$p,destination:$d}')
  rules=$(echo "$rules" | jq --argjson nr "$new_rule" '. + [$nr]')

  local body
  body=$(jq -nc --argjson ne "$rules" --argjson ce "$cilium_enforced" '{network_egress:$ne,cilium_enforced:$ce}')

  response=$(obs_api_call PUT "/api/v1/agents/${sanitized}/${agent}/policy/network-egress" "$body")
  parsed=$(parse_api_response "$response")
  status=$(echo "$parsed" | head -1)
  body_text=$(echo "$parsed" | tail -n +2)

  if [[ "$status" -ge 200 && "$status" -lt 300 ]]; then
    echo_pass "Added network allow rule: ${dest}:${port}/${protocol} for ${agent}"
  else
    echo_fail "Failed to update network egress (HTTP $status): $body_text"
    exit 1
  fi
}

