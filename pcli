# Run container
cmd_run() {
  if contains_help "$@"; then
    show_run_usage
    exit 0
  fi

  check_credentials
  check_manifest_staleness

  local agent=$1
  shift || true

  if [[ -z "$agent" ]]; then
    echo_fail "Missing required arguments"
    show_run_usage
    exit 1
  fi

  # Check if next arg is --manifest (no positional image) or a positional image
  local image=""
  local manifest_name=""
  local custom_image=0
  if [[ "${1:-}" == "--manifest" ]]; then
    : # image will be set from manifest below
  elif [[ -n "${1:-}" && "${1:0:2}" != "--" ]]; then
    image="$1"
    custom_image=1
    shift
  fi

  local web_port=""
  local -a port_specs=()
  local cpu="100m"
  local cpu_explicit=0
  local memory="512Mi"
  local memory_explicit=0
  local pod_name=""
  local restart_policy="Always"
  local user_specified_ports=0
  local replace=1
  local mount_path="/data"
  local subpath=""
  local mount_ro=0
  local no_storage=0
  local run_as_user=""
  local run_as_group=""
  local fs_group=""
  local no_secrets=0
  local -a secret_flags=()
  local manifest_image_override=""
  local container_command=""
  local restore_file=""
  local dry_run_deploy=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --manifest)
        manifest_name="$2"
        shift 2
        ;;
      --image)
        manifest_image_override="$2"
        custom_image=1
        shift 2
        ;;
      --secret)
        secret_flags+=("$2")
        shift 2
        ;;
      --no-secrets)
        no_secrets=1
        shift
        ;;
      --web-port)
        web_port="$2"
        shift 2
        ;;
      --port)
        port_specs+=("$2")
        user_specified_ports=1
        shift 2
        ;;
      --cpu)
        validate_cpu_quantity "${2}m" || exit 1
        cpu="${2}m"
        cpu_explicit=1
        shift 2
        ;;
      --memory)
        # Accept memory in format: 512, 512M, 512Mi, or 512MB
        memory_input="${2}"
        if [[ "$memory_input" =~ ^[0-9]+$ ]]; then
          memory="$((memory_input))Mi"
        elif [[ "$memory_input" =~ Mi$ ]] || [[ "$memory_input" =~ MB$ ]] || [[ "$memory_input" =~ M$ ]]; then
          memory="$memory_input"
        else
          memory="${memory_input}Mi"
        fi
        validate_memory_quantity "$memory" || exit 1
        memory_explicit=1
        shift 2
        ;;
      --dry-run-deploy)
        dry_run_deploy=1
        shift
        ;;
      --name)
        pod_name="$2"
        shift 2
        ;;
      --restart)
        restart_policy="$2"
        shift 2
        ;;
      --replace)
        # Accepted for backwards compatibility (replace is now the default)
        shift
        ;;
      --alongside)
        replace=0
        shift
        ;;
      --mount-path)
        mount_path="$2"
        shift 2
        ;;
      --subpath)
        subpath="$2"
        shift 2
        ;;
      --mount-ro)
        mount_ro=1
        shift
        ;;
      --no-storage)
        no_storage=1
        shift
        ;;
      --restore)
        restore_file="$2"
        shift 2
        ;;
      --run-as-user)
        run_as_user="$2"
        shift 2
        ;;
      --run-as-group)
        run_as_group="$2"
        shift 2
        ;;
      --fs-group)
        fs_group="$2"
        shift 2
        ;;
      --command)
        container_command="$2"
        shift 2
        ;;
      *)
        echo_fail "Unknown option: $1"
        exit 1
        ;;
    esac
  done

  # Auto-resolve manifest from agent name if no image and no --manifest.
  # Priority: local dirs first (resolve_manifest), then the server's
  # user-templates registry. A successful server fetch caches the manifest
  # under $HOME_USER_MANIFESTS_DIR so subsequent runs skip the round-trip.
  if [[ -z "$image" && -z "$manifest_name" ]]; then
    if [[ -n "$(resolve_manifest "$agent")" ]]; then
      manifest_name="$agent"
      echo_step "Auto-resolved manifest: $manifest_name"
    elif cache_remote_user_template "$agent" 2>/dev/null; then
      manifest_name="$agent"
      echo_step "Fetched user template from server: $manifest_name (cached to $HOME_USER_MANIFESTS_DIR)"
    fi
  fi

  # If still no manifest AND no positional image AND no --manifest, we have
  # nothing to deploy. Don't silently fall through to the bare-system-image
  # rule below — that's the failure shape that produced ImagePullBackOff for
  # agents whose template wasn't in any of the four local dirs AND wasn't
  # registered server-side. Error clearly with the four ways out.
  if [[ -z "$image" && -z "$manifest_name" ]]; then
    echo_fail "No manifest found for '$agent' (checked local + server)."
    echo ""
    echo "  Pick one:"
    echo "    pcli run $agent <image>                    # specify image explicitly"
    echo "    pcli run $agent user/<image>               # use your personal ECR repo"
    echo "    pcli templates register <manifest.yaml>    # register a manifest first"
    echo "    pcli templates pull                        # if registered elsewhere, pull it here"
    exit 1
  fi

  # Apply manifest defaults (explicit flags above take precedence)
  if [[ -n "$manifest_name" ]]; then
    local manifest_file
    manifest_file=$(resolve_manifest "$manifest_name")
    if [[ -z "$manifest_file" ]]; then
      # Try server-fetch fallback before giving up. Same path as the
      # auto-resolve block above, but for the explicit --manifest case.
      if cache_remote_user_template "$manifest_name" 2>/dev/null; then
        echo_step "Fetched user template from server: $manifest_name (cached to $HOME_USER_MANIFESTS_DIR)"
        manifest_file=$(resolve_manifest "$manifest_name")
      fi
    fi
    if [[ -z "$manifest_file" ]]; then
      echo_fail "Manifest not found: $manifest_name (checked local + server)"
      echo "  Search paths: $MANIFESTS_DIR, $USER_MANIFESTS_DIR, $HOME_USER_MANIFESTS_DIR, $HOME_MANIFESTS_DIR"
      echo "  Register one: pcli templates register <file.yaml>"
      exit 1
    fi
    echo_step "Loading manifest: $manifest_name"

    # Image: --image flag > positional image > manifest
    if [[ -n "$manifest_image_override" ]]; then
      image="$manifest_image_override"
    elif [[ -z "$image" ]]; then
      image=$(manifest_field "$manifest_name" "container.image")
    fi

    # Web port: only set from manifest if not explicitly provided
    if [[ -z "$web_port" ]]; then
      local m_web_enabled=$(manifest_field "$manifest_name" "web.enabled")
      if [[ "$m_web_enabled" == "true" ]]; then
        web_port=$(manifest_field "$manifest_name" "web.port")
      fi
    fi

    # CPU/Memory: override defaults only if user didn't pass explicit flags
    # We detect "user didn't pass" by checking if values are still the defaults
    if [[ "$cpu" == "100m" ]]; then
      local m_cpu=$(manifest_field "$manifest_name" "resources.cpu")
      [[ -n "$m_cpu" ]] && cpu="$m_cpu"
    fi
    if [[ "$memory" == "512Mi" ]]; then
      local m_memory=$(manifest_field "$manifest_name" "resources.memory")
      [[ -n "$m_memory" ]] && memory="$m_memory"
    fi
  fi

  if [[ -z "$image" ]]; then
    echo_fail "Missing image. Provide as argument, use --manifest, or create build/manifests/${agent}.yaml"
    show_run_usage
    exit 1
  fi

  local user=$(get_effective_user_id)
  local namespace
  namespace=$(get_agent_namespace "$agent")

  if ! check_namespace_exists "$namespace"; then
    echo_fail "Namespace not found: $namespace"
    echo "Did you create the agent? Try: pcli create $agent"
    exit 1
  fi

  if [[ -n "$restore_file" ]]; then
    restore_file="${restore_file/#\~/$HOME}"
    case "$restore_file" in
      *.tar.gz) ;;
      *) echo_fail "--restore requires a .tar.gz file"; exit 1 ;;
    esac
    if [[ ! -f "$restore_file" ]]; then
      echo_fail "Restore file not found: $restore_file"
      exit 1
    fi
    if [[ ! -r "$restore_file" ]]; then
      echo_fail "Restore file is not readable: $restore_file"
      exit 1
    fi
    if [[ $no_storage -eq 1 ]]; then
      echo_fail "--restore requires persistent storage; remove --no-storage"
      exit 1
    fi
    if [[ "$mount_path" != "/data" ]]; then
      echo_fail "--restore extracts into /data; remove --mount-path or set it to /data"
      exit 1
    fi
    if [[ -n "$subpath" ]]; then
      echo_fail "--restore does not support --subpath yet; restore targets the full agent-storage PVC"
      exit 1
    fi
    if [[ $mount_ro -eq 1 ]]; then
      echo_fail "--restore requires writable storage; remove --mount-ro"
      exit 1
    fi
    if [[ $replace -eq 0 ]]; then
      echo_fail "--restore requires replacing the workload; remove --alongside"
      exit 1
    fi
  fi

  # Handle secrets from manifest
  if [[ -n "$manifest_name" && "$no_secrets" -eq 0 ]]; then
    local user=$(get_effective_user_id)
    user=$(sanitize_user_id "$user")

    # Process each required secret from manifest
    local required_keys
    required_keys=$(manifest_required_secrets "$manifest_name")
    while IFS= read -r skey; do
      [[ -z "$skey" ]] && continue
      local stype
      stype=$(manifest_secret_type "$manifest_name" "$skey")

      # Skip if already provided via --secret flag (search secret_flags directly,
      # avoiding bash 4-only associative arrays)
      local pval=""
      for sf in "${secret_flags[@]}"; do
        if [[ "${sf%%=*}" == "$skey" ]]; then
          pval="${sf#*=}"
          if [[ "$pval" == @* ]]; then
            local spath="${pval:1}"
            spath="${spath/#\~/$HOME}"
            if [[ ! -f "$spath" ]]; then
              echo_fail "Secret file not found: $spath"
              exit 1
            fi
            pval="$(cat "$spath")"
          fi
          break
        fi
      done

      if [[ -n "$pval" ]]; then
        echo_step "Setting secret: $skey"
        if [[ "$stype" == "gitlab-pat" ]]; then
          cmd_secrets_gitlab_pat "$agent" "$pval"
        elif [[ "$stype" == "gitlab-ssh" ]]; then
          cmd_secrets_gitlab_ssh "$agent" "$pval"
        elif [[ "$stype" == "agent" ]]; then
          cmd_secrets_add "$agent" "$skey" "value=$pval"
        else
          cmd_secrets_add "$agent" "$skey" "token=$pval"
        fi
        continue
      fi

      # Check if secret already exists via proxy-secrets-service
      if secret_exists_in_api "$agent" "$skey"; then
        echo_pass "Secret $skey already exists"
        continue
      fi

      # Prompt interactively
      local display_name="$skey"
      if command -v yq &>/dev/null; then
        display_name=$(yq -r ".secrets[] | select(.key == \"$skey\") | .display_name" "$(resolve_manifest "$manifest_name")" 2>/dev/null)
      fi
      echo ""
      echo "  Required secret: $display_name ($skey)"
      if [[ "$stype" == "gitlab-ssh" ]]; then
        echo -n "  Enter path to SSH private key (or blank to skip): "
        read -r user_input </dev/tty
        if [[ -n "$user_input" ]]; then
          user_input="${user_input/#\~/$HOME}"
          cmd_secrets_gitlab_ssh "$agent" "$user_input"
        else
          echo "  Skipped $skey"
        fi
      else
        echo -n "  Enter value (or blank to skip): "
        read -r user_input </dev/tty
        if [[ -n "$user_input" ]]; then
          if [[ "$stype" == "gitlab-pat" ]]; then
            cmd_secrets_gitlab_pat "$agent" "$user_input"
          elif [[ "$stype" == "agent" ]]; then
            cmd_secrets_add "$agent" "$skey" "value=$user_input"
          else
            cmd_secrets_add "$agent" "$skey" "token=$user_input"
          fi
        else
          echo "  Skipped $skey"
        fi
      fi
    done <<< "$required_keys"
  elif [[ ${#secret_flags[@]} -gt 0 && -z "$manifest_name" ]]; then
    echo_fail "--secret requires --manifest"
    exit 1
  fi

  check_credentials

  # --- Image resolution rules ---
  # Bare name (e.g. "openclaw:latest"): system image → {IMAGE_REGISTRY}/openclaw:latest
  # Pathed name (e.g. "user/openclaw"): user image → {IMAGE_REGISTRY}/user/{current_user}/openclaw:latest
  # Already-qualified (contains .amazonaws.com/): pass through unchanged
  # No fallbacks — a bare name is always system-level, a "user/" prefix always
  # expands under the current user's ECR namespace.

  # Handle user/ prefix: resolve to user's ECR image without local Docker lookup
  if [[ "$image" == user/* ]]; then
    local user_image_name="${image#user/}"
    local user_image_tag="latest"
    [[ "$user_image_name" == *":"* ]] && user_image_tag="${user_image_name##*:}" && user_image_name="${user_image_name%%:*}"
    echo_step "Resolving user image: $user_image_name:$user_image_tag"
    local ecr_response
    ecr_response=$(api_call POST "/api/v1/ecr/credentials" "{\"image_name\": \"$user_image_name\"}")
    local ecr_status ecr_body
    ecr_status=$(echo "$ecr_response" | tail -1)
    ecr_body=$(echo "$ecr_response" | sed '$d')
    if [[ "$ecr_status" != "200" ]]; then
      echo_fail "Failed to resolve user image: $(echo "$ecr_body" | jq -r '.error // "unknown"' 2>/dev/null)"
      exit 1
    fi
    local ecr_registry ecr_repository
    ecr_registry=$(echo "$ecr_body" | jq -r '.registry')
    ecr_repository=$(echo "$ecr_body" | jq -r '.repository')
    image="${ecr_registry}/${ecr_repository}:${user_image_tag}"
    echo_pass "Using user image: $image"
  fi

  # Resolve bare system image names to root ECR (no API call needed)
  if [[ ! "$image" =~ ^[0-9]+\.dkr\.ecr\. ]]; then
    local sys_tag="latest"
    local sys_name="$image"
    [[ "$sys_name" == *":"* ]] && sys_tag="${sys_name##*:}" && sys_name="${sys_name%%:*}"
    sys_name=$(echo "$sys_name" | tr '[:upper:]' '[:lower:]' | tr '_.' '-')

    local sys_registry="448623754506.dkr.ecr.ap-southeast-1.amazonaws.com"
    echo_step "Resolving system image: $sys_name:$sys_tag"
    image="${sys_registry}/${sys_name}:${sys_tag}"
    echo_pass "Using system image: $image"
  fi

  if [[ -z "$pod_name" ]]; then
    pod_name="${agent}-pod"
  fi

  local ports=""
  local -a all_remote_ports=()

  if [[ $user_specified_ports -eq 0 ]]; then
    # Use web_port from manifest/flags if available, otherwise try docker inspect for local images
    if [[ -n "$web_port" ]]; then
      ports="$web_port"
      echo_pass "Using port from manifest: $web_port"
    elif [[ ! "$image" =~ ^[0-9]+\.dkr\.ecr\. ]]; then
      echo_step "Inspecting local image for exposed ports..."
      local exposed_ports=$(docker inspect "$image" 2>/dev/null | jq -r '.[0].Config.ExposedPorts | keys[]' 2>/dev/null | sed 's|/tcp||g' | sort -n)
      if [[ -n "$exposed_ports" ]]; then
        ports=$(echo "$exposed_ports" | tr '\n' ':' | sed 's/:$//')
        echo_pass "Found exposed ports: $(echo $exposed_ports | tr '\n' ' ')"
      else
        echo_warn "No exposed ports found in image"
      fi
    fi
  else
    for spec in "${port_specs[@]}"; do
      if [[ -z "$spec" ]]; then
        continue
      fi
      local remote_port=$(echo "$spec" | cut -d':' -f1)
      all_remote_ports+=("$remote_port")
    done
    ports=$(IFS=':'; echo "${all_remote_ports[*]}")
  fi

  # Default fsGroup to 1000 (matches storageGID in deploy.go) when storage is enabled
  # and no explicit --fs-group was passed. Ensures PVC is pre-chowned by Kubernetes
  # before container start, so non-root containers can always write to /data.
  if [[ $no_storage -eq 0 && -z "$fs_group" ]]; then
    fs_group="1000"
  fi

  echo_step "Deploying container to agent-$(sanitize_user_id "$user")-${agent}"
  echo "  Image:    $image"
  if [[ -n "$ports" ]]; then
    echo "  Ports:    $ports"
  else
    echo "  Ports:    (none)"
  fi
  echo "  CPU:      $cpu"
  echo "  Memory:   $memory"
  echo "  Pod:      $pod_name"
  if [[ $no_storage -eq 0 ]]; then
    local storage_info="$mount_path"
    [[ -n "$subpath" ]] && storage_info="$storage_info (subpath: $subpath)"
    [[ $mount_ro -eq 1 ]] && storage_info="$storage_info [ro]"
    echo "  Storage:  $storage_info"
  else
    echo "  Storage:  (none - stateless)"
  fi
  if [[ -n "$run_as_user" || -n "$run_as_group" || -n "$fs_group" ]]; then
    local security_info=""
    [[ -n "$run_as_user" ]] && security_info="user=$run_as_user"
    [[ -n "$run_as_group" ]] && security_info="$security_info${security_info:+,}group=$run_as_group"
    [[ -n "$fs_group" ]] && security_info="$security_info${security_info:+,}fsGroup=$fs_group"
    echo "  Security: $security_info"
  fi
  if [[ -n "$restore_file" ]]; then
    echo "  Restore:  $restore_file"
  fi

  local port_spec=""
  if [[ -n "$ports" ]]; then
    port_spec="
        ports:"
    for port in $(echo "$ports" | tr ':' '\n'); do
      if ! [[ "$port" =~ ^[0-9]+$ ]] || [[ "$port" -lt 1 || "$port" -gt 65535 ]]; then
        echo_fail "Invalid port: $port (must be 1-65535)"
        exit 1
      fi
      port_spec="$port_spec
        - containerPort: $port"
    done
  fi

  local service_ports=""
  # Collect all unique ports: from --port flags / auto-detect, plus --web-port
  local -a svc_port_list=()
  if [[ -n "$ports" ]]; then
    for port in $(echo "$ports" | tr ':' '\n'); do
      svc_port_list+=("$port")
    done
  fi
  if [[ -n "$web_port" ]]; then
    local wp_already=0
    for p in "${svc_port_list[@]}"; do
      [[ "$p" == "$web_port" ]] && wp_already=1
    done
    [[ $wp_already -eq 0 ]] && svc_port_list+=("$web_port")
  fi
  if [[ ${#svc_port_list[@]} -gt 0 ]]; then
    service_ports="
  ports:"
    local port_num=0
    for port in "${svc_port_list[@]}"; do
      service_ports="$service_ports
  - name: port-$port_num
    port: $port
    targetPort: $port"
      ((port_num++))
    done
  fi

  # Generate volume mounts and volumes for persistent storage
  local volume_mounts=""
  local volumes=""
  if [[ $no_storage -eq 0 ]]; then
    volume_mounts="
        volumeMounts:
        - name: data
          mountPath: $mount_path"
    [[ -n "$subpath" ]] && volume_mounts="$volume_mounts
          subPath: $subpath"
    [[ $mount_ro -eq 1 ]] && volume_mounts="$volume_mounts
          readOnly: true"

    volumes="
      volumes:
      - name: data
        persistentVolumeClaim:
          claimName: agent-storage"
  fi

  if [[ $replace -eq 1 ]]; then
    if [[ -n "$restore_file" ]]; then
      echo_step "Removing existing workload before restore..."
      local delete_resp delete_status delete_body
      delete_resp=$(api_call DELETE "/api/v1/agents/${agent}/workload")
      delete_status=$(echo "$delete_resp" | tail -1)
      delete_body=$(echo "$delete_resp" | sed '$d')
      if [[ "$delete_status" != "200" ]]; then
        echo_warn "Could not remove existing workload before restore (HTTP $delete_status): $delete_body"
        echo_warn "Restore may fail if the existing workload still holds the storage volume; continuing to launch either way."
      fi
      sleep 2
    else
      local existing
      existing=$(kubectl get pods -n "$namespace" --no-headers 2>/dev/null | grep -c . || true)
      if [[ -n "$existing" && "$existing" -gt 0 ]]; then
        echo_step "Replacing $existing existing pod(s)..."
        kubectl delete pods -n "$namespace" --all --ignore-not-found --wait=false 2>/dev/null || true
        sleep 2
      fi
    fi
  fi

  if [[ -n "$restore_file" ]]; then
    echo_step "Restoring $restore_file into /data before startup..."
    local restore_resp restore_status restore_body restore_msg
    restore_resp=$(api_upload_file POST "/api/v1/agents/${agent}/restore-upload" "$restore_file")
    restore_status=$(echo "$restore_resp" | tail -1)
    restore_body=$(echo "$restore_resp" | sed '$d')
    if [[ "$restore_status" != "200" ]]; then
      restore_msg=$(echo "$restore_body" | jq -r '.error // "unknown error"' 2>/dev/null || echo "$restore_body")
      echo_warn "Restore failed: $restore_msg (HTTP $restore_status)"
      echo_warn "Launching without restored data. Check agent-api logs for restore-upload details."
    else
      echo_pass "Restore complete"
    fi
  fi

  # Build pod-level security context (fsGroup for volume ownership)
  local pod_security_context="
        seccompProfile:
          type: RuntimeDefault"
  if [[ -n "$fs_group" ]]; then
    pod_security_context="$pod_security_context
        fsGroup: $fs_group"
  fi

  # Build container-level security context (runAsUser, runAsGroup)
  local container_security_context="
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
            add:
            - CHOWN
            - DAC_OVERRIDE
            - FOWNER
            - SETGID
            - SETUID
          seccompProfile:
            type: RuntimeDefault"
  if [[ -n "$run_as_user" ]]; then
    container_security_context="$container_security_context
          runAsUser: $run_as_user"
  fi
  if [[ -n "$run_as_group" ]]; then
    container_security_context="$container_security_context
          runAsGroup: $run_as_group"
  fi

  # Container user and security context can be overridden with flags
  # Default behavior: use image USER directive
  # Host node limits (fs.file-max, inotify watchers) are set by host-limits DaemonSet

  # Build container command spec (if --command was provided)
  local command_spec=""
  if [[ -n "$container_command" ]]; then
    command_spec="        command: [\"/bin/sh\", \"-c\", \"${container_command}\"]"
  fi

  # Prefer POST /api/v1/agents/{agent}/deploy when the request can be expressed
  # as {template, overrides} — same code path the portal uses. The legacy
  # YAML+/apply path remains only for advanced cases /deploy cannot represent.
  local deployed_via_deploy=0
  if pcli_can_use_deploy_endpoint "$manifest_name" "$custom_image" "$user_specified_ports" "$no_secrets"; then
    # expected_secret_keys is intentionally omitted: the live K8s secret keys
    # are namespace-prefixed (e.g. "agents_kevin-littlejohn_c2s_gitlab-pat")
    # while the manifest declares raw names ("gitlab-pat"). Computing the
    # namespaced form mirrors portal logic — out of scope for Phase 3. With
    # an empty list the server still verifies the ExternalSecret is Ready and
    # the K8s Secret has data, just not specific key names.
    local deploy_body
    deploy_body=$(pcli_build_deploy_body \
      "$manifest_name" "$no_secrets" \
      "$cpu" "$cpu_explicit" \
      "$memory" "$memory_explicit" \
      "$container_command" "$replace" \
      "")

    if [[ "$dry_run_deploy" -eq 1 ]]; then
      echo_step "DRY RUN: would POST to /api/v1/agents/${agent}/deploy:"
      echo "$deploy_body"
      exit 0
    fi

    echo_step "Deploying via /api/v1/agents/${agent}/deploy..."
    local deploy_output
    if deploy_output=$(pcli_post_deploy "$agent" "$deploy_body"); then
      deployed_via_deploy=1
      echo_pass "Deployed via /deploy endpoint"
    else
      [[ -n "$deploy_output" ]] && echo "$deploy_output"
      echo_fail "Not falling back to legacy /apply after a /deploy failure."
      echo "  Fix the error above and retry, or use a command shape that is explicitly unsupported by /deploy."
      exit 1
    fi
  else
    echo_warn "Using legacy /apply path: $(pcli_deploy_skip_reason "$manifest_name" "$custom_image" "$user_specified_ports")"
  fi

  if [[ "$deployed_via_deploy" -eq 0 ]]; then
  # Build the multi-document YAML client-side, then POST to agent-api /apply.
  # agent-api owns the actual k8s writes via Server-Side Apply (FieldManager=agent-api)
  # so operator-injected fields (sshd sidecar, etc.) are preserved across redeploys.
  local apply_yaml
  apply_yaml=$(cat <<EOF
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ${pod_name}
  labels:
    app: ${pod_name}
    managed-by: pcli
spec:
  replicas: 1
  selector:
    matchLabels:
      app: ${pod_name}
  template:
    metadata:
      labels:
        app: ${pod_name}
        managed-by: pcli
    spec:
      serviceAccountName: agent-sa
      nodeSelector:
        workload-type: agent
      tolerations:
      - key: workload-type
        operator: Equal
        value: agent
        effect: NoSchedule
      securityContext:$pod_security_context
      containers:
      - name: app
        image: ${image}
        imagePullPolicy: Always
${command_spec:+${command_spec}
}        env:
        - name: PALANA_USER
          value: "$(get_effective_user_id)"
        envFrom:
        - configMapRef:
            name: vault-config
            optional: true
        - secretRef:
            name: agent-secrets
            optional: true
$port_spec$volume_mounts
        securityContext:$container_security_context
        resources:
          requests:
            cpu: ${cpu}
            memory: ${memory}
          limits:
            cpu: ${cpu}
            memory: ${memory}$volumes
EOF
)

  if [[ -n "$ports" || -n "$web_port" ]]; then
    apply_yaml+=$'\n---\n'
    apply_yaml+=$(cat <<EOF
apiVersion: v1
kind: Service
metadata:
  name: ${agent}-svc
  labels:
    app: ${agent}
    web-port: "${web_port:-none}"
spec:
  type: ClusterIP
  selector:
    app: ${pod_name}$service_ports
EOF
)

    if [[ -n "$web_port" ]]; then
      if kubectl get crd ingressroutes.traefik.io &>/dev/null; then
        local ingress_domain="${INGRESS_DOMAIN:-palana.engtools.net}"
        local sanitized_user
        sanitized_user=$(sanitize_user_id "$user")
        local agent_hostname="${agent}-${sanitized_user}.agent.${ingress_domain}"

        apply_yaml+=$'\n---\n'
        apply_yaml+=$(cat <<EOF
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: agent-${agent}
  labels:
    app: agent-${agent}
    managed-by: pcli
spec:
  entryPoints:
    - web
  routes:
    - match: Host(\`${agent_hostname}\`)
      kind: Rule
      services:
        - name: ${agent}-svc
          port: ${web_port}
      middlewares:
        - name: rate-limit
          namespace: gateway
        - name: oauth2-auth
          namespace: gateway
EOF
)
      fi
    fi
  fi

  local apply_resp apply_status apply_body
  apply_resp=$(api_call POST "/api/v1/agents/${agent}/apply" "$apply_yaml")
  apply_status=$(echo "$apply_resp" | tail -1)
  apply_body=$(echo "$apply_resp" | sed '$d')
  if [[ "$apply_status" != "200" ]]; then
    local err_msg
    err_msg=$(echo "$apply_body" | jq -r '.error // "unknown error"' 2>/dev/null || echo "$apply_body")
    echo_fail "Apply failed: $err_msg (HTTP $apply_status)"
    exit 1
  fi
  local apply_warnings
  apply_warnings=$(echo "$apply_body" | jq -r '.warnings[]?' 2>/dev/null)
  if [[ -n "$apply_warnings" ]]; then
    while IFS= read -r w; do
      echo_warn "$w"
    done <<< "$apply_warnings"
  fi
  fi  # end of "if [[ \"\$deployed_via_deploy\" -eq 0 ]]" — bounded legacy fallback

  if [[ -n "$ports" || -n "$web_port" ]]; then
    echo_step "Waiting for pod to be ready..."
    if ! kubectl rollout status deployment/${pod_name} -n "$namespace" --timeout=60s 2>/dev/null; then
      echo_warn "Deployment did not reach Ready state within 60s (may still be starting)"
    fi

    if [[ -n "$web_port" ]] && kubectl get crd ingressroutes.traefik.io &>/dev/null; then
      local ingress_domain="${INGRESS_DOMAIN:-palana.engtools.net}"
      local sanitized_user
      sanitized_user=$(sanitize_user_id "$user")
      echo_pass "IngressRoute created: ${agent}-${sanitized_user}.agent.${ingress_domain}"
    fi

    echo_step "Cleaning up existing port-forwards for $agent..."
    cmd_portforward_destroy "$agent" 2>/dev/null || true

    for spec in "${port_specs[@]}"; do
      if [[ -z "$spec" ]]; then
        continue
      fi
      local remote_port=$(echo "$spec" | cut -d':' -f1)
      local local_port=$(echo "$spec" | cut -d':' -f2)
      if [[ -z "$local_port" ]]; then
        local_port="$remote_port"
      fi
      if [[ "$local_port" != "$remote_port" ]] || [[ "$remote_port" != "$web_port" ]]; then
        if cmd_portforward_create "$agent" "$remote_port" "$local_port"; then
          echo_pass "Port-forward ready: localhost:${local_port}→${remote_port}"
        else
          echo_warn "Could not create port-forward (continuing)"
        fi
      fi
    done
  fi

  echo_pass "Container deployed to $namespace"

  # Sync policies from manifest to agent-api (proxy + gitlab)
  if [[ -n "$manifest_name" ]]; then
    local manifest_file
    manifest_file=$(resolve_manifest "$manifest_name")

    # Sync proxy_policy
    local proxy_rules=""
    if command -v yq &>/dev/null; then
      proxy_rules=$(yq -r '.proxy_policy.network // [] | length' "$manifest_file" 2>/dev/null)
    fi
    if [[ -n "$proxy_rules" && "$proxy_rules" != "0" ]]; then
      local proxy_body
      proxy_body=$(yq -o=json '.proxy_policy' "$manifest_file" 2>/dev/null)
      if [[ -n "$proxy_body" && "$proxy_body" != "null" ]]; then
        local resp
        resp=$(api_call PUT "/api/v1/policy/${agent}" "$proxy_body" 2>/dev/null) || true
        local pstatus=$(echo "$resp" | tail -1)
        if [[ "$pstatus" -ge 200 && "$pstatus" -lt 300 ]] 2>/dev/null; then
          echo_pass "Proxy policy synced ($proxy_rules rules)"
        fi
      fi
    fi

    # Sync gitlab_policy
    local repo_rules=""
    if command -v yq &>/dev/null; then
      repo_rules=$(yq -r '.gitlab_policy.repositories // [] | length' "$manifest_file" 2>/dev/null)
    fi
    if [[ -n "$repo_rules" && "$repo_rules" != "0" ]]; then
      local gitlab_body
      gitlab_body=$(yq -o=json '.gitlab_policy' "$manifest_file" 2>/dev/null)
      if [[ -n "$gitlab_body" && "$gitlab_body" != "null" ]]; then
        local resp
        resp=$(api_call PUT "/api/v1/gitlab-policy/${agent}" "$gitlab_body" 2>/dev/null) || true
        local gstatus=$(echo "$resp" | tail -1)
        if [[ "$gstatus" -ge 200 && "$gstatus" -lt 300 ]] 2>/dev/null; then
          echo_pass "GitLab policy synced ($repo_rules rules)"
        fi
      fi
    fi
  fi

  echo ""
  echo "📍 Pod:     ${pod_name}"
  if [[ -n "$ports" || -n "$web_port" ]]; then
    echo "📍 Service: ${agent}-svc"
    if [[ -n "$web_port" ]]; then
      echo "   Web Port: ${web_port} (via Traefik)"
    fi
    for spec in "${port_specs[@]}"; do
      if [[ -z "$spec" ]]; then
        continue
      fi
      local remote_port=$(echo "$spec" | cut -d':' -f1)
      local local_port=$(echo "$spec" | cut -d':' -f2)
      if [[ -z "$local_port" ]]; then
        local_port="$remote_port"
      fi
      if [[ "$local_port" != "$remote_port" ]] || [[ "$remote_port" != "$web_port" ]]; then
        echo "   Port ${remote_port} → localhost:${local_port} (port-forward)"
      fi
    done
    echo ""
    local ingress_domain="${INGRESS_DOMAIN:-palana.engtools.net}"
    local sanitized_user
    sanitized_user=$(sanitize_user_id "$user")
    local agent_url="https://${agent}-${sanitized_user}.agent.${ingress_domain}"
    if [[ -n "$web_port" ]] && kubectl get crd ingressroutes.traefik.io &>/dev/null; then
      echo "🌐 Ingress: ${agent_url}"
    fi
  else
    echo "📍 Service: (no ports exposed)"
  fi
  echo ""
  if [[ -n "$ports" || -n "$web_port" ]]; then
    echo "Access the container:"
    if [[ -n "$web_port" ]] && kubectl get crd ingressroutes.traefik.io &>/dev/null; then
      echo "  Browser: ${agent_url}"
    else
      for spec in "${port_specs[@]}"; do
        local remote_port=$(echo "$spec" | cut -d':' -f1)
        local local_port=$(echo "$spec" | cut -d':' -f2)
        if [[ -z "$local_port" ]]; then
          local_port="$remote_port"
        fi
        if [[ "$local_port" != "$remote_port" ]] || [[ "$remote_port" != "$web_port" ]]; then
          echo "  localhost:${local_port} (remote port ${remote_port})"
        fi
      done
    fi
  else
    echo "Container deployed but no ports exposed. Use kubectl exec to access."
  fi
  echo ""
  echo "View logs:"
  echo "  pcli logs ${agent} ${pod_name}"
  echo ""
  echo "View status:"
  echo "  kubectl describe pod -n ${namespace} ${pod_name}"
}

render_rebuild_template_json() {
  python3 - "$1" "$2" <<'PYEOF'
import sys, json
try:
    import yaml
except ImportError:
    print("ERROR: PyYAML not available (pip install pyyaml)", file=sys.stderr)
    sys.exit(1)
with open(sys.argv[1]) as f:
    data = yaml.safe_load(f)
data.pop("apiVersion", None)
data.pop("kind", None)
data.setdefault("container", {})["image"] = sys.argv[2] + ":latest"
print(json.dumps(data))
PYEOF
}

# Rebuild and push docker image
cmd_rebuild() {
  if contains_help "$@"; then
    echo "Usage: pcli rebuild <image-name> [--no-cache] [--template <file>] [docker-build-args...]"
    echo ""
    echo "  image-name          Image name (e.g. opencode, litellm)"
    echo "  --no-cache          Build without using Docker cache"
    echo "  --template <file>   Register/update user template from manifest YAML after build"
    echo "  docker-build-args   Additional docker buildx arguments"
    echo ""
    echo "Examples:"
    echo "  pcli rebuild opencode -t testing -f build/Dockerfile.opencode ."
    echo "  pcli rebuild opencode --no-cache"
    echo "  pcli rebuild litellm -f build/Dockerfile.litellm . --build-arg VERSION=2.0"
    echo "  pcli rebuild holyclaude --template build/user-manifests/holyclaude.yaml"
    exit 0
  fi

  local image_name=$1
  shift || true

  local no_cache="" template_file=""
  local -a docker_args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-cache) no_cache="--no-cache"; shift ;;
      --template) template_file="$2"; shift 2 ;;
      *) docker_args+=("$1"); shift ;;
    esac
  done
  set -- "${docker_args[@]+"${docker_args[@]}"}"

  if [[ -z "$image_name" ]]; then
    echo_fail "Missing image name"
    echo "Usage: pcli rebuild <image-name> [docker-build-args...]"
    exit 1
  fi

  if [[ -n "$template_file" && ! -f "$template_file" ]]; then
    echo_fail "Template file not found: $template_file"
    exit 1
  fi

  # Check for required tools
  if ! command -v docker &>/dev/null; then
    echo_fail "docker command not found. Install Docker to use 'pcli rebuild'."
    echo "Alternatively, use 'glab ci run -b main --variables build_agent:<image-name>' to build through CI/CD."
    exit 1
  fi

  if ! command -v aws &>/dev/null; then
    echo_fail "aws command not found. Install AWS CLI v2 to use 'pcli rebuild'."
    echo "Alternatively, use 'glab ci run -b main --variables build_agent:<image-name>' to build through CI/CD."
    exit 1
  fi

  check_credentials

  echo_step "Requesting ECR credentials for: $image_name"
  local response
  response=$(api_call POST "/api/v1/ecr/credentials" "{\"image_name\": \"$image_name\"}")
  local cred_status cred_body
  cred_status=$(echo "$response" | tail -1)
  cred_body=$(echo "$response" | sed '$d')

  if [[ "$cred_status" != "200" ]]; then
    local err
    err=$(echo "$cred_body" | jq -r '.error // "unknown error"' 2>/dev/null || echo "$cred_body")
    echo_fail "Failed to get ECR credentials: $err (HTTP $cred_status)"
    exit 1
  fi

  local ecr_registry ecr_repository access_key secret_key session_token region
  ecr_registry=$(echo "$cred_body" | jq -r '.registry')
  ecr_repository=$(echo "$cred_body" | jq -r '.repository')
  access_key=$(echo "$cred_body" | jq -r '.access_key_id')
  secret_key=$(echo "$cred_body" | jq -r '.secret_access_key')
  session_token=$(echo "$cred_body" | jq -r '.session_token')
  region=$(echo "$cred_body" | jq -r '.region')

  local ecr_full_repo="${ecr_registry}/${ecr_repository}"
  echo_pass "ECR credentials received (15-min TTL)"
  echo "  Registry:   $ecr_registry"
  echo "  Repository: $ecr_repository"

  echo_step "Preparing isolated Docker credentials for ECR..."
  local docker_config_dir
  if ! docker_config_dir=$(create_ecr_docker_config "$ecr_registry" "$region" "$access_key" "$secret_key" "$session_token"); then
    echo_fail "Failed to prepare Docker credentials for ECR"
    exit 1
  fi
  trap 'rm -rf "$docker_config_dir"; trap - RETURN' RETURN
  echo_pass "Docker credentials ready"

  echo_step "Rebuilding image: $image_name"

  local has_tag=0
  for i in "${!@}"; do
    if [[ "${!i}" == "-t" ]]; then
      has_tag=1
      break
    fi
  done

  local has_context=0
  local last_arg="${!#}"
  if [[ $# -gt 0 && "$last_arg" != -* ]]; then
    has_context=1
  fi

  if [[ $# -eq 0 ]]; then
    set -- "-t" "${ecr_full_repo}:latest" "-f" "build/Dockerfile.${image_name}" "--push" "."
  elif [[ $has_tag -eq 0 && $has_context -eq 0 ]]; then
    set -- "$@" "-t" "${ecr_full_repo}:latest" "--push" "."
  elif [[ $has_tag -eq 0 ]]; then
    set -- "$@" "-t" "${ecr_full_repo}:latest" "--push"
  elif [[ $has_context -eq 0 ]]; then
    set -- "$@" "--push" "."
  else
    set -- "$@" "--push"
  fi

  echo_step "Building and pushing multi-arch (amd64+arm64) to ECR with: docker buildx build ${no_cache} --platform linux/amd64,linux/arm64 $*"
  if ! DOCKER_CONFIG="$docker_config_dir" docker buildx build ${no_cache} --platform linux/amd64,linux/arm64 "$@"; then
    rm -rf "$docker_config_dir"
    trap - RETURN
    echo_fail "Failed to build and push image"
    exit 1
  fi
  rm -rf "$docker_config_dir"
  trap - RETURN

  echo_pass "Image built and pushed successfully (amd64+arm64)"
  echo ""
  echo "  Deploy with:  pcli run <agent> user/${image_name}"

  if [[ -z "$template_file" ]]; then
    return
  fi

  echo_step "Registering template from: $template_file"
  local manifest_json
  if ! manifest_json=$(render_rebuild_template_json "$template_file" "$ecr_full_repo"); then
    echo_fail "Failed to parse template file: $manifest_json"
    exit 1
  fi

  local tmpl_response tmpl_status tmpl_body
  tmpl_response=$(api_call POST "/api/v1/user-templates" "$manifest_json")
  tmpl_status=$(echo "$tmpl_response" | tail -1)
  tmpl_body=$(echo "$tmpl_response" | sed '$d')

  if [[ "$tmpl_status" == "201" ]]; then
    echo_pass "Template registered: $image_name"
  else
    local err
    err=$(echo "$tmpl_body" | jq -r '.error // "unknown error"' 2>/dev/null || echo "$tmpl_body")
    echo_fail "Failed to register template: $err (HTTP $tmpl_status)"
    exit 1
  fi
}

# View logs from agent pod(s)
cmd_logs() {
  if contains_help "$@"; then
    echo "Usage: pcli logs <agent> [pod-name]"
    echo ""
    echo "  agent     Agent name (e.g. demo, opencode)"
    echo "  pod-name  Optional. Omit to use the first pod in the agent namespace."
    exit 0
  fi

  local agent=$1
  local pod_name=$2

  if [[ -z "$agent" ]]; then
    echo_fail "Usage: pcli logs <agent> [pod-name]"
    exit 1
  fi

  local user=$(get_effective_user_id)
  local namespace
  namespace=$(get_agent_namespace "$agent")

  if ! check_namespace_exists "$namespace"; then
    echo_fail "Namespace not found: $namespace"
    echo "Did you create the agent? Try: pcli create $agent"
    exit 1
  fi

  if [[ -z "$pod_name" ]]; then
    pod_name=$(kubectl get pods -n "$namespace" --field-selector=status.phase=Running -o json 2>/dev/null | jq -r '.items | map(select(.metadata.deletionTimestamp == null)) | sort_by(.metadata.creationTimestamp) | last | .metadata.name' 2>/dev/null)
    [[ -z "$pod_name" ]] && pod_name=$(kubectl get pods -n "$namespace" --field-selector=status.phase=Running -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)
    [[ -z "$pod_name" ]] && pod_name=$(kubectl get pods -n "$namespace" -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)
    if [[ -z "$pod_name" ]]; then
      echo_fail "No pods found in $namespace"
      exit 1
    fi
    local pod_count=$(kubectl get pods -n "$namespace" --no-headers 2>/dev/null | wc -l | tr -d ' ')
    if [[ "$pod_count" -gt 1 ]]; then
      echo_warn "Multiple pods in namespace, showing first: $pod_name"
      echo "  Other pods: $(kubectl get pods -n "$namespace" -o jsonpath='{.items[*].metadata.name}' 2>/dev/null | tr ' ' ', ')"
    fi
  else
    if ! kubectl get pod "$pod_name" -n "$namespace" &>/dev/null; then
      echo_fail "Pod not found: $pod_name"
      echo "Pods in $namespace: $(kubectl get pods -n "$namespace" -o jsonpath='{.items[*].metadata.name}' 2>/dev/null | tr ' ' ', ')"
      exit 1
    fi
  fi

  if [[ "$PCLI_INTERACTIVE" -eq 1 ]]; then
    kubectl logs -n "$namespace" "$pod_name" -f
  else
    kubectl logs -n "$namespace" "$pod_name" --tail=100
  fi
}

# Execute command or open interactive shell in agent pod
cmd_shell() {
  if contains_help "$@"; then
    echo "Usage: pcli shell <agent> [options] [command...]"
    echo ""
    echo "Options:"
    echo "  --container <name>  Container name (if pod has multiple containers)"
    echo "  --shell <shell>     Shell to use (default: /bin/sh)"
    echo "  --pod <pod-name>    Pod name (default: first pod in namespace)"
    echo ""
    echo "Examples:"
    echo "  pcli shell demo                              # Interactive shell in first pod"
    echo "  pcli shell demo ls -la /app                  # Run command in first pod"
    echo "  pcli shell demo --container main /bin/bash   # Bash in specific container"
    echo "  pcli shell demo --pod my-pod-0 --shell /bin/bash"
    exit 0
  fi

  local agent=$1
  shift || true

  if [[ -z "$agent" ]]; then
    echo_fail "Usage: pcli shell <agent> [options] [command...]"
    exit 1
  fi

  local user=$(get_effective_user_id)
  local namespace
  namespace=$(get_agent_namespace "$agent")

  if ! check_namespace_exists "$namespace"; then
    echo_fail "Namespace not found: $namespace"
    echo "Did you create the agent? Try: pcli create $agent"
    exit 1
  fi

  # Use kubectl directly (OIDC tokens now work with EKS)
  local K="kubectl"

  # Parse options
  local container=""
  local shell="/bin/sh"
  local pod_name=""
  local cmd_args=()

  while [[ $# -gt 0 ]]; do
    case $1 in
      --container)
        container="$2"
        shift 2
        ;;
      --shell)
        shell="$2"
        shift 2
        ;;
      --pod)
        pod_name="$2"
        shift 2
        ;;
      *)
        cmd_args+=("$1")
        shift
        ;;
    esac
  done

  # Get pod name if not specified (prefer newest Running pod; exclude terminating)
  if [[ -z "$pod_name" ]]; then
    pod_name=$($K get pods -n "$namespace" --field-selector=status.phase=Running -o json 2>/dev/null | jq -r '.items | map(select(.metadata.deletionTimestamp == null)) | sort_by(.metadata.creationTimestamp) | last | .metadata.name' 2>/dev/null)
    if [[ -z "$pod_name" || "$pod_name" == "null" ]]; then
      pod_name=$($K get pods -n "$namespace" -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)
    fi
    if [[ -z "$pod_name" || "$pod_name" == "null" ]]; then
      echo_fail "No pods found in $namespace"
      exit 1
    fi
    local pod_count=$($K get pods -n "$namespace" --no-headers 2>/dev/null | wc -l | tr -d ' ')
    if [[ "$pod_count" -gt 1 ]]; then
      echo_warn "Multiple pods in namespace, using first: $pod_name"
      echo "  Tip: specify with --pod <pod-name>"
    fi
  else
    if ! $K get pod "$pod_name" -n "$namespace" &>/dev/null; then
      echo_fail "Pod not found: $pod_name"
      exit 1
    fi
  fi

  # Get container name if not specified
  if [[ -z "$container" ]]; then
    local container_count=$($K get pod "$pod_name" -n "$namespace" -o jsonpath='{.spec.containers[*].name}' 2>/dev/null | wc -w)
    if [[ "$container_count" -gt 1 ]]; then
      echo "Pod $pod_name has multiple containers:"
      local containers=$($K get pod "$pod_name" -n "$namespace" -o jsonpath='{.spec.containers[*].name}' 2>/dev/null)
      local i=1
      for cont in $containers; do
        echo "  $i) $cont"
        ((i++))
      done
      echo ""
      read -r -p "Select container (1-$container_count): " choice
      if ! [[ "$choice" =~ ^[0-9]+$ ]] || [[ "$choice" -lt 1 ]] || [[ "$choice" -gt "$container_count" ]]; then
        echo_fail "Invalid selection"
        exit 1
      fi
      container=$($K get pod "$pod_name" -n "$namespace" -o jsonpath='{.spec.containers['"$((choice-1))"'].name}' 2>/dev/null)
    else
      container=$($K get pod "$pod_name" -n "$namespace" -o jsonpath='{.spec.containers[0].name}' 2>/dev/null)
    fi
  fi

  if [[ -z "$container" ]]; then
    echo_fail "Could not determine container name"
    exit 1
  fi

  # Execute command or open shell
  if [[ ${#cmd_args[@]} -gt 0 ]]; then
    $K exec -it -n "$namespace" "$pod_name" -c "$container" -- "${cmd_args[@]}"
  else
    $K exec -it -n "$namespace" "$pod_name" -c "$container" -- "$shell"
  fi
}

# Copy file to agent pod (scp-like syntax)
cmd_cp() {
  if contains_help "$@"; then
    echo "Usage: pcli cp <local-file> <agent>:<remote-path>"
    echo ""
    echo "Copy a local file to a pod in an agent namespace (scp-like syntax)."
    echo ""
    echo "Arguments:"
    echo "  local-file      Path to local file to copy"
    echo "  agent:path      Agent name and destination path (e.g. opencode:/app/config.yaml)"
    echo ""
    echo "Options:"
    echo "  --pod <pod-name>  Pod name (default: first pod in namespace)"
    echo ""
    echo "Examples:"
    echo "  pcli cp ./config.yaml opencode:/app/config.yaml"
    echo "  pcli cp script.sh demo:/tmp/script.sh --pod my-pod-0"
    echo "  pcli cp ~/.ssh/id_rsa acc:~/.ssh/id_rsa"
    exit 0
  fi

  local src_arg=$1
  local dst_arg=$2
  shift 2 || true

  if [[ -z "$src_arg" || -z "$dst_arg" ]]; then
    echo_fail "Usage: pcli cp <local-file> <agent>:<remote-path>"
    exit 1
  fi

  # Parse agent:path format
  if [[ "$dst_arg" != *":"* ]]; then
    echo_fail "Destination must be in format agent:<path> (e.g. opencode:/app/config.yaml)"
    exit 1
  fi

  local agent="${dst_arg%%:*}"
  local remote_path="${dst_arg#*:}"

  if [[ -z "$agent" || -z "$remote_path" ]]; then
    echo_fail "Invalid destination format. Expected agent:<path>"
    exit 1
  fi

  if [[ ! -f "$src_arg" ]]; then
    echo_fail "Local file not found: $src_arg"
    exit 1
  fi

  # Parse options
  local pod_name=""
  while [[ $# -gt 0 ]]; do
    case $1 in
      --pod)
        pod_name="$2"
        shift 2
        ;;
      *)
        echo_fail "Unknown option: $1"
        exit 1
        ;;
    esac
  done

  local user=$(get_effective_user_id)
  local namespace
  namespace=$(get_agent_namespace "$agent")

  if ! check_namespace_exists "$namespace"; then
    echo_fail "Namespace not found: $namespace"
    echo "Did you create the agent? Try: pcli create $agent"
    exit 1
  fi

  # Get pod name if not specified (prefer newest Running pod; exclude terminating)
  if [[ -z "$pod_name" ]]; then
    pod_name=$(kubectl get pods -n "$namespace" --field-selector=status.phase=Running -o json 2>/dev/null | jq -r '.items | map(select(.metadata.deletionTimestamp == null)) | sort_by(.metadata.creationTimestamp) | last | .metadata.name' 2>/dev/null)
    if [[ -z "$pod_name" ]]; then
      pod_name=$(kubectl get pods -n "$namespace" --field-selector=status.phase=Running -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)
    fi
    if [[ -z "$pod_name" ]]; then
      pod_name=$(kubectl get pods -n "$namespace" -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)
    fi
    if [[ -z "$pod_name" ]]; then
      echo_fail "No pods found in $namespace"
      exit 1
    fi
    local pod_count=$(kubectl get pods -n "$namespace" --no-headers 2>/dev/null | wc -l | tr -d ' ')
    if [[ "$pod_count" -gt 1 ]]; then
      echo_warn "Multiple pods in namespace, using first: $pod_name"
      echo "  Other pods: $(kubectl get pods -n "$namespace" -o jsonpath='{.items[*].metadata.name}' 2>/dev/null | tr ' ' ', ')"
      echo "  Tip: specify with --pod <pod-name>"
    fi
  else
    if ! kubectl get pod "$pod_name" -n "$namespace" &>/dev/null; then
      echo_fail "Pod not found: $pod_name"
      echo "Pods in $namespace: $(kubectl get pods -n "$namespace" -o jsonpath='{.items[*].metadata.name}' 2>/dev/null | tr ' ' ', ')"
      exit 1
    fi
  fi

  echo_step "Copying $src_arg to $agent:$remote_path"
  if kubectl cp "$src_arg" "$namespace/$pod_name:$remote_path" 2>/dev/null; then
    echo_pass "File copied successfully to $pod_name:$remote_path"
  else
    echo_fail "Failed to copy file"
    exit 1
  fi
}

# Destroy container(s) and all workload in agent namespace
cmd_destroy() {
  if contains_help "$@"; then
    echo "Usage: pcli destroy <agent> [pod-name]"
    echo ""
    echo "Destroy options:"
    echo "  pcli destroy demo pod-name     Delete specific pod and its service"
    echo "  pcli destroy demo              Delete all workload in agent (pods, services, ingress)"
    exit 0
  fi

  check_credentials

  local agent=$1
  local pod_name=$2

  if [[ -z "$agent" ]]; then
    echo_fail "Usage: pcli destroy <agent> [pod-name]"
    echo ""
    echo "Destroy options:"
    echo "  pcli destroy demo pod-name     Delete specific pod and its service"
    echo "  pcli destroy demo              Delete all workload in agent (pods, services, ingress)"
    exit 1
  fi

  local path
  if [[ -n "$pod_name" ]]; then
    echo_step "Destroying pod: $pod_name"
    path="/api/v1/agents/${agent}/workload/pods/${pod_name}"
  else
    echo_step "Destroying workload for agent: $agent"
    path="/api/v1/agents/${agent}/workload"
  fi

  local response status body
  response=$(api_call DELETE "$path")
  status=$(echo "$response" | tail -1)
  body=$(echo "$response" | sed '$d')

  if [[ "$status" == "404" ]]; then
    local err
    err=$(echo "$body" | jq -r '.error // "not found"' 2>/dev/null || echo "$body")
    echo_fail "$err"
    exit 1
  fi
  if [[ "$status" != "200" ]]; then
    local err
    err=$(echo "$body" | jq -r '.error // "unknown error"' 2>/dev/null || echo "$body")
    echo_fail "Destroy failed: $err (HTTP $status)"
    exit 1
  fi

  if [[ -n "$pod_name" ]]; then
    echo_pass "Pod destroyed: $pod_name"
  else
    echo_pass "Workload destroyed for agent: $agent"
    local sync_status sync_reason
    sync_status=$(echo "$body" | jq -r '.efs_stop_sync // empty' 2>/dev/null || true)
    sync_reason=$(echo "$body" | jq -r '.efs_stop_sync_reason // empty' 2>/dev/null || true)
    case "$sync_status" in
      queued)
        echo_pass "EFS stop-sync queued"
        ;;
      skipped)
        echo_warn "EFS stop-sync skipped${sync_reason:+: $sync_reason}"
        ;;
      failed)
        echo_warn "EFS stop-sync request failed${sync_reason:+: $sync_reason}"
        ;;
    esac
  fi
}

