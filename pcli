  body_text=$(echo "$parsed" | tail -n +2)

  if [[ "$status" -ge 200 && "$status" -lt 300 ]]; then
    local disc_count
    disc_count=$(echo "$body_text" | jq '.discoverable | length')

    echo "Discoverable same-user agents:"
