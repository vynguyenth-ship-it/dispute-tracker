# Kill switch
cmd_kill_switch() {
  if contains_help "$@"; then
    echo "Usage: pcli kill-switch <enable|disable|status> <agent> [pod-name]"
    exit 0
  fi

  local action=$1
  local agent=$2
  local pod_name=${3:-}

  if [[ -z "$action" || -z "$agent" ]]; then
    echo_fail "Usage: pcli kill-switch <enable|disable|status> <agent> [pod-name]"
    exit 1
  fi

  local user=$(get_effective_user_id)
  local namespace
  namespace=$(get_agent_namespace "$agent")

  case "$action" in
    enable)
      echo_step "Enabling kill switch for $user/$agent"
      if [[ -n "$pod_name" ]]; then
        kubectl patch pod "$pod_name" -n "$namespace" \
          -p '{"metadata":{"annotations":{"palana.io/kill-switch":"enabled"}}}' \
          --type merge 2>/dev/null || {
          echo_fail "Failed to patch pod $pod_name in namespace $namespace"
          exit 1
        }
      else
        for pod in $(kubectl get pods -n "$namespace" -o jsonpath='{.items[*].metadata.name}' 2>/dev/null); do
          kubectl patch pod "$pod" -n "$namespace" \
            -p '{"metadata":{"annotations":{"palana.io/kill-switch":"enabled"}}}' \
            --type merge 2>/dev/null || true
        done
      fi
      echo_pass "Kill switch enabled"
      ;;
    disable)
      echo_step "Disabling kill switch for $user/$agent"
      if [[ -n "$pod_name" ]]; then
        kubectl patch pod "$pod_name" -n "$namespace" \
          -p '{"metadata":{"annotations":{"palana.io/kill-switch":null}}}' \
          --type merge 2>/dev/null || {
          echo_fail "Failed to patch pod $pod_name in namespace $namespace"
          exit 1
        }
      else
        for pod in $(kubectl get pods -n "$namespace" -o jsonpath='{.items[*].metadata.name}' 2>/dev/null); do
          kubectl patch pod "$pod" -n "$namespace" \
            -p '{"metadata":{"annotations":{"palana.io/kill-switch":null}}}' \
            --type merge 2>/dev/null || true
        done
      fi
      echo_pass "Kill switch disabled"
      ;;
    status)
      echo ""
      echo "Kill Switch Status for $user/$agent:"
      for pod in $(kubectl get pods -n "$namespace" -o jsonpath='{.items[*].metadata.name}' 2>/dev/null); do
        local status=$(kubectl get pod "$pod" -n "$namespace" -o jsonpath='{.metadata.annotations.palana\.io/kill-switch}' 2>/dev/null)
        if [[ "$status" == "enabled" ]]; then
          echo "  🔴 $pod - BLOCKED"
        else
          echo "  🟢 $pod - ENABLED"
        fi
      done
      ;;
    *)
      echo_fail "Unknown action: $action (use: enable, disable, status)"
      exit 1
      ;;
  esac
}

# Port-forward management
cmd_portforward() {
  local subcommand=$1
  shift || true

  if [[ "$subcommand" == "--help" || "$subcommand" == "-h" ]]; then
    echo "Usage:"
    echo "  pcli portforward create <agent> <remote-port> <local-port>"
    echo "  pcli portforward list"
    echo "  pcli portforward destroy <agent> [<remote-port>]"
    exit 0
  fi

  case "$subcommand" in
    create)
      cmd_portforward_create "$@"
      ;;
    list)
      cmd_portforward_list "$@"
      ;;
    destroy)
      cmd_portforward_destroy "$@"
      ;;
    *)
      echo_fail "Unknown portforward command: $subcommand"
      echo ""
      echo "Usage:"
      echo "  pcli portforward create <agent> <remote-port> <local-port>"
      echo "  pcli portforward list"
      echo "  pcli portforward destroy <agent> [<remote-port>]"
      exit 1
      ;;
  esac
}

cmd_portforward_create() {
  local agent=$1
  local remote_port=$2
  local local_port=$3

  if [[ -z "$agent" || -z "$remote_port" || -z "$local_port" ]]; then
    echo_fail "Usage: pcli portforward create <agent> <remote-port> <local-port>"
    echo ""
    echo "Examples:"
    echo "  pcli portforward create acc 8000 8000"
    echo "  pcli portforward create demo 5432 5432"
    return 1
  fi

  local user=$(get_effective_user_id)
  local namespace
  namespace=$(get_agent_namespace "$agent")

  if ! check_namespace_exists "$namespace"; then
    echo_fail "Namespace not found: $namespace"
    return 1
  fi

  local pf_target="svc/${agent}-svc"
  if ! kubectl get svc "${agent}-svc" -n "$namespace" &>/dev/null; then
    echo_warn "Service ${agent}-svc not found in $namespace"
    local pod_count
    pod_count=$(kubectl get pods -n "$namespace" --no-headers 2>/dev/null | wc -l)
    if [[ $pod_count -eq 1 ]]; then
      local pod_name
      pod_name=$(kubectl get pods -n "$namespace" -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)
      echo_step "Found single pod in namespace: $pod_name"
      pf_target="pod/$pod_name"
    else
      echo_fail "Service not found and pod detection failed: expected 1 pod, found $pod_count"
      return 1
    fi
  fi

  mkdir -p "$HOME/.palana/portforwards"

  local pf_file="$HOME/.palana/portforwards/${agent}-${remote_port}.pid"

  if [[ -f "$pf_file" ]]; then
    local old_pid=$(cat "$pf_file")
    if kill -0 "$old_pid" 2>/dev/null; then
      echo_warn "Port-forward already exists with PID $old_pid"
      return 1
    else
      rm -f "$pf_file"
    fi
  fi

  local log_file="$HOME/.palana/portforwards/${agent}-${remote_port}.log"

  if [[ "$pf_target" == svc* ]]; then
    echo_step "Waiting for service endpoints to be ready..."
    if ! kubectl wait --for=condition=ready endpoint/${agent}-svc -n "$namespace" --timeout=60s 2>/dev/null; then
      echo_warn "Service endpoints not ready (attempting port-forward anyway)"
    else
      echo_pass "Service endpoints ready"
    fi
  fi

  nohup kubectl port-forward -n "$namespace" "$pf_target" "${local_port}:${remote_port}" > "$log_file" 2>&1 &
  local pf_pid=$!
  disown 2>/dev/null || true

  sleep 1

  if ! kill -0 "$pf_pid" 2>/dev/null; then
    echo_fail "Port-forward failed to start"
    cat "$log_file" 2>/dev/null | head -5
    return 1
  fi

  if ! nc -z 127.0.0.1 "$local_port" 2>/dev/null; then
    sleep 2
    if ! nc -z 127.0.0.1 "$local_port" 2>/dev/null; then
      echo_fail "Port-forward process started but port $local_port is not listening"
      echo "Tunnel may have crashed. Logs:"
      cat "$log_file" 2>/dev/null
      kill "$pf_pid" 2>/dev/null || true
      rm -f "$pf_file"
      return 1
    fi
  fi

  echo "$pf_pid" > "$pf_file"
  echo_pass "Port-forward created: PID $pf_pid, listening on 127.0.0.1:$local_port"
}

cmd_portforward_list() {
  local pf_dir="$HOME/.palana/portforwards"

  if [[ ! -d "$pf_dir" ]]; then
    echo "No port-forwards active"
    return 0
  fi

  local has_any=0
  local current_user=$(get_effective_user_id)

  echo ""
  printf "%-12s %-12s %-10s %-8s %-10s\n" "Agent" "Remote Port" "Local Port" "PID" "Status"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

  for pf_file in "$pf_dir"/*.pid; do
    [[ ! -f "$pf_file" ]] && continue
    has_any=1

    local filename=$(basename "$pf_file" .pid)
    local agent=$(echo "$filename" | rev | cut -d'-' -f2- | rev)
    local remote_port=$(echo "$filename" | rev | cut -d'-' -f1 | rev)
    local pid=$(cat "$pf_file")
    local status="running"

    if ! kill -0 "$pid" 2>/dev/null; then
      status="${RED}crashed${NC}"
    fi

    local namespace
    if [[ "$agent" == "vault" ]]; then
      namespace="palana-system"
    else
      namespace=$(get_agent_namespace "$agent")
    fi
    if ! check_namespace_exists "$namespace"; then
      status="${RED}invalid${NC}"
    fi

    local local_port=$(netstat -ln 2>/dev/null | grep "LISTEN" | grep ":${pid}" 2>/dev/null | awk '{print $4}' | cut -d':' -f2 | head -1)
    if [[ -z "$local_port" ]]; then
      local_port="?"
    fi

    printf "%-12s %-12s %-10s %-8s %-10s\n" "$agent" "$remote_port" "$local_port" "$pid" "$status"
  done

  if [[ $has_any -eq 0 ]]; then
    echo "No port-forwards active"
  fi
  echo ""
}

cmd_portforward_destroy() {
  local agent=$1
  local remote_port=$2

  if [[ -z "$agent" ]]; then
    echo_fail "Usage: pcli portforward destroy <agent> [<remote-port>]"
    exit 1
  fi

  local pf_dir="$HOME/.palana/portforwards"
  local destroyed=0

  if [[ -z "$remote_port" ]]; then
    echo_step "Destroying all port-forwards for agent: $agent"
    for pf_file in "$pf_dir"/${agent}-*.pid; do
      [[ ! -f "$pf_file" ]] && continue
      local pid=$(cat "$pf_file")
      if kill -0 "$pid" 2>/dev/null; then
        kill "$pid" 2>/dev/null || true
        sleep 0.5
        if ! kill -0 "$pid" 2>/dev/null; then
          echo_pass "Killed port-forward PID $pid"
        else
          kill -9 "$pid" 2>/dev/null || true
          echo_pass "Force-killed port-forward PID $pid"
        fi
      fi
      rm -f "$pf_file"
      destroyed=$((destroyed + 1))
    done
    if [[ $destroyed -gt 0 ]]; then
      echo_pass "Destroyed $destroyed port-forward(s) for $agent"
    else
      echo_warn "No port-forwards found for agent: $agent"
    fi
  else
    echo_step "Destroying port-forward for $agent port $remote_port"
    local pf_file="$pf_dir/${agent}-${remote_port}.pid"
    if [[ ! -f "$pf_file" ]]; then
      echo_fail "Port-forward not found: $agent port $remote_port"
      exit 1
    fi

    local pid=$(cat "$pf_file")
    if kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
      sleep 0.5
      if ! kill -0 "$pid" 2>/dev/null; then
        echo_pass "Killed port-forward PID $pid"
      else
        kill -9 "$pid" 2>/dev/null || true
        echo_pass "Force-killed port-forward PID $pid"
      fi
    else
      echo_warn "Port-forward process not running (PID $pid)"
    fi
    rm -f "$pf_file"
    echo_pass "Destroyed port-forward: $agent port $remote_port"
  fi
}

# Secrets - manage agent secrets in Vault (add, remove, list)
# Path format: kv/agents/{user}/{agent}/{secret_name}
# Ownership: user can only manage secrets for agents they own

# Inside an agent pod the agent identity is known from $PALANA_AGENT. To let
# users operate on their own agent without retyping its name, the secrets
# subcommands accept an EXPLICIT self-target — never a guess:
#
#   1. A `--self` flag anywhere in the args (the ergonomic form):
#        pcli secrets add --self GRABGPT_API_KEY token=sk-…
#   2. An empty first positional, or no positional at all (the sentinel form):
#        pcli secrets list                 # no positional
#        pcli secrets add "" SECRET k=v    # explicit empty placeholder
#
# Both resolve <agent> to $PALANA_AGENT. We deliberately do NOT infer the
# agent from the *shape* of the remaining args: a bare `add SECRET k=v` is
# treated as agent=SECRET (explicit), because guessing would silently
# re-target a mutating write when a user passes an explicit cross-agent name
# but botches a later positional (e.g. `add other-agent token=x` → would
# wrongly write to $PALANA_AGENT). Explicit beats clever on destructive paths.
#
# On a shift, the caller's positional list is rewritten via the global
# PCLI_SELF_ARGS array.
#
# Usage:
#   if resolve_self_agent "$@"; then
#     set -- "${PCLI_SELF_ARGS[@]}"
#   fi
resolve_self_agent() {
  local found_self=0
  local -a rest=()
  local a
  for a in "$@"; do
    if [[ "$a" == "--self" ]]; then
      found_self=1
    else
      rest+=("$a")
    fi
  done

  if (( found_self )); then
    if [[ -z "${PALANA_AGENT:-}" ]]; then
      echo_fail "--self requires \$PALANA_AGENT (only meaningful inside an agent pod)" >&2
      exit 1
    fi
    PCLI_SELF_ARGS=("$PALANA_AGENT" ${rest[@]+"${rest[@]}"})
    return 0
  fi

  if is_in_cluster && [[ -n "${PALANA_AGENT:-}" ]] && [[ -z "${1:-}" ]]; then
    [[ $# -gt 0 ]] && shift
    PCLI_SELF_ARGS=("$PALANA_AGENT" ${@+"$@"})
    return 0
  fi

  return 1
}

# Ensure Vault port-forward is running when using default localhost:8200.
# Skips if VAULT_ADDR points to a non-local URL (remote Vault).
secrets_ownership_check() {
  local agent=$1
  local user=$2

  local user_ns=$(get_user_namespace)
  local owner
  # set +e needed: kubectl may fail with permission errors (especially when running
  # from restricted service accounts like matlock agents). If we can't access the
  # namespace, we'll let the proxy-secrets-service validate ownership on the server side.
  set +e
  owner=$(kubectl get useragents -n "$user_ns" -o json 2>/dev/null | jq -r --arg an "$agent" '.items[] | select(.spec.agent_name == $an) | .spec.user_id' 2>/dev/null | head -1)
  if [[ -z "$owner" ]]; then
    owner=$(kubectl get useragent "${agent}-agent" -n "$user_ns" -o jsonpath='{.spec.user_id}' 2>/dev/null)
  fi
  set -e
  # If we couldn't determine the owner (permission error or agent not found locally),
  # we still proceed. The proxy-secrets-service will validate ownership server-side.
  # If the agent truly doesn't exist or doesn't belong to the user, the API will reject it.
  if [[ -z "$owner" ]]; then
    return 0
  fi
  # Sanitize owner for comparison (agents created with unsanitized IDs)
  owner=$(sanitize_user_id "$owner")
  if [[ "$owner" != "$user" ]]; then
    echo_fail "Agent $agent does not belong to you (owner: $owner)"
    exit 1
  fi
}

cmd_secrets() {
  local subcommand=$1
  shift || true

  if [[ "$subcommand" == "--help" || "$subcommand" == "-h" ]]; then
    echo "Usage:"
    echo "  pcli secrets add <agent> <secret-name> key=value [key2=value2 ...] [--type proxy|agent] [--force]"
    echo "  pcli secrets remove <agent> <secret-name>"
    echo "  pcli secrets list <agent>"
    echo "  pcli secrets verify <agent>  Verify OpenCode can read credentials (path check)"
    echo "  pcli secrets gitlab <agent> [--pat PAT] [--ssh SSH_KEY_FILE]"
    echo "  pcli secrets from-profile <agent> [profile-key] [--force]"
    echo ""
    echo "  Inside an agent pod, target your own agent without retyping its name:"
    echo "    pass --self (e.g. \`pcli secrets add --self GRABGPT_API_KEY token=…\`)"
    echo "    or omit the <agent> positional for commands that take only an agent"
    echo "    (\`pcli secrets list\`). Both resolve to \$PALANA_AGENT. A bare first"
    echo "    positional is always treated as an explicit <agent> (never guessed),"
    echo "    so an explicit cross-agent name passes through and server-side"
    echo "    ownership checks decide what's allowed."
    echo ""
    echo "  Secrets are stored in one of two modes:"
    echo "    proxy  — agent cannot read; ext-authz substitutes TOKEN_<NAME> placeholders at egress"
    echo "    agent  — agent reads the real value directly (e.g. user IDs, allowlists)"
    echo "  By default 'add' picks the mode from the manifest's secret_type for that key,"
    echo "    falling back to proxy when the manifest is unavailable. Pass --type to override."
    echo "  Secret names are normalised on write to canonical UPPER_SNAKE form (e.g."
    echo "    grabgpt-api-key and grabgpt_api_key both become GRABGPT_API_KEY). The"
    echo "    canonical form is what appears in Vault and as env vars inside the agent."
    echo "    See docs/SECRETS_USER_GUIDE.md for the naming convention."
    echo "  Secret names are validated against the agent's manifest; mismatches on"
    echo "    dash/underscore/case are auto-corrected for 'add' and reported for"
    echo "    'from-profile'. Use --force to override."
    echo "  Valid profile keys: gitlab-pat, gitlab-ssh, grabgpt-api-key, codex-chatgpt-auth"
    echo "  Example: pcli secrets from-profile myagent grabgpt-api-key"
    echo "    This copies your saved profile GrabGPT key into the agent's per-agent"
    echo "    proxy secret. Profile secrets are not an automatic fallback for pcli run."
    exit 0
  fi

  case "$subcommand" in
    add)
      cmd_secrets_add "$@"
      ;;
    remove)
      cmd_secrets_remove "$@"
      ;;
    list)
      cmd_secrets_list "$@"
      ;;
    verify)
      cmd_secrets_verify "$@"
      ;;
    gitlab)
      cmd_secrets_gitlab "$@"
      ;;
    from-profile)
      cmd_secrets_from_profile "$@"
      ;;
    *)
      echo_fail "Unknown secrets command: $subcommand"
      exit 1
      ;;
  esac
}

cmd_secrets_add() {
  if resolve_self_agent "$@"; then
    set -- "${PCLI_SELF_ARGS[@]}"
  fi
  local agent=$1
  local secret_name=$2
  shift 2 || true

  if [[ -z "$agent" || -z "$secret_name" ]]; then
    echo_fail "Usage: pcli secrets add <agent> <secret-name> key=value [key2=value2 ...] [--type proxy|agent] [--force]"
    echo ""
    echo "Example: pcli secrets add demo GRABGPT_API_KEY token=your-key"
    echo ""
    echo "  --type    Storage mode: 'proxy' (default; agent cannot read, ext-authz substitutes"
    echo "            TOKEN_<NAME> placeholders at egress) or 'agent' (agent reads real value)."
    echo "            When omitted, the mode is taken from the manifest's secret_type for the"
    echo "            named key; falls back to 'proxy' if the manifest can't be resolved."
    echo "  --force   Skip validation against the agent manifest. Use when the secret name"
    echo "            intentionally differs from the manifest (rare)."
    exit 1
  fi

  local force=0
  local type_override=""
  local kv_args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=1; shift ;;
      --type)
        type_override="$2"
        if [[ "$type_override" != "proxy" && "$type_override" != "agent" ]]; then
          echo_fail "--type must be 'proxy' or 'agent', got: ${type_override:-<empty>}"
          exit 1
        fi
        shift 2 ;;
      --type=*)
        type_override="${1#--type=}"
        if [[ "$type_override" != "proxy" && "$type_override" != "agent" ]]; then
          echo_fail "--type must be 'proxy' or 'agent', got: ${type_override:-<empty>}"
          exit 1
        fi
        shift ;;
      *) kv_args+=("$1"); shift ;;
    esac
  done
  set -- "${kv_args[@]+"${kv_args[@]}"}"

  local user=$(get_effective_user_id)
  user=$(sanitize_user_id "$user")
  secrets_ownership_check "$agent" "$user"

  if [[ $# -eq 0 ]]; then
    echo_fail "At least one key=value pair required"
    exit 1
  fi

  # Validate the secret name against the agent's manifest and auto-correct
  # dash/underscore mismatches (the silent-failure mode that bit matlock).
  if ! validate_secret_name_against_manifest "$agent" "$secret_name" "$force"; then
    exit 1
  fi
  secret_name="$VALIDATED_SECRET_NAME"

  # Decide storage mode: explicit --type wins, else manifest secret_type, else proxy.
  local mode="$type_override"
  if [[ -z "$mode" ]]; then
    local manifest_type manifest_lookup_key
    manifest_lookup_key=$(match_secret_key_in_manifest "$agent" "$secret_name" 2>/dev/null || true)
    [[ -z "$manifest_lookup_key" ]] && manifest_lookup_key="$secret_name"
    manifest_type=$(manifest_secret_type "$agent" "$manifest_lookup_key" 2>/dev/null || true)
    case "$manifest_type" in
      agent) mode="agent" ;;
      proxy|"") mode="proxy" ;;
      *)
        # gitlab-pat / gitlab-ssh / etc. — these have dedicated commands, but if a
        # caller routes them here we default to proxy (current behaviour) so the
        # gitlab-* code paths in postProxySecrets still fire.
        mode="proxy" ;;
    esac
  fi

  if [[ "$mode" == "agent" ]]; then
    cmd_secrets_add_agent "$agent" "$secret_name" "$@"
  else
    cmd_secrets_add_proxy "$agent" "$secret_name" "$@"
  fi
}

canonical_secret_name_from_response() {
  local body="$1"
  local raw="$2"
  local canonical
  canonical=$(printf '%s' "$body" | jq -r --arg raw "$raw" '.canonical_names[$raw] // .canonical_name // empty' 2>/dev/null || true)
  if [[ -n "$canonical" && "$canonical" != "null" ]]; then
    printf '%s\n' "$canonical"
  else
    printf '%s\n' "$raw"
  fi
}

cmd_secrets_add_agent() {
  local agent=$1
  local secret_name=$2
  shift 2 || true

  local user=$(get_effective_user_id)
  user=$(sanitize_user_id "$user")

  local jq_args=()
  for kv in "$@"; do
    local k="${kv%%=*}"
    local v="${kv#*=}"
    jq_args+=(--arg "$k" "$v")
  done
  local inner
  inner=$(jq -n "${jq_args[@]}" '$ARGS.named') || { echo_fail "Failed to build JSON"; exit 1; }
  local body
  body=$(jq -n --arg name "$secret_name" --argjson inner "$inner" '{($name): $inner}') || { echo_fail "Failed to build JSON"; exit 1; }

  echo_step "Adding agent-readable secret $secret_name (real value, not a proxy placeholder)"
  local resp
  resp=$(secrets_api_call POST "/agents/$agent/secrets/agent" "$body")
  local code
  code=$(echo "$resp" | tail -1)
  local resp_body
  resp_body=$(echo "$resp" | sed '$d')
  if [[ "$code" == "200" ]]; then
    local canonical_name
    canonical_name=$(canonical_secret_name_from_response "$resp_body" "$secret_name")
    echo_pass "Agent secret added"
    echo "  Agent: kv/agents/$user/$agent/$canonical_name (actual value, agent reads it directly)"
  else
    echo_fail "Failed to add agent secret (HTTP $code)"
    echo "$resp_body"
    exit 1
  fi
}

cmd_secrets_add_proxy() {
  local agent=$1
  local secret_name=$2
  shift 2 || true

  local user=$(get_effective_user_id)
  user=$(sanitize_user_id "$user")

  local jq_args=()
  for kv in "$@"; do
    local k="${kv%%=*}"
    local v="${kv#*=}"
    jq_args+=(--arg "$k" "$v")
  done
  local inner
  inner=$(jq -n "${jq_args[@]}" '$ARGS.named') || { echo_fail "Failed to build JSON"; exit 1; }
  local body
  body=$(jq -n --arg name "$secret_name" --argjson inner "$inner" '{($name): $inner}') || { echo_fail "Failed to build JSON"; exit 1; }

  echo_step "Adding proxy secret $secret_name (agent cannot read)"
  local resp
  resp=$(secrets_api_call POST "/agents/$agent/secrets/proxy" "$body")
  local code
  code=$(echo "$resp" | tail -1)
  local resp_body
  resp_body=$(echo "$resp" | sed '$d')
  if [[ "$code" == "200" ]]; then
    local canonical_name
    canonical_name=$(canonical_secret_name_from_response "$resp_body" "$secret_name")
    echo_pass "Proxy secret added"
    echo "  Proxy: kv/proxy-secrets/$user/$agent/$canonical_name (actual value)"
    echo "  Agent ref: kv/agents/$user/$agent/$canonical_name (value: TOKEN_$canonical_name)"
  else
    echo_fail "Failed to add proxy secret (HTTP $code)"
    echo "$resp_body"
    exit 1
  fi
}

# Secrets API calls routed through agent-api (no port-forward needed).
# agent-api proxies /api/v1/secrets/* to proxy-secrets-service in-cluster.
secrets_api_call() {
  local method="$1" path="$2" data="${3:-}"
  api_call "$method" "/api/v1/secrets${path}" "$data"
}

secret_exists_in_api() {
  local agent=$1
  local secret_key=$2
  local canonical_key
  canonical_key=$(printf '%s' "$secret_key" | tr '[:lower:]-' '[:upper:]_')
  local resp
  resp=$(secrets_api_call GET "/agents/${agent}/secrets/all") || return 1
  local status body
  status=$(echo "$resp" | tail -1)
  body=$(echo "$resp" | sed '$d')
  [[ "$status" == "200" ]] || return 1
  echo "$body" | jq -e --arg canonical_key "$canonical_key" '.secrets[] | select((.name | ascii_upcase | gsub("-"; "_")) == $canonical_key)' &>/dev/null
}

cmd_secrets_remove() {
  if resolve_self_agent "$@"; then
    set -- "${PCLI_SELF_ARGS[@]}"
  fi
  local agent=$1
  local secret_name=$2

  if [[ -z "$agent" || -z "$secret_name" ]]; then
    echo_fail "Usage: pcli secrets remove <agent> <secret-name>"
    exit 1
  fi

  local user=$(get_effective_user_id)
  user=$(sanitize_user_id "$user")
  secrets_ownership_check "$agent" "$user"

  cmd_secrets_remove_proxy "$agent" "$secret_name"
}

cmd_secrets_remove_proxy() {
  local agent=$1
  local secret_name=$2

  local user=$(get_effective_user_id)
  user=$(sanitize_user_id "$user")

  echo_step "Removing proxy secret $secret_name"
  local resp
  resp=$(secrets_api_call DELETE "/agents/$agent/secrets/proxy/$secret_name")
  local code
  code=$(echo "$resp" | tail -1)
  if [[ "$code" == "200" ]]; then
    echo_pass "Proxy secret removed"
  else
    echo_warn "Secret may not have existed (HTTP $code)"
  fi
}


cmd_secrets_list() {
  if resolve_self_agent "$@"; then
    set -- "${PCLI_SELF_ARGS[@]}"
  fi
  local agent=$1

  if [[ -z "$agent" ]]; then
    echo_fail "Usage: pcli secrets list <agent>"
    exit 1
  fi

  local user=$(get_effective_user_id)
  user=$(sanitize_user_id "$user")
  secrets_ownership_check "$agent" "$user"

  echo_step "Listing secrets for $user/$agent"

  local resp_raw
  resp_raw=$(secrets_api_call GET "/agents/${agent}/secrets/all")
  local list_status
  list_status=$(echo "$resp_raw" | tail -1)
  local resp
  resp=$(echo "$resp_raw" | sed '$d')
  if [[ "$list_status" != "200" ]] || [[ -z "$resp" ]]; then
    resp=""
  fi
  if [[ -z "$resp" ]]; then
    echo "  (no secrets)"
    echo_pass "Secrets listed"
    return
  fi

  local proxy_secrets agent_secrets
  proxy_secrets=$(echo "$resp" | jq -r '.secrets[] | select(.type == "proxy") | .name' 2>/dev/null)
  agent_secrets=$(echo "$resp" | jq -r '.secrets[] | select(.type == "agent") | .name' 2>/dev/null)

  if [[ -n "$agent_secrets" ]]; then
    echo ""
    echo "Agent secrets:"
    echo "$agent_secrets" | sed 's/^/  /'
  fi

  if [[ -n "$proxy_secrets" ]]; then
    echo ""
    echo "Proxy-only secrets:"
    echo "$proxy_secrets" | sed 's/^/  /'
  fi

  if [[ -z "$proxy_secrets" && -z "$agent_secrets" ]]; then
    echo "  (no secrets)"
  fi

  echo ""
  echo_pass "Secrets listed"
}

cmd_secrets_verify() {
  if resolve_self_agent "$@"; then
    set -- "${PCLI_SELF_ARGS[@]}"
  fi
  local agent=$1
  if [[ -z "$agent" ]]; then
    echo_fail "Usage: pcli secrets verify <agent>"
    exit 1
  fi

  local user=$(get_effective_user_id)
  user=$(sanitize_user_id "$user")
  secrets_ownership_check "$agent" "$user"

  echo_step "Verifying secrets for $agent"

  if secret_exists_in_api "$agent" "GRABGPT_API_KEY"; then
    echo_pass "Credentials OK (GRABGPT_API_KEY present)"
  else
    echo_fail "GRABGPT_API_KEY not found"
    echo "  Add with: pcli secrets add $agent GRABGPT_API_KEY token=your-key"
    exit 1
  fi
}

cmd_secrets_gitlab() {
  if resolve_self_agent "$@"; then
    set -- "${PCLI_SELF_ARGS[@]}"
  fi
  local agent=$1
  shift || true

  local pat_value=""
  local ssh_value=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --pat)
        pat_value="$2"
        shift 2 || true
        ;;
      --ssh)
        ssh_value="$2"
        shift 2 || true
        ;;
      *)
        echo_fail "Unknown flag: $1"
        exit 1
        ;;
    esac
  done

  if [[ -z "$agent" ]]; then
    echo_fail "Usage: pcli secrets gitlab <agent> [--pat PAT] [--ssh SSH_KEY_FILE]"
    exit 1
  fi

  if [[ -z "$pat_value" && -z "$ssh_value" ]]; then
    echo_fail "At least one of --pat or --ssh is required"
    exit 1
  fi

  local user=$(get_effective_user_id)
  user=$(sanitize_user_id "$user")
  secrets_ownership_check "$agent" "$user"

  if [[ -n "$pat_value" ]]; then
    cmd_secrets_gitlab_pat "$agent" "$pat_value"
  fi

  if [[ -n "$ssh_value" ]]; then
    cmd_secrets_gitlab_ssh "$agent" "$ssh_value"
  fi
}

cmd_secrets_gitlab_pat() {
  local agent=$1
  local pat_value=$2

  local user=$(get_effective_user_id)
  user=$(sanitize_user_id "$user")

  local jq_args=(--arg token "$pat_value")
  local inner
  inner=$(jq -n "${jq_args[@]}" '$ARGS.named') || { echo_fail "Failed to build JSON"; exit 1; }
  local body
  body=$(jq -n --arg name "gitlab-pat" --argjson inner "$inner" '{($name): $inner}') || { echo_fail "Failed to build JSON"; exit 1; }

  echo_step "Adding GitLab PAT (proxy-only)"
  local resp
  resp=$(secrets_api_call POST "/agents/$agent/secrets/proxy" "$body")
  local code
  code=$(echo "$resp" | tail -1)
  if [[ "$code" == "200" ]]; then
    echo_pass "GitLab PAT added (kv/proxy-secrets/$user/$agent/gitlab-pat)"
  else
    echo_fail "Failed to add GitLab PAT (HTTP $code)"
    echo "$resp" | sed '$d'
    exit 1
  fi
}

cmd_secrets_gitlab_ssh() {
  local agent=$1
  local ssh_input=$2

  local ssh_key_content=""

  if [[ "$ssh_input" == @* ]]; then
    local ssh_file="${ssh_input#@}"
    ssh_file="${ssh_file/#\~/$HOME}"
    if [[ ! -f "$ssh_file" ]]; then
      echo_fail "SSH key file not found: $ssh_file"
      exit 1
    fi
    ssh_key_content=$(cat "$ssh_file") || { echo_fail "Failed to read SSH key"; exit 1; }
  else
    if [[ ! -f "$ssh_input" ]]; then
      echo_fail "SSH key file not found: $ssh_input"
      exit 1
    fi
    ssh_key_content=$(cat "$ssh_input") || { echo_fail "Failed to read SSH key"; exit 1; }
  fi

  local user=$(get_effective_user_id)
  user=$(sanitize_user_id "$user")

  local jq_args=(--arg private_key "$ssh_key_content")
  local inner
  inner=$(jq -n "${jq_args[@]}" '$ARGS.named') || { echo_fail "Failed to build JSON"; exit 1; }
  local body
  body=$(jq -n --arg name "gitlab-ssh" --argjson inner "$inner" '{($name): $inner}') || { echo_fail "Failed to build JSON"; exit 1; }

  echo_step "Adding GitLab SSH key (proxy-only)"
  local resp
  resp=$(secrets_api_call POST "/agents/$agent/secrets/proxy" "$body")
  local code
  code=$(echo "$resp" | tail -1)
  if [[ "$code" == "200" ]]; then
    echo_pass "GitLab SSH key added (kv/proxy-secrets/$user/$agent/gitlab-ssh)"
    echo "  Auto-generated internal keys:"
    echo "    - kv/agents/$user/$agent/gitlab-ssh-internal (private key)"
    echo "    - kv/proxy-secrets/$user/$agent/gitlab-ssh-authorized-keys (public key)"
  else
    echo_fail "Failed to add GitLab SSH key (HTTP $code)"
    echo "$resp" | sed '$d'
    exit 1
  fi
}

profile_secret_valid_keys() {
  echo "gitlab-pat, gitlab-ssh, grabgpt-api-key, codex-chatgpt-auth"
}

profile_secret_agent_target() {
  local profile_key="$1"
  case "$profile_key" in
    codex-chatgpt-auth) echo "CODEX_CHATGPT_AUTH_JSON_B64" ;;
    *) echo "$profile_key" ;;
  esac
}

profile_secret_target_type() {
  local profile_key="$1"
  case "$profile_key" in
    codex-chatgpt-auth) echo "agent" ;;
    *) echo "proxy" ;;
  esac
}

secrets_copy_from_profile() {
  local agent=$1
  local profile_key=$2
  local force=${3:-0}
  local target_secret_name
  target_secret_name=$(profile_secret_agent_target "$profile_key")
  local target_secret_type
  target_secret_type=$(profile_secret_target_type "$profile_key")

  # Validate against the agent manifest. from-profile writes under the profile
  # key name by default, except aliases that intentionally target a different
  # runtime env var (for example Codex ChatGPT profile login -> CODEX_CHATGPT_AUTH_JSON_B64).
  # A mismatch means the agent won't see the secret. Warn loudly; require
  # --force to proceed anyway.
  local canonical
  set +e
  canonical=$(match_secret_key_in_manifest "$agent" "$target_secret_name")
  local rc=$?
  set -e
  if [[ $rc -eq 1 ]]; then
    local keys
    keys=$(manifest_secret_keys "$agent")
    echo_warn "Profile key '$profile_key' targets '$target_secret_name', which is not declared in the '$agent' manifest."
    echo "  The agent would not be able to read this secret once copied."
    echo "  Valid manifest keys:"
    echo "$keys" | sed 's/^/    /'
    if [[ "$force" != "1" ]]; then
      echo "  Skipping. Pass --force to copy anyway."
      return 1
    fi
    echo_warn "--force set: copying under '$target_secret_name' anyway."
  elif [[ $rc -eq 2 ]]; then
    echo_warn "No local manifest found for '$agent' — skipping profile-secret target validation."
    echo "  If '$target_secret_name' is not in the registered template, the agent will not see it."
    if [[ "$force" != "1" ]]; then
      echo "  Pass --force to copy anyway."
      return 1
    fi
    echo_warn "--force set: copying under '$target_secret_name' anyway."
  elif [[ $rc -eq 0 && -n "$canonical" && "$canonical" != "$target_secret_name" ]]; then
    echo_warn "Profile key '$profile_key' targets '$target_secret_name', which differs from manifest key '$canonical'."
    if [[ "$force" == "1" ]]; then
      echo "  --force set: copying under '$target_secret_name' anyway."
    else
      echo "  Auto-correcting copy target to '$canonical' so the agent can read it."
      target_secret_name="$canonical"
    fi
  fi

  echo_step "Copying profile secret: $profile_key -> $target_secret_name"
  local resp
  local copy_body
  copy_body=$(jq -n --arg secret_name "$target_secret_name" --arg secret_type "$target_secret_type" '{secret_name:$secret_name, secret_type:$secret_type}')
  resp=$(secrets_api_call POST "/agents/$agent/secrets/from-profile/$profile_key" "$copy_body")
  local code
  code=$(echo "$resp" | tail -1)
  local body
  body=$(echo "$resp" | sed '$d')

  if [[ "$code" == "200" ]]; then
    echo_pass "Copied $profile_key to $agent"
    return 0
  elif [[ "$code" == "404" ]]; then
    echo_warn "Profile secret $profile_key not found (not saved in your profile)"
    return 1
  elif [[ "$code" == "400" ]]; then
    echo_fail "Unknown profile secret: $profile_key (valid: $(profile_secret_valid_keys))"
    return 1
  else
    echo_fail "Failed to copy $profile_key (HTTP $code)"
    echo "$body"
    return 1
  fi
}

cmd_secrets_from_profile() {
  if resolve_self_agent "$@"; then
    set -- "${PCLI_SELF_ARGS[@]}"
  fi
  local agent="" profile_key="" force=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=1; shift ;;
      *)       if [[ -z "$agent" ]]; then agent=$1; elif [[ -z "$profile_key" ]]; then profile_key=$1; fi; shift ;;
    esac
  done

  if [[ -z "$agent" ]]; then
    echo_fail "Usage: pcli secrets from-profile <agent> [profile-key] [--force]"
    echo ""
    echo "Copy profile secrets to an agent (same as portal 'From Profile' flow)."
    echo ""
    echo "Valid profile keys: $(profile_secret_valid_keys)"
    echo ""
    echo "Examples:"
    echo "  pcli secrets from-profile myagent              # copy all saved profile secrets"
    echo "  pcli secrets from-profile myagent gitlab-pat   # copy specific profile secret"
    echo "  pcli secrets from-profile myagent grabgpt-api-key"
    echo ""
    echo "  --force   Copy even when the profile key name doesn't match the agent's manifest"
    echo "            (the agent won't be able to read secrets not declared in its manifest)."
    exit 1
  fi

  local user=$(get_effective_user_id)
  user=$(sanitize_user_id "$user")
  secrets_ownership_check "$agent" "$user"

  if [[ -n "$profile_key" ]]; then
    secrets_copy_from_profile "$agent" "$profile_key" "$force"
  else
    echo_step "Checking saved profile secrets..."
    local list_resp
    list_resp=$(secrets_api_call GET "/profile/secrets")
    local list_code
    list_code=$(echo "$list_resp" | tail -1)
    local list_body
    list_body=$(echo "$list_resp" | sed '$d')

    if [[ "$list_code" != "200" ]]; then
      echo_fail "Failed to list profile secrets (HTTP $list_code)"
      echo "$list_body"
      exit 1
    fi

    local secrets
    secrets=$(echo "$list_body" | jq -r '.secrets[]' 2>/dev/null)
    if [[ -z "$secrets" ]]; then
      echo_fail "No profile secrets found. Save profile secrets first via the portal."
      exit 1
    fi

    echo_pass "Found profile secrets:"
    echo "$secrets" | sed 's/^/  /'
    echo ""

    local failed=0
    while IFS= read -r key; do
      secrets_copy_from_profile "$agent" "$key" "$force" || failed=1
    done <<< "$secrets"

    if [[ "$failed" -eq 1 ]]; then
      echo_warn "Some profile secrets failed to copy"
      exit 1
    fi
    echo_pass "All profile secrets copied to $agent"
  fi
}

cmd_chatgpt() {
  local subcommand="${1:-help}"
  shift || true

  case "$subcommand" in
    login|save)
      cmd_chatgpt_login "$@"
      ;;
    status)
      cmd_chatgpt_status "$@"
      ;;
    apply|from-profile)
      cmd_chatgpt_apply "$@"
      ;;
    remove|delete)
      cmd_chatgpt_remove "$@"
      ;;
    --help|-h|help)
      cat << 'EOF'
Usage:
  pcli chatgpt login [--force]
  pcli chatgpt status
  pcli chatgpt apply <agent> [--force]
  pcli chatgpt remove

Runs Codex device auth locally, stores the resulting Codex auth.json blob in
your Palana profile, then copies it to opted-in Codex agents as
CODEX_CHATGPT_AUTH_JSON_B64. Agent entrypoints decode and merge it into
CODEX_HOME/auth.json for Codex.

Examples:
  pcli chatgpt login
  pcli chatgpt login --force
  pcli chatgpt apply swamp
EOF
      ;;
    *)
      echo_fail "Unknown chatgpt command: $subcommand"
      echo "Usage: pcli chatgpt login|status|apply|remove"
      exit 1
      ;;
  esac
}

base64_file_one_line() {
  local file="$1"
  if base64 --help 2>&1 | grep -q -- '-w'; then
    base64 -w 0 "$file"
  else
    base64 < "$file" | tr -d '\n'
  fi
}

cmd_chatgpt_login() {
  local force=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force)
        force=1
        shift
        ;;
      --help|-h)
        cmd_chatgpt help
        exit 0
        ;;
      *)
        echo_fail "Unknown flag: $1"
        exit 1
      ;;
    esac
  done

  if [[ "$force" -eq 0 ]]; then
    local status_resp status_parsed status_code status_body
    status_resp=$(secrets_api_call GET "/profile/codex-chatgpt-auth")
    status_parsed=$(parse_api_response "$status_resp")
    status_code=$(echo "$status_parsed" | head -1)
    status_body=$(echo "$status_parsed" | tail -n +2)
    if [[ "$status_code" == "200" ]] && echo "$status_body" | jq -e '.present == true' >/dev/null 2>&1; then
      echo_pass "Codex ChatGPT profile login is already saved"
      echo "  Use pcli chatgpt login --force to replace it, or pcli chatgpt apply <agent> to copy it."
      return 0
    fi
  fi

  if ! command -v codex >/dev/null 2>&1; then
    echo_fail "codex CLI is not installed or not on PATH"
    exit 1
  fi

  local tmpdir auth_file auth_json_b64
  tmpdir=$(mktemp -d)
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p "$tmpdir"
  printf 'cli_auth_credentials_store = "file"\n' > "$tmpdir/config.toml"

  echo_step "Starting Codex ChatGPT device auth"
  echo "  Follow the Codex prompt to open the OpenAI login page and enter the device code."
  if ! CODEX_HOME="$tmpdir" codex login --device-auth; then
    echo_fail "Codex device auth failed"
    exit 1
  fi
  if ! CODEX_HOME="$tmpdir" codex login status >/dev/null 2>&1; then
    echo_fail "Codex login status did not confirm an authenticated session"
    exit 1
  fi
  auth_file="$tmpdir/auth.json"
  if [[ ! -s "$auth_file" ]]; then
    echo_fail "Codex did not write $auth_file"
    exit 1
  fi
  if ! jq -e 'type == "object"' "$auth_file" >/dev/null 2>&1; then
    echo_fail "Codex wrote an invalid auth.json"
    exit 1
  fi

  auth_json_b64=$(base64_file_one_line "$auth_file")

  echo_step "Saving Codex ChatGPT login to your Palana profile"
  local body resp parsed status body_text
  body=$(jq -n --arg value "$auth_json_b64" '{value:$value}')
  resp=$(secrets_api_call PUT "/profile/secrets/codex-chatgpt-auth" "$body")
  parsed=$(parse_api_response "$resp")
  status=$(echo "$parsed" | head -1)
  body_text=$(echo "$parsed" | tail -n +2)
  if [[ "$status" == "200" ]]; then
    echo_pass "Codex ChatGPT profile login saved"
    echo "  Copy it to an agent with: pcli chatgpt apply <agent>"
  else
    echo_fail "Failed to save Codex ChatGPT login (HTTP $status)"
    [[ -n "$body_text" ]] && echo "$body_text"
    exit 1
  fi
}

cmd_chatgpt_status() {
  echo_step "Checking Codex ChatGPT profile login"
  local resp parsed status body_text
  resp=$(secrets_api_call GET "/profile/codex-chatgpt-auth")
  parsed=$(parse_api_response "$resp")
  status=$(echo "$parsed" | head -1)
  body_text=$(echo "$parsed" | tail -n +2)
  if [[ "$status" != "200" ]]; then
    echo_fail "Failed to list profile logins (HTTP $status)"
    [[ -n "$body_text" ]] && echo "$body_text"
    exit 1
  fi
  if echo "$body_text" | jq -e '.present == true' >/dev/null 2>&1; then
    echo_pass "Codex ChatGPT profile login is saved"
    local captured codex_version
    captured=$(echo "$body_text" | jq -r '.captured_at // empty')
    codex_version=$(echo "$body_text" | jq -r '.codex_version // empty')
    [[ -n "$captured" ]] && echo "  Captured: $captured"
    [[ -n "$codex_version" ]] && echo "  Codex: $codex_version"
  else
    echo_warn "Codex ChatGPT profile login is not saved"
    echo "  Add it with: pcli chatgpt login"
  fi
  return 0
}

cmd_chatgpt_apply() {
  local agent="" force=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=1; shift ;;
      --help|-h)
        echo "Usage: pcli chatgpt apply <agent> [--force]"
        exit 0
        ;;
      *)
        if [[ -z "$agent" ]]; then
          agent="$1"
        else
          echo_fail "Unexpected argument: $1"
          exit 1
        fi
        shift
        ;;
    esac
  done
  if [[ -z "$agent" ]]; then
    echo_fail "Usage: pcli chatgpt apply <agent> [--force]"
    exit 1
  fi
  local user
  user=$(get_effective_user_id)
  user=$(sanitize_user_id "$user")
  secrets_ownership_check "$agent" "$user"
  secrets_copy_from_profile "$agent" "codex-chatgpt-auth" "$force"
}

cmd_chatgpt_remove() {
  echo_step "Removing Codex ChatGPT profile login"
  local resp parsed status body_text
  resp=$(secrets_api_call DELETE "/profile/secrets/codex-chatgpt-auth")
  parsed=$(parse_api_response "$resp")
  status=$(echo "$parsed" | head -1)
  body_text=$(echo "$parsed" | tail -n +2)
  if [[ "$status" == "200" ]]; then
    echo_pass "Codex ChatGPT profile login removed"
  else
    echo_fail "Failed to remove Codex ChatGPT profile login (HTTP $status)"
    [[ -n "$body_text" ]] && echo "$body_text"
    exit 1
  fi
}

# Cluster - info and set remote
PALANA_REMOTE_CONTEXT="palana-eks-remote"
PALANA_KUBE_CONTEXT="palana-eks-remote"
REMOTE_CONTEXT_FILE="$HOME/.palana/remote-context"

get_remote_context() {
  if [[ -f "$REMOTE_CONTEXT_FILE" ]]; then
    cat "$REMOTE_CONTEXT_FILE" 2>/dev/null | tr -d '\n'
    return
  fi
  local candidates
  candidates=$(kubectl config get-contexts -o name 2>/dev/null | grep -E "palana|eks" || true)
  local first
  first=$(echo "$candidates" | head -1)
  local rest
  rest=$(echo "$candidates" | tail -n +2 | grep -c . 2>/dev/null || echo 0)
  if [[ -n "$first" && "$rest" -eq 0 ]]; then
    echo -n "$first"
  fi
}

cmd_cluster_info() {
  local ctx
  ctx=$(kubectl config current-context 2>/dev/null)
  if [[ -z "$ctx" ]]; then
    echo_fail "No kubectl context set. Run: pcli preflight"
    exit 1
  fi

  echo "Current cluster: $ctx"
  local server
  server=$(kubectl config view -o jsonpath="{.contexts[?(@.name==\"$ctx\")].context.cluster}" 2>/dev/null | xargs -I{} kubectl config view -o jsonpath="{.clusters[?(@.name==\"{}\")].cluster.server}" 2>/dev/null)
  if [[ -n "$server" ]]; then
    echo "  Server: $server"
  fi
}

cmd_cluster_set_remote() {
  local ctx="$1"
  if [[ -z "$ctx" ]]; then
    ctx=$(get_remote_context)
  fi
  if [[ -z "$ctx" ]]; then
    echo_fail "Remote context not found"
    echo "Run 'pcli preflight' to configure the cluster, or:"
    echo "  pcli cluster set remote <context-name>"
    echo ""
    echo "Available contexts:"
    kubectl config get-contexts -o name 2>/dev/null | sed 's/^/  /'
    exit 1
  fi
  if ! kubectl config get-contexts "$ctx" --no-headers 2>/dev/null | grep -q .; then
    echo_fail "Context not found: $ctx"
    exit 1
  fi
  mkdir -p "$(dirname "$REMOTE_CONTEXT_FILE")"
  echo -n "$ctx" > "$REMOTE_CONTEXT_FILE"
  kubectl config use-context "$ctx"
  echo_pass "Switched to remote cluster ($ctx)"
}

cmd_cluster() {
  local sub="$1"
  shift || true
  case "$sub" in
    info)
      cmd_cluster_info "$@"
      ;;
    set)
      local target="$1"
      shift || true
      case "$target" in
        remote)
          cmd_cluster_set_remote "$@"
          ;;
        *)
          echo_fail "Usage: pcli cluster set remote [context-name]"
          exit 1
          ;;
      esac
      ;;
    *)
      echo_fail "Usage: pcli cluster info|set remote [context-name]"
      echo ""
      echo "  cluster info           Show current cluster"
      echo "  cluster set remote     Switch to remote EKS cluster"
      echo "  cluster set remote X   Switch to remote and save context X for next time"
      exit 1
      ;;
  esac
}

ensure_palana_context() {
  local ctx
  ctx=$(kubectl config current-context 2>/dev/null || true)
  if [[ "$ctx" == "$PALANA_REMOTE_CONTEXT" ]]; then
    return
  fi

  if kubectl config get-contexts "$PALANA_REMOTE_CONTEXT" --no-headers 2>/dev/null | grep -q .; then
    kubectl config use-context "$PALANA_REMOTE_CONTEXT" 1>/dev/null
  else
    echo_fail "Remote context '$PALANA_REMOTE_CONTEXT' not found. Run 'pcli preflight' to configure it."
    exit 1
  fi
}

# Observability dashboard
cmd_observability() {
  local port=8080
  local port_forward=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --port-forward)
        port_forward=1
        shift
        ;;
      [0-9]*)
        port=$1
        shift
        ;;
      *)
        shift
        ;;
    esac
  done

  if ! kubectl get deployment observability-api -n observability &>/dev/null; then
    echo_fail "Observability API not found."
    exit 1
  fi

  # Primary: use IngressRoute if available
  local ingress_route=""
  if [[ -z "$port_forward" ]] && kubectl get crd ingressroutes.traefik.io &>/dev/null; then
    ingress_route=$(kubectl get ingressroute observability -n observability -o jsonpath='{.spec.routes[0].match}' 2>/dev/null || true)
  fi

  if [[ -n "$port_forward" ]] || [[ -z "$ingress_route" ]]; then
    echo_step "Starting observability dashboard on http://localhost:$port (port-forward)"
    echo "  Press Ctrl+C to stop"
    echo ""
    kubectl port-forward -n observability svc/observability-api "${port}:8080"
    return
  fi

  # Ingress available: print URL
  local domain="${AGENT_INGRESS_DOMAIN:-${INGRESS_DOMAIN:-}}"
  if [[ -n "$domain" ]]; then
    echo_pass "Observability: https://observability.${domain}"
  else
    echo_pass "Observability: IngressRoute present (set AGENT_INGRESS_DOMAIN for URL)"
  fi
  echo ""
  echo "To use port-forward instead: pcli observability --port-forward [port]"
}

cmd_blocks() {
  local name="${1:-}"
  if [[ -z "$name" || "$name" == "--help" || "$name" == "-h" ]]; then
    echo "Usage: pcli blocks <agent-name>"
    echo ""
    echo "Show proxy, network, and runtime blocks for an agent in the last 24 hours."
    echo "Platform-blocked hosts cannot be overridden by user policy."
    echo ""
    echo "Examples:"
    echo "  pcli blocks demo"
    exit 0
  fi

  check_credentials

  local user
  user=$(get_effective_user_id)
  local sanitized
  sanitized=$(sanitize_user_id "$user")

  local response
  response=$(obs_api_call GET "/api/v1/agents/${sanitized}/${name}/blocks")
  local parsed status body_text
  parsed=$(parse_api_response "$response")
  status=$(echo "$parsed" | head -1)
  body_text=$(echo "$parsed" | tail -n +2)

  if [[ "$status" -lt 200 || "$status" -ge 300 ]]; then
    echo_fail "Failed to fetch blocks (HTTP $status): $body_text"
    exit 1
  fi

  local proxy_count network_count runtime_count total
  proxy_count=$(echo "$body_text" | jq '.proxy_blocks | length')
  network_count=$(echo "$body_text" | jq '.network_blocks | length')
  runtime_count=$(echo "$body_text" | jq '.runtime_blocks | length')
  total=$((proxy_count + network_count + runtime_count))

  echo ""
  echo "Blocks for '${name}' (last 24h):"
  echo ""

  if [[ "$proxy_count" -gt 0 ]]; then
    echo "HTTP Proxy Blocks:"
    printf "  %-35s %-8s %6s  %-20s  %s\n" "HOST" "METHOD" "COUNT" "LAST SEEN" "ACTION"
    echo "$body_text" | jq -r '.proxy_blocks[] | [.host, (.method // "any"), (.count | tostring), .last_seen, (.platform_blocked | tostring)] | @tsv' | while IFS=$'\t' read -r host method count last_seen platform; do
      local ts=""
      if [[ -n "$last_seen" ]]; then
        ts=$(date -u -d "${last_seen%%.*}" "+%Y-%m-%d %H:%M UTC" 2>/dev/null || date -u -j -f "%Y-%m-%dT%H:%M:%S" "${last_seen%%.*}" "+%Y-%m-%d %H:%M UTC" 2>/dev/null || echo "$last_seen")
      fi
      local action=""
      if [[ "$platform" == "true" ]]; then
        action="Platform policy (cannot override)"
      else
        action="pcli policy allow ${name} ${host}"
      fi
      printf "  %-35s %-8s %6s  %-20s  %s\n" "$host" "$method" "$count" "$ts" "$action"
    done
    echo ""
  fi

  if [[ "$network_count" -gt 0 ]]; then
    echo "Network Drops (Cilium):"
    printf "  %-20s %6s  %-5s  %6s  %s\n" "DESTINATION" "PORT" "PROTO" "COUNT" "REASON"
    echo "$body_text" | jq -r '.network_blocks[] | [.destination, ((.port // 0) | tostring), (.protocol // "TCP"), (.count | tostring), (.drop_reason // "")] | @tsv' | while IFS=$'\t' read -r dest port proto count reason; do
      printf "  %-20s %6s  %-5s  %6s  %s\n" "$dest" "$port" "$proto" "$count" "$reason"
    done
    echo ""
  fi

  if [[ "$runtime_count" -gt 0 ]]; then
    echo "Runtime Denials (Tetragon):"
    printf "  %-32s %-20s %-22s %6s  %-20s\n" "POD" "BINARY" "CAPABILITY" "COUNT" "LAST SEEN"
    echo "$body_text" | jq -r '.runtime_blocks[] | [.pod, .binary, .capability, (.count | tostring), .last_seen] | @tsv' | while IFS=$'\t' read -r pod binary capability count last_seen; do
      local ts=""
      if [[ -n "$last_seen" ]]; then
        ts=$(date -u -d "${last_seen%%.*}" "+%Y-%m-%d %H:%M UTC" 2>/dev/null || date -u -j -f "%Y-%m-%dT%H:%M:%S" "${last_seen%%.*}" "+%Y-%m-%d %H:%M UTC" 2>/dev/null || echo "$last_seen")
      fi
      printf "  %-32s %-20s %-22s %6s  %-20s\n" "$pod" "$binary" "$capability" "$count" "$ts"
    done
    echo ""
  fi

  if [[ "$total" -eq 0 ]]; then
    echo_pass "No blocks in the last 24 hours."
  else
    echo "Total: ${total} block(s)"
  fi
}

cmd_policy() {
  local subcommand=$1
  shift || true

  if [[ "$subcommand" == "--help" || "$subcommand" == "-h" ]]; then
    echo "Usage:"
    echo "  pcli policy set <agent> --allow HOST [--allow HOST ...]"
