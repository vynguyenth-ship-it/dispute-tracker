# Call agent-api HTTP endpoint with OAuth bearer token
# Retries once on 5xx or connection failure (000) to tolerate rolling updates
api_call() {
  local method="$1" path="$2" data="${3:-}"
  local api_url
  api_url=$(get_agent_api_url)
  local token
  token=$(get_oauth_token)
  if [[ -z "$token" ]]; then
    echo_fail "No OAuth token found. Run: pcli login"
    exit 1
  fi

  local curl_args=(-s -w "\n%{http_code}" -H "Authorization: Bearer $token" -H "Content-Type: application/json")
  if [[ "$api_url" == http://127.0.0.1* || "$api_url" == http://localhost* || "$api_url" == http://[::1]* ]]; then
    local user
    user=$(get_oauth_email)
    curl_args+=(-H "X-Auth-Request-Email: $user")
  fi
  if [[ -n "${PCLI_ON_BEHALF_OF:-}" ]]; then
    curl_args+=(-H "X-On-Behalf-Of: $PCLI_ON_BEHALF_OF")
    if [[ -n "${PCLI_IR_TICKET:-}" ]]; then
      curl_args+=(-H "X-IR-Ticket: $PCLI_IR_TICKET")
    fi
    if [[ -n "${PCLI_IR_REASON:-}" ]]; then
      curl_args+=(-H "X-IR-Reason: $PCLI_IR_REASON")
    fi
  fi
  if [[ -n "$data" ]]; then
    curl_args+=(-d "$data")
  fi

  local response status attempt
  for attempt in 1 2; do
    response=$(curl "${curl_args[@]}" -X "$method" "${api_url}${path}")
    status=$(echo "$response" | tail -1)
    if [[ "$status" != "000" && "$status" -lt 500 ]]; then
      echo "$response"
      return
    fi
    if [[ $attempt -lt 2 ]]; then
      sleep 3
    fi
  done
  echo "$response"
}

