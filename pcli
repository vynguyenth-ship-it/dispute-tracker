# Auth-wrapped kubectl passthrough
cmd_kube() {
  if contains_help "$@"; then
    echo "Usage: pcli kube [kubectl-args...]"
    echo ""
    echo "Runs kubectl with automatic OAuth token refresh."
    echo "Use for low-level operations not covered by other pcli commands."
    echo ""
    echo "Examples:"
    echo "  pcli kube get namespaces"
    echo "  pcli kube get networkpolicy agent-isolation -n <ns> -o yaml"
    echo "  pcli kube rollout status deployment/<name> -n <ns>"
    exit 0
  fi
  check_credentials
  kubectl "$@"
}

