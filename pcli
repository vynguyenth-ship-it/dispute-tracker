  echo "$status"
  echo "$body"
}

cmd_push() {
  if contains_help "$@"; then
    echo "Usage: pcli push <local-image> [--name <name>] [--tag <tag>]"
    echo ""
    echo "Push a local Docker image to your personal ECR repository and"
    echo "optionally register it as a launchable template."
    echo ""
    echo "Options:"
    echo "  --name NAME    ECR repository name (default: derived from image name)"
    echo "  --tag TAG      Image tag (default: latest)"
    echo ""
    echo "Options:"
    echo "  --name <name>      ECR repository name (default: derived from image)"
    echo "  --tag <tag>        Image tag (default: latest)"
    echo "  --no-register      Skip template registration prompt"
    echo ""
    echo "Example:"
    echo "  pcli push my-agent:latest"
    echo "  pcli push my-agent:v1 --name my-agent --tag v1"
    exit 0
  fi

  local local_image="$1"
  shift || true
  if [[ -z "$local_image" ]]; then
    echo_fail "Usage: pcli push <local-image> [--name <name>] [--tag <tag>]"
    exit 1
  fi

  local image_name="" image_tag="latest" no_register=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name) image_name="$2"; shift 2 ;;
      --tag) image_tag="$2"; shift 2 ;;
      --no-register) no_register=1; shift ;;
      *) echo_fail "Unknown option: $1"; exit 1 ;;
    esac
  done

  # Derive image name from local image if not specified
  if [[ -z "$image_name" ]]; then
    image_name="${local_image%%:*}"
    image_name="${image_name##*/}"  # strip registry prefix if any
    image_name=$(echo "$image_name" | tr '[:upper:]' '[:lower:]' | tr '_.' '-')
  fi
  # Derive tag from local image if it has one and --tag wasn't specified
  if [[ "$local_image" == *":"* && "$image_tag" == "latest" ]]; then
    image_tag="${local_image##*:}"
  fi

  echo_step "Requesting ECR credentials for image: $image_name"
  local response
  response=$(api_call POST "/api/v1/ecr/credentials" "{\"image_name\": \"$image_name\"}")
  local status body
  status=$(echo "$response" | tail -1)
  body=$(echo "$response" | sed '$d')

  if [[ "$status" != "200" ]]; then
    local err
    err=$(echo "$body" | jq -r '.error // "unknown error"' 2>/dev/null || echo "$body")
    echo_fail "Failed to get ECR credentials: $err (HTTP $status)"
    exit 1
  fi

  local registry repository access_key secret_key session_token region
  registry=$(echo "$body" | jq -r '.registry')
  repository=$(echo "$body" | jq -r '.repository')
  access_key=$(echo "$body" | jq -r '.access_key_id')
  secret_key=$(echo "$body" | jq -r '.secret_access_key')
  session_token=$(echo "$body" | jq -r '.session_token')
  region=$(echo "$body" | jq -r '.region')

  echo_pass "ECR credentials received (15-min TTL)"
  echo "  Registry:   $registry"
  echo "  Repository: $repository"

  echo_step "Preparing isolated Docker credentials for ECR"
  local docker_config_dir
  if ! docker_config_dir=$(create_ecr_docker_config "$registry" "$region" "$access_key" "$secret_key" "$session_token"); then
    echo_fail "Failed to prepare Docker credentials for ECR"
    exit 1
  fi
  trap 'rm -rf "$docker_config_dir"; trap - RETURN' RETURN
  echo_pass "Docker credentials ready"

  local full_image="${registry}/${repository}:${image_tag}"
  echo_step "Building and pushing multi-arch (amd64+arm64) to ECR: $local_image → $full_image"
  if ! printf "FROM %s\n" "$local_image" | \
    DOCKER_CONFIG="$docker_config_dir" docker buildx build --platform linux/amd64,linux/arm64 \
      --push \
      --tag "$full_image" \
      - 2>&1; then
    rm -rf "$docker_config_dir"
    trap - RETURN
    echo_fail "Failed to build and push image"
    exit 1
  fi
  rm -rf "$docker_config_dir"
  trap - RETURN
  echo_pass "Image pushed successfully"

  # Offer to register as template (skip in non-interactive or --no-register mode)
  if [[ "$no_register" -eq 1 || "$PCLI_INTERACTIVE" -eq 0 ]]; then
    echo_pass "Done. Image available at: $full_image"
    echo ""
    echo "  Deploy with:  pcli run <agent> user/${image_name}"
    return
  fi
  echo ""
  read -r -p "Register as launchable template? [Y/n] " register_answer
  if [[ "$register_answer" =~ ^[Nn] ]]; then
    echo_pass "Done. Image available at: $full_image"
    echo ""
    echo "  Deploy with:  pcli run <agent> user/${image_name}"
    return
  fi

  local display_name="" description="" web_port="0" cpu="1000m" memory="2048Mi"
  read -r -p "Display name [$image_name]: " display_name
  display_name="${display_name:-$image_name}"
  read -r -p "Description: " description
  read -r -p "Web port (0 for none) [0]: " web_port
  web_port="${web_port:-0}"
  read -r -p "CPU [$cpu]: " cpu_input
  cpu="${cpu_input:-$cpu}"
  read -r -p "Memory [$memory]: " memory_input
  memory="${memory_input:-$memory}"

  local web_enabled="false"
  [[ "$web_port" != "0" ]] && web_enabled="true"

  local manifest_json
  manifest_json=$(cat <<EOFMANIFEST
{
  "metadata": {
    "name": "$image_name",
    "display_name": "$display_name",
    "description": "$description"
  },
  "container": {
    "image": "$full_image"
  },
  "resources": {
    "cpu": "$cpu",
    "memory": "$memory"
  },
  "web": {
    "enabled": $web_enabled,
    "port": $web_port
  },
  "storage": {
    "enabled": false
  },
  "secrets": []
}
EOFMANIFEST
  )

  echo_step "Registering template: $image_name"
  response=$(api_call POST "/api/v1/user-templates" "$manifest_json")
  status=$(echo "$response" | tail -1)
  body=$(echo "$response" | sed '$d')

  if [[ "$status" == "201" ]]; then
    echo_pass "Template registered!"
    echo ""
    echo "  Deploy with:  pcli run <agent> user/${image_name}"
  else
    local err
    err=$(echo "$body" | jq -r '.error // "unknown error"' 2>/dev/null || echo "$body")
    echo_fail "Failed to register template: $err (HTTP $status)"
  fi
}

