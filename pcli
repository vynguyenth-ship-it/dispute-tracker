  echo ""
  echo_pass "Preflight complete!"
  echo ""
  echo "Next steps:"
  echo "  1. Authenticate:   pcli login"
  echo "  2. Create agent:   pcli create demo"
  echo "  3. List agents:    pcli list"
}

# Create agent
cmd_create() {
  if contains_help "$@"; then
    echo "Usage: pcli create <agent-name> [cpu] [memory] [storage] [pods] [--debug]"
    echo ""
    echo "Options:"
    echo "  --template NAME  Agent template (default: 'default'). Run 'pcli templates' to list."
    echo "  --ssh-mode MODE  SSH access: off|sidecar|direct (default: off)"
    echo "                   Note: enabling SSH after creation will restart your agent."
    echo "  --artifact-fs    Enable the artifact-fs lazy-mount capability. The agent comes up"
    echo "                   with /data/code/<repo> populated by the artifact-fs CSI driver if"
    echo "                   you also set 'gitlab_project_path' (group/repo) via"
    echo "                   'pcli secrets agent set'. Launch-time only — cannot be flipped"
    echo "                   on an existing agent."
    echo "  --debug          Show full agent details (kubectl describe output)"
    exit 0
  fi

  check_credentials
  check_manifest_staleness

  local debug=0
  local template=""
  local ssh_mode="off"
  local artifact_fs="false"
  local filtered_args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --debug) debug=1; shift ;;
      --template) template="$2"; shift 2 ;;
      --ssh-mode) ssh_mode="$2"; shift 2 ;;
      --artifact-fs) artifact_fs="true"; shift ;;
      *) filtered_args+=("$1"); shift ;;
    esac
  done
  set -- "${filtered_args[@]}"

  local name=$1
  local explicit_cpu=${2:-}
  local explicit_memory=${3:-}
  local explicit_storage=${4:-}
  local explicit_pods=${5:-}

  if [[ -z "$name" ]]; then
    echo_fail "Usage: pcli create <agent-name> --template <template> [cpu] [memory] [storage] [pods] [--debug]"
    exit 1
  fi

  validate_cpu_milli "$explicit_cpu" || exit 1
  validate_memory_mi "$explicit_memory" || exit 1

  # Resolve template: explicit flag > manifest matching agent name > default > error
  if [[ -z "$template" ]]; then
    if [[ -n "$(resolve_manifest "$name")" ]]; then
      template="$name"
    elif [[ -n "$(resolve_manifest "default")" ]]; then
      template="default"
      echo "  No --template specified — using default template."
      echo "  Run 'pcli templates' to see all options, or pass --template <name> to override."
    else
      echo_fail "No template specified and no manifest matching '${name}' found."
      echo "  Run 'pcli preflight' to set up a default template, or specify one:"
      for f in "$MANIFESTS_DIR"/*.yaml "$USER_MANIFESTS_DIR"/*.yaml "$HOME_USER_MANIFESTS_DIR"/*.yaml "$HOME_MANIFESTS_DIR"/*.yaml; do
        [[ -f "$f" ]] && echo "    $(basename "$f" .yaml)"
      done
      echo ""
      echo "  Usage: pcli create ${name} --template <template>"
      exit 1
    fi
  elif [[ -z "$(resolve_manifest "$template")" ]]; then
    echo_fail "Unknown template '${template}'. Available:"
    for f in "$MANIFESTS_DIR"/*.yaml "$USER_MANIFESTS_DIR"/*.yaml "$HOME_USER_MANIFESTS_DIR"/*.yaml "$HOME_MANIFESTS_DIR"/*.yaml; do
      [[ -f "$f" ]] && echo "    $(basename "$f" .yaml)"
    done
    exit 1
  fi

  # A local manifest can exist without being registered server-side. Without
  # this check, agent-api accepts any template name as a string and writes it
  # as a metadata annotation — producing the portal "manifest missing" banner
  # and a confusing recovery path. Push + register is what binds a local
  # manifest to the platform.
  local templates_response templates_body templates_status
  templates_response=$(api_call GET "/api/v1/templates")
  templates_status=$(echo "$templates_response" | tail -1)
  templates_body=$(echo "$templates_response" | sed '$d')
  if [[ "$templates_status" == "200" ]]; then
    if ! echo "$templates_body" | jq -e --arg t "$template" 'map(.name) | index($t) != null' >/dev/null 2>&1; then
      local registered
      registered=$(echo "$templates_body" | jq -r 'map(.name) | join(", ")' 2>/dev/null || echo "")
      echo_fail "Template '${template}' is not registered on this platform."
      echo ""
      echo "  Registered templates: ${registered}"
      echo ""
      echo "  If this is a custom template you have locally, push and register it first:"
      echo "    pcli push <build-dir>"
      echo "    pcli register <ecr-image>"
      echo ""
      echo "  Then re-run: pcli create ${name} --template ${template}"
      exit 1
    fi
  fi

  # Read resource defaults from manifest (explicit args override)
  local cpu=${explicit_cpu:-1000}
  local memory=${explicit_memory:-2048}
  local storage=${explicit_storage:-5}
  local pods=${explicit_pods:-20}
  if [[ -n "$(resolve_manifest "$template")" ]]; then
    local m_cpu=$(manifest_field "$template" "resources.cpu")
    local m_memory=$(manifest_field "$template" "resources.memory")
    local m_storage=$(manifest_field "$template" "storage.size")
    [[ -z "$explicit_cpu" && -n "$m_cpu" ]] && cpu="${m_cpu%m}"
    [[ -z "$explicit_memory" && -n "$m_memory" ]] && memory="${m_memory%Mi}"
    [[ -z "$explicit_storage" && -n "$m_storage" ]] && storage="${m_storage%Gi}"
  fi

  local user=$(get_effective_user_id)

  echo_step "Creating agent: $(sanitize_user_id "$user")/$name (template: $template)"
  echo "  CPU: ${cpu}m, Memory: ${memory}Mi, Storage: ${storage}GB, Pods: ${pods}"

  local req_body
  req_body=$(jq -n \
    --arg name "$name" \
    --arg template "$template" \
    --arg cpu "$cpu" \
    --arg memory "$memory" \
    --arg storage "$storage" \
    --arg ssh "$ssh_mode" \
    --argjson pods "$pods" \
    --argjson artifact_fs "$artifact_fs" \
    '{name:$name, template:$template, cpu_limit:$cpu, memory_limit:$memory, storage_size:$storage, pod_limit:$pods, ssh_mode:$ssh, artifact_fs_enabled:$artifact_fs}')

  if [[ "$artifact_fs" == "true" ]]; then
    echo "  artifact-fs: enabled (set gitlab_project_path via 'pcli secrets agent set' to choose the repo)"
  fi

  local response status body
  response=$(api_call POST "/api/v1/agents" "$req_body")
  status=$(echo "$response" | tail -1)
  body=$(echo "$response" | sed '$d')

  if [[ "$status" == "409" ]]; then
    echo_warn "Agent already exists, continuing..."
  elif [[ "$status" != "200" && "$status" != "201" ]]; then
    local err
    err=$(echo "$body" | jq -r '.error // "unknown error"' 2>/dev/null || echo "$body")
    echo_fail "Create failed: $err (HTTP $status)"
    exit 1
  else
    echo_pass "Agent created"
  fi

  echo_step "Waiting for agent to be ready..."
  local deadline=$(( $(date +%s) + 120 ))
  local ready="false" phase="" agent_ns="" poll_body=""
  while [[ $(date +%s) -lt $deadline ]]; do
    sleep 2
    local poll_resp poll_status
    poll_resp=$(api_call GET "/api/v1/agents/$name")
    poll_status=$(echo "$poll_resp" | tail -1)
    poll_body=$(echo "$poll_resp" | sed '$d')
    [[ "$poll_status" != "200" ]] && continue
    ready=$(echo "$poll_body" | jq -r '.ready // false' 2>/dev/null)
    phase=$(echo "$poll_body" | jq -r '.phase // ""' 2>/dev/null)
    agent_ns=$(echo "$poll_body" | jq -r '.namespace // ""' 2>/dev/null)
    [[ "$ready" == "true" ]] && break
    [[ "$phase" == "Failed" ]] && break
  done

  if [[ "$ready" != "true" ]]; then
    echo ""
    echo_fail "Agent not ready within 120s: $user/$name (phase: ${phase:-unknown})"
    echo ""
    echo "Latest status — run 'pcli describe $name' for full details."
    exit 1
  fi

  echo ""
  echo_pass "Agent $user/$name is ready!"
  [[ -n "$agent_ns" ]] && echo "  Namespace: $agent_ns"

  if [[ $debug -eq 1 ]]; then
    echo ""
    echo "Agent details:"
    local d_resp d_body
    d_resp=$(api_call GET "/api/v1/agents/${name}/describe")
    d_body=$(echo "$d_resp" | sed '$d')
    if command -v yq &>/dev/null; then
      echo "$d_body" | yq -P
    else
      echo "$d_body" | jq .
    fi
  fi
}

# cts-aergia: spin up (or check) the user's routed Slack agent, no Slack
# tokens required from the user. Behind the scenes this is just `pcli create`
# with --template cts-aergia, but it surfaces a friendlier prompt and a
# status command that adds Slack-side context.
cmd_cts_aergia() {
  if contains_help "$@"; then
    echo "Usage: pcli cts-aergia <subcommand>"
    echo ""
    echo "Subcommands:"
    echo "  init     Create your cts-aergia agent (idempotent; safe to re-run)"
    echo "  status   Show pod readiness + whether you've completed Slack-bind"
    exit 0
  fi
  local sub="${1:-init}"; shift || true
  case "$sub" in
    init)
      check_credentials
      local user=$(get_effective_user_id)
      local existing
      existing=$(api_call GET "/api/v1/agents/cts-aergia" "" 2>/dev/null || true)
      if [[ -n "$existing" ]] && echo "$existing" | jq -e '.ready == true' >/dev/null 2>&1; then
        echo "✓ cts-aergia already exists and is ready for $(sanitize_user_id "$user")"
        echo "  In Slack, DM @aergia to start a conversation."
        return 0
      fi
      cmd_create cts-aergia --template cts-aergia "$@"
      echo ""
      echo "✓ cts-aergia ready"
      echo "  In Slack, DM @aergia — the first message will pair your Slack and Palana identities."
      ;;
    status)
      check_credentials
      local body status_code
      body=$(api_call GET "/api/v1/agents/cts-aergia" "" 2>/dev/null || true)
      if [[ -z "$body" ]]; then
        echo "cts-aergia agent not found for $(sanitize_user_id "$(get_effective_user_id)"). Run: pcli cts-aergia init"
        return 0
      fi
      echo "$body" | jq -r '"Agent:    cts-aergia\nReady:    \(.ready)\nPhase:    \(.phase // "—")\nLast activity: \(.last_activity_at // "—")"'
      ;;
    *)
      echo_fail "Unknown subcommand: $sub"
      echo "Usage: pcli cts-aergia <init|status>"
      exit 1
      ;;
  esac
}

# Delete agent
cmd_delete() {
  if contains_help "$@"; then
    echo "Usage: pcli delete <agent-name>"
    exit 0
  fi

  check_credentials

  local name=$1

  if [[ -z "$name" ]]; then
    echo_fail "Usage: pcli delete <agent-name>"
    exit 1
  fi

  local user=$(get_effective_user_id)

  echo_step "Deleting agent: $user/$name"

  local response status body
  response=$(api_call DELETE "/api/v1/agents/$name")
  status=$(echo "$response" | tail -1)
  body=$(echo "$response" | sed '$d')

  if [[ "$status" == "404" ]]; then
    echo_fail "Agent not found: $name"
    exit 1
  fi
  if [[ "$status" != "200" ]]; then
    local err
    err=$(echo "$body" | jq -r '.error // "unknown error"' 2>/dev/null || echo "$body")
    echo_fail "Delete failed: $err (HTTP $status)"
    exit 1
  fi
  echo_pass "Agent deleted: $user/$name (operator will clean up namespace)"
}

# List agents
# Shows spec.agent_name (the name to use in CLI commands) - not metadata.name which varies by creation method
cmd_list() {
  if contains_help "$@"; then
    echo "Usage: pcli list [--all]"
    echo ""
    echo "List your agents. Use --all to list all agents (admin only)."
    exit 0
  fi

  check_credentials

  local show_all=0
  for arg in "$@"; do
    [[ "$arg" == "--all" ]] && show_all=1
  done

  local path="/api/v1/agents"
  [[ "$show_all" == "1" ]] && path="${path}?all=true"

  local response status body
  response=$(api_call GET "$path")
  status=$(echo "$response" | tail -1)
  body=$(echo "$response" | sed '$d')

  if [[ "$status" == "403" ]]; then
    echo_fail "Admin group membership required for --all"
    exit 1
  fi
  if [[ "$status" != "200" ]]; then
    local err
    err=$(echo "$body" | jq -r '.error // "unknown error"' 2>/dev/null || echo "$body")
    echo_fail "Failed to list agents: $err (HTTP $status)"
    exit 1
  fi

  echo ""
  echo "Agents (use AGENT name in pcli commands):"

  local count
  count=$(echo "$body" | jq 'length' 2>/dev/null || echo 0)
  if [[ "$count" == "0" ]]; then
    if [[ "$show_all" == "1" ]]; then
      echo "  (No agents)"
    else
      echo "  (No agents created yet — run 'pcli create <name>' to get started)"
    fi
    return
  fi

  format_tsv() {
    awk -F'\t' '
      { for (i=1; i<=NF; i++) { if (length($i) > maxlen[i]) maxlen[i]=length($i) } rows[NR]=$0 }
      END { for (r=1; r<=NR; r++) { n=split(rows[r],f,"\t"); for (i=1; i<=n; i++) printf "%-*s",maxlen[i]+2,f[i]; print "" } }
    '
  }

  if [[ "$show_all" == "1" ]]; then
    { echo -e "AGENT\tUSER\tPHASE\tREADY\tNAMESPACE\tAGE"
      echo "$body" | jq -r '.[] | [.name, .user_id, (.phase // "-"), (.ready // false | tostring), (.namespace // "-"), (.created_at // "-")] | @tsv'
    } | format_tsv
  else
    { echo -e "AGENT\tPHASE\tREADY\tNAMESPACE\tAGE"
      echo "$body" | jq -r '.[] | [.name, (.phase // "-"), (.ready // false | tostring), (.namespace // "-"), (.created_at // "-")] | @tsv'
    } | format_tsv
  fi
}

# Describe agent
cmd_describe() {
  if contains_help "$@"; then
    echo "Usage: pcli describe <agent-name>"
    exit 0
  fi

  check_credentials

  local name=$1

  if [[ -z "$name" ]]; then
    echo_fail "Usage: pcli describe <agent-name>"
    exit 1
  fi

  local response status body
  response=$(api_call GET "/api/v1/agents/${name}/describe")
  status=$(echo "$response" | tail -1)
  body=$(echo "$response" | sed '$d')

  if [[ "$status" == "404" ]]; then
    echo_fail "Agent not found: $name (run 'pcli list' to see agent names)"
    exit 1
  fi
  if [[ "$status" != "200" ]]; then
    local err
    err=$(echo "$body" | jq -r '.error // "unknown error"' 2>/dev/null || echo "$body")
    echo_fail "Failed to describe agent: $err (HTTP $status)"
    exit 1
  fi

  echo ""
  if command -v yq &>/dev/null; then
    echo "$body" | yq -P
  else
    echo "$body" | jq .
  fi
}

# Deploy workload
cmd_deploy() {
  if contains_help "$@"; then
    echo "Usage: pcli deploy <agent-name> <deployment-yaml>"
    echo ""
    echo "Applies YAML resources into the agent's namespace via agent-api."
    echo "Allowed kinds: Deployment, StatefulSet, Service, ConfigMap, PVC,"
    echo "Pod, Ingress, IngressRoute."
    exit 0
  fi

  check_credentials

  local name=$1
  local yaml_file=$2

  if [[ -z "$name" || -z "$yaml_file" ]]; then
    echo_fail "Usage: pcli deploy <agent-name> <deployment-yaml>"
    exit 1
  fi

  if [[ ! -f "$yaml_file" ]]; then
    echo_fail "File not found: $yaml_file"
    exit 1
  fi

  echo_step "Applying $yaml_file to agent $name"

  local yaml_body response status body
  yaml_body=$(cat "$yaml_file")
  response=$(api_call POST "/api/v1/agents/${name}/apply" "$yaml_body")
  status=$(echo "$response" | tail -1)
  body=$(echo "$response" | sed '$d')

  if [[ "$status" != "200" ]]; then
    local err
    err=$(echo "$body" | jq -r '.error // "unknown error"' 2>/dev/null || echo "$body")
    echo_fail "Deploy failed: $err (HTTP $status)"
    exit 1
  fi

  echo "$body" | jq -r '.applied[]?' 2>/dev/null | sed 's/^/  /'
  local warnings
  warnings=$(echo "$body" | jq -r '.warnings[]?' 2>/dev/null)
  if [[ -n "$warnings" ]]; then
    while IFS= read -r w; do
      echo_warn "$w"
    done <<< "$warnings"
  fi
  echo_pass "Deployment submitted!"
}

# --- Manifest support ---

MANIFESTS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/build/manifests"
USER_MANIFESTS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/build/user-manifests"
HOME_USER_MANIFESTS_DIR="$HOME/.palana/build/user-manifests"
HOME_MANIFESTS_DIR="$HOME/.palana/build/manifests"

# Resolve manifest file path: repo system > repo user > home user > home system (synced)
resolve_manifest() {
  local name="$1"
  local dir
  for dir in "$MANIFESTS_DIR" "$USER_MANIFESTS_DIR" "$HOME_USER_MANIFESTS_DIR" "$HOME_MANIFESTS_DIR"; do
    if [[ -f "$dir/${name}.yaml" ]]; then
      echo "$dir/${name}.yaml"
      return
    fi
  done
}

# Read a field from a manifest YAML file using yq or grep fallback
# Usage: manifest_field <manifest-name> <field-path>
# Example: manifest_field opencode "metadata.name"
manifest_field() {
  local manifest
  manifest=$(resolve_manifest "$1")
  if [[ -z "$manifest" ]]; then
    echo_fail "Manifest not found: $1 (checked $MANIFESTS_DIR, $USER_MANIFESTS_DIR, $HOME_USER_MANIFESTS_DIR, and $HOME_MANIFESTS_DIR)"
    exit 1
  fi
  local field="$2"
  if command -v yq &>/dev/null; then
    yq -r ".$field // \"\"" "$manifest" 2>/dev/null
  else
    # Simple fallback for flat fields - handles "key: value" format
    # For nested fields like metadata.name, flatten with dot notation
    local parts
    IFS=. read -r -a parts <<< "$field"
    if [[ ${#parts[@]} -eq 1 ]]; then
      grep "^${parts[0]}:" "$manifest" 2>/dev/null | head -1 | sed 's/^[^:]*: *//' | sed 's/^["'"'"']//;s/["'"'"']$//'
    elif [[ ${#parts[@]} -eq 2 ]]; then
      # Match indented key under parent
      awk "/^${parts[0]}:/{found=1} found && /^  ${parts[1]}:/{print; exit}" "$manifest" 2>/dev/null | sed 's/^[^:]*: *//' | sed 's/^["'"'"']//;s/["'"'"']$//'
    fi
  fi
}

# Extract a top-level YAML block from a manifest, indented for embedding in a CR spec
# Usage: manifest_block <manifest-name> <top-level-key> <indent-spaces>
# Returns the block (including the key line) indented by the given number of spaces
manifest_block() {
  local manifest
  manifest=$(resolve_manifest "$1")
  [[ -z "$manifest" ]] && return
  local key="$2"
  local indent="${3:-2}"
  local pad=""
  for ((i=0; i<indent; i++)); do pad+=" "; done

  if command -v yq &>/dev/null; then
    local val
    val=$(yq -r ".$key // \"\"" "$manifest" 2>/dev/null)
    if [[ -n "$val" && "$val" != "null" && "$val" != "" ]]; then
      yq -r "{ \"$key\": .$key }" "$manifest" 2>/dev/null | sed "s/^/${pad}/"
    fi
  else
    # Fallback: extract from top-level key to next top-level key (no leading spaces)
    local block
    block=$(awk "/^${key}:/{found=1} found && /^[^ ]/ && !/^${key}:/{found=0} found{print}" "$manifest" 2>/dev/null)
    if [[ -n "$block" ]]; then
      echo "$block" | sed "s/^/${pad}/"
    fi
  fi
}

# List required secret keys from a manifest
# Usage: manifest_required_secrets <manifest-name>
manifest_required_secrets() {
  local manifest
  manifest=$(resolve_manifest "$1")
  [[ -z "$manifest" ]] && return
  if command -v yq &>/dev/null; then
    yq -r '.secrets[] | select(.required == true) | .key' "$manifest" 2>/dev/null
  else
    # Fallback: extract keys between "secrets:" and end of file where required: true
    awk '/^secrets:/,0' "$manifest" | awk '
      /^  - key:/ { key=$3; gsub(/"/, "", key); req="" }
      /required: true/ { req=1 }
      /^  - key:/ && req=="" && key != "" { }
      req==1 && /^  - key:|^[^ ]/ { if (key != "") print key; key=""; req="" }
      END { if (req==1 && key != "") print key }
    '
  fi
}

# List ALL secret keys declared in a manifest (required + optional), one per line.
# Usage: manifest_secret_keys <manifest-name>
manifest_secret_keys() {
  local manifest
  manifest=$(resolve_manifest "$1")
  [[ -z "$manifest" ]] && return
  if command -v yq &>/dev/null; then
    yq -r '.secrets[]? | .key' "$manifest" 2>/dev/null
  else
    awk '/^secrets:/,0' "$manifest" | awk '
      /^  - key:/ { key=$3; gsub(/"/, "", key); if (key != "") print key }
    '
  fi
}

# Match a secret name against the declared keys in a manifest, with tolerance
# for dash/underscore differences (common source of silent failures — pcli's
# profile key names use dashes while manifest keys often use underscores, and
# the two must match exactly for the agent to see the secret).
#
# Echoes the canonical manifest-declared name on match; empty on no match.
# Returns 2 when the manifest can't be resolved at all.
#
# Usage: match_secret_key_in_manifest <agent> <name>
match_secret_key_in_manifest() {
  local agent="$1" name="$2"
  local keys
  keys=$(manifest_secret_keys "$agent")
  [[ -z "$keys" ]] && return 2
  if echo "$keys" | grep -qxF "$name"; then
    echo "$name"
    return 0
  fi
  # Normalized: try dash↔underscore swap
  local alt_underscore="${name//-/_}"
  local alt_dash="${name//_/-}"
  for cand in "$alt_underscore" "$alt_dash"; do
    if echo "$keys" | grep -qxF "$cand"; then
      echo "$cand"
      return 0
    fi
  done
  # Canonical secret names are UPPER_SNAKE in current manifests. Match
  # case/separator variants so profile aliases like grabgpt-api-key resolve
  # to manifest keys like GRABGPT_API_KEY.
  local want_canon
  want_canon=$(printf '%s' "$name" | tr '[:lower:]-' '[:upper:]_')
  while IFS= read -r cand; do
    local cand_canon
    cand_canon=$(printf '%s' "$cand" | tr '[:lower:]-' '[:upper:]_')
    if [[ "$cand_canon" == "$want_canon" ]]; then
      echo "$cand"
      return 0
    fi
  done <<< "$keys"
  return 1
}

# Validate that a secret name matches the agent's manifest. On mismatch, prints
# a warning and (unless --force) prompts the user. On dash/underscore mismatch,
# auto-normalizes to the manifest's canonical name.
#
# Side effect: sets the caller-visible variable `VALIDATED_SECRET_NAME`.
#
# Usage: validate_secret_name_against_manifest <agent> <name> <force:0|1>
validate_secret_name_against_manifest() {
  local agent="$1" name="$2" force="$3"
  VALIDATED_SECRET_NAME="$name"
  local canonical
  canonical=$(match_secret_key_in_manifest "$agent" "$name")
  local rc=$?
  if [[ $rc -eq 2 ]]; then
    # No manifest resolvable — soft warning only. Could be a user template
    # registered via the portal whose definition isn't on disk.
    echo_warn "No local manifest found for '$agent' — skipping secret-name validation."
    echo "  If this secret key isn't in the registered template, the agent won't see it."
    return 0
  fi
  if [[ -n "$canonical" ]]; then
    if [[ "$canonical" != "$name" ]]; then
      echo_warn "Secret name '$name' differs from manifest key '$canonical' (case/separator)."
      if [[ "$force" == "1" ]]; then
        echo "  --force: keeping '$name' as given (the agent likely won't read this)."
      else
        echo "  Auto-correcting '$name' → '$canonical' so the agent can read it."
        echo "  (Re-run with --force to keep the original name.)"
        VALIDATED_SECRET_NAME="$canonical"
      fi
    fi
    return 0
  fi
  # No match at all — list valid keys and bail (unless --force)
  local keys
  keys=$(manifest_secret_keys "$agent")
  echo_fail "Secret name '$name' is not declared in the '$agent' manifest."
  echo ""
  echo "Valid secret keys:"
  echo "$keys" | sed 's/^/  /'
  echo ""
  if [[ "$force" == "1" ]]; then
    echo_warn "--force set: writing '$name' anyway. The agent cannot read secrets not in its manifest."
    return 0
  fi
  echo "Re-run with --force to write it anyway (the agent won't be able to read it)."
  return 1
}

# Get secret_type for a given secret key from a manifest
manifest_secret_type() {
  local manifest
  manifest=$(resolve_manifest "$1")
  [[ -z "$manifest" ]] && return
  local target_key="$2"
  if command -v yq &>/dev/null; then
    yq -r ".secrets[] | select(.key == \"$target_key\") | .secret_type" "$manifest" 2>/dev/null
  else
    awk '/^secrets:/,0' "$manifest" | awk -v target="$target_key" '
      /^  - key:/ { key=$3; gsub(/"/, "", key); st="" }
      /secret_type:/ { st=$2; gsub(/"/, "", st) }
      /^  - key:|^[^ ]/ { if (key == target && st != "") { print st; exit } }
      END { if (key == target && st != "") print st }
    '
  fi
}

